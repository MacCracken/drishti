# drishti header rewrite (0.8.6) — the header writers (src/av1_hdrw.cyr) checked against streams drishti did not make.
#
# REWRITE mode (the default): reads build/hdr-rewrite-input.ivf, and for every sequence header OBU and every frame
# header (OBU_FRAME_HEADER, or the header of an OBU_FRAME) parses it (av1_seq_parse /
# av1_frame_parse_uncompressed_header), writes the record back (av1_seq_write / av1_frame_write_uncompressed_header)
# and compares the written bits with the ones the parse consumed, bit for bit. Every frame header is parsed and
# written against the reference state the stream has built so far, as a decoder holds it at the header level:
# av1_frame_update_refs after each frame (0.8.8; before it, inter frame headers were counted and skipped). That is all
# a header reads from it — order hints, sizes, frame ids, and each slot's saved deltas, segmentation features, global
# motion and film grain. The writer is handed the state from BEFORE the parse, which changes RefValid (the writer
# reads none of it). Every header must parse ("frame UNPARSED" otherwise).
# A header whose rewrite differs is re-parsed: if the record is identical it is EQUIV, not a failure — a coded value
# outside its clip range (5.9.14's Clip3 of a segmentation feature) has two codings of one header, and the record keeps
# only the clipped value.
#   stdout: "seq <k> OK|EQUIV|DIFF ...", "frame <k> OK|EQUIV|DIFF ..." for each header, then
#           "SUMMARY seq=<ok>/<n> intra=<ok>/<n> inter=<ok>/<n> equiv=<n> unparsed=<n>"
#           (intra counts the intra and shown-existing headers; unparsed = headers that did not parse: each a failure)
#
# EMIT mode (when build/hdr-rewrite.emit exists): writes streams made by the writers ALONE — temporal delimiter,
# sequence header OBU, frame OBU with an all-skip DC keyframe tile from the plan-driven tile writer — to
# build/writer-<name>.ivf, for make conformance to decode with aomdec, dav1d and drishti.
#
# Build: cyrius build programs/hdr-rewrite.cyr build/drishti-hdr-rewrite

include "src/main.cyr"

enum HrConst {
    HR_MAX_INPUT = 67108864;
}

fn hr_puts(s): i64 { return print(s, strlen(s)); }
fn hr_putn(n): i64 {
    if (n == 0) { return hr_puts("0"); }
    var v = n;
    if (v < 0) { hr_puts("-"); v = 0 - v; }
    var d = alloc(24);
    var i = 0;
    while (v > 0) { store8(d + i, 48 + (v % 10)); v = v / 10; i = i + 1; }
    var o = alloc(24);
    var j = 0;
    while (j < i) { store8(o + j, load8((d + i - 1) - j)); j = j + 1; }
    return print(o, i);
}

# 1 when the first nbits bits of a and b agree (MSB first)
fn hr_bits_equal(a, b, nbits): i64 {
    var k = 0;
    while (k < nbits) {
        var x = (load8(a + (k >> 3)) >> (7 - (k & 7))) & 1;
        var y = (load8(b + (k >> 3)) >> (7 - (k & 7))) & 1;
        if (x != y) { return 0; }
        k = k + 1;
    }
    return 1;
}
# the first differing bit, or -1
fn hr_first_diff(a, b, nbits): i64 {
    var k = 0;
    while (k < nbits) {
        var x = (load8(a + (k >> 3)) >> (7 - (k & 7))) & 1;
        var y = (load8(b + (k >> 3)) >> (7 - (k & 7))) & 1;
        if (x != y) { return k; }
        k = k + 1;
    }
    return 0 - 1;
}

var Hr_SeqOk = 0;
var Hr_SeqN = 0;
var Hr_FrOk = 0;
var Hr_FrN = 0;
# the inter syntax the rewritten headers reached, one counter per branch of the writer (the CENSUS line): a branch the
# corpus never takes is one the bit-exact rewrite says nothing about
var Hr_Census = 0;   # Av1HrCensus counters, 8 bytes each
enum Av1HrCensus {
    HRC_PRIMARY = 0; HRC_ER = 1; HRC_SWITCH = 2; HRC_SHORT = 3; HRC_OVERRIDE = 4; HRC_FOUND = 5; HRC_FRAME_ID = 6;
    HRC_HP = 7; HRC_SWITCHABLE = 8; HRC_FILTER = 9; HRC_MMS = 10; HRC_URFM = 11; HRC_REFSEL = 12; HRC_SKIPMODE = 13;
    HRC_WARPED = 14; HRC_GM_TRANS = 15; HRC_GM_ROTZOOM = 16; HRC_GM_AFFINE = 17; HRC_SEG = 18; HRC_SEG_KEEP = 19;
    HRC_SEG_MAP_KEEP = 20; HRC_LF_DELTA = 21; HRC_GRAIN = 22; HRC_GRAIN_LOAD = 23; HRC_HIDDEN = 24; HRC_N = 25;
}
fn hr_census_add(k, cond): i64 {
    if (cond) { store64(Hr_Census + (k * 8), load64(Hr_Census + (k * 8)) + 1); }
    return 0;
}
fn hr_census(s, fh): i64 {
    hr_census_add(HRC_PRIMARY, av1_fh_primary_ref_frame(fh) != AV1_PRIMARY_REF_NONE);
    hr_census_add(HRC_ER, av1_fh_error_resilient_mode(fh));
    hr_census_add(HRC_SWITCH, av1_fh_frame_type(fh) == AV1_SWITCH_FRAME);
    hr_census_add(HRC_SHORT, av1_fh_frame_refs_short_signaling(fh));
    hr_census_add(HRC_OVERRIDE, av1_fh_frame_size_override(fh));
    hr_census_add(HRC_FOUND, load64(fh + AV1FH_FOUND_REF) != 0);
    hr_census_add(HRC_FRAME_ID, av1_seq_frame_id_present(s));
    hr_census_add(HRC_HP, av1_fh_allow_high_precision_mv(fh));
    hr_census_add(HRC_SWITCHABLE, av1_fh_interpolation_filter(fh) == AV1_INTERP_SWITCHABLE);
    hr_census_add(HRC_FILTER, av1_fh_interpolation_filter(fh) != AV1_INTERP_SWITCHABLE);
    hr_census_add(HRC_MMS, av1_fh_is_motion_mode_switchable(fh));
    hr_census_add(HRC_URFM, av1_fh_use_ref_frame_mvs(fh));
    hr_census_add(HRC_REFSEL, av1_fh_reference_select(fh));
    hr_census_add(HRC_SKIPMODE, av1_fh_skip_mode_present(fh));
    hr_census_add(HRC_WARPED, av1_fh_allow_warped_motion(fh));
    var ref = AV1_LAST_FRAME;
    var gt = 0;
    var gr = 0;
    var ga = 0;
    while (ref <= AV1_ALTREF_FRAME) {
        if (av1_fh_gm_type(fh, ref) == AV1_GM_TRANSLATION) { gt = 1; }
        if (av1_fh_gm_type(fh, ref) == AV1_GM_ROTZOOM) { gr = 1; }
        if (av1_fh_gm_type(fh, ref) == AV1_GM_AFFINE) { ga = 1; }
        ref = ref + 1;
    }
    hr_census_add(HRC_GM_TRANS, gt);
    hr_census_add(HRC_GM_ROTZOOM, gr);
    hr_census_add(HRC_GM_AFFINE, ga);
    var seg = av1_fh_segmentation_enabled(fh);
    hr_census_add(HRC_SEG, seg);
    hr_census_add(HRC_SEG_KEEP, seg && (load64(fh + AV1FH_SEG_UPDATE_DATA) == 0));
    hr_census_add(HRC_SEG_MAP_KEEP, seg && (load64(fh + AV1FH_SEG_UPDATE_MAP) == 0));
    hr_census_add(HRC_LF_DELTA, load64(fh + AV1FH_LF_DELTA_UPDATE));
    var g = fh + AV1FH_GRAIN;
    hr_census_add(HRC_GRAIN, load64(g + AV1FG_APPLY));
    hr_census_add(HRC_GRAIN_LOAD, load64(g + AV1FG_APPLY) && (load64(g + AV1FG_UPDATE) == 0));
    hr_census_add(HRC_HIDDEN, av1_fh_show_frame(fh) == 0);
    return 0;
}
var Hr_InOk = 0;
var Hr_InN = 0;
var Hr_Unparsed = 0;
var Hr_Equiv = 0;

# 1 when records a and b (size bytes) agree everywhere but the 8-byte field at skip (the bit count each parse records)
fn hr_records_equal(a, b, size, skip): i64 {
    var k = 0;
    while (k < size) {
        if ((k < skip) || (k >= (skip + 8))) {
            if (load8(a + k) != load8(b + k)) { return 0; }
        }
        k = k + 1;
    }
    return 1;
}

fn hr_report(kind, k, ok, nbits, written, diff, err): i64 {
    hr_puts(kind);
    hr_puts(" ");
    hr_putn(k);
    if (ok) { hr_puts(" OK bits="); hr_putn(nbits); hr_puts("\n"); return 0; }
    hr_puts(" DIFF bits=");
    hr_putn(nbits);
    hr_puts(" written=");
    hr_putn(written);
    hr_puts(" first_diff=");
    hr_putn(diff);
    hr_puts(" err=");
    hr_putn(err);
    hr_puts("\n");
    return 0;
}

fn hr_rewrite(): i64 {
    var buf = alloc(HR_MAX_INPUT);
    var n = file_read_all("build/hdr-rewrite-input.ivf", buf, HR_MAX_INPUT);
    if (n <= 0) { hr_puts("SUMMARY no-input\n"); return 1; }
    var e = 0;
    var r = dr_ivf_reader_init(buf, n, &e);
    if (r == 0) { hr_puts("SUMMARY not-an-ivf\n"); return 1; }
    var seq = 0;
    var dead = 0;
    Hr_Census = alloc(HRC_N * 8);
    memset(Hr_Census, 0, HRC_N * 8);
    var refs = av1_ref_state_new();
    var snap = alloc(AV1REF_SIZE);
    var snap2 = alloc(AV1REF_SIZE);
    if ((refs == 0) || (snap == 0) || (snap2 == 0)) { hr_puts("SUMMARY oom\n"); return 1; }
    var pp = 0;
    var ps = 0;
    var pt = 0;
    while (dr_ivf_next_frame(r, &pp, &ps, &pt) == DR_OK) {
        var it = av1_obu_iter_init(pp, ps);
        if (it == 0) { return 2; }
        var t = 0;
        var off = 0;
        var sz = 0;
        while (av1_obu_next(it, &t, &off, &sz) == DR_OK) {
            var o = av1_obu_iter_obu(it);
            if (t == AV1_OBU_SEQUENCE_HEADER) {
                var se = 0;
                var ns = av1_seq_parse(pp + off, sz, &se);
                if ((ns == 0) || (se != DR_OK)) { Hr_Unparsed = Hr_Unparsed + 1; hr_puts("seq UNPARSED\n"); }
                else {
                    seq = ns;
                    Hr_SeqN = Hr_SeqN + 1;
                    var bw = dr_bw_init(64);
                    var rc = av1_seq_write(bw, ns);
                    var nb = av1_seq_bits_consumed(ns);
                    var wb = dr_bw_bit_pos(bw);
                    dr_bw_flush(bw);
                    var ok = 0;
                    if ((rc == DR_OK) && (wb == nb) && hr_bits_equal(pp + off, dr_bw_buf(bw), nb)) { ok = 1; }
                    if (ok) { Hr_SeqOk = Hr_SeqOk + 1; }
                    if ((ok == 0) && (rc == DR_OK)) {
                        # not the same bits: is it the same header? (a value outside its clip range has two codings)
                        var re = 0;
                        var rs = av1_seq_parse(dr_bw_buf(bw), (wb + 7) >> 3, &re);
                        if ((rs != 0) && (re == DR_OK)
                          && hr_records_equal(rs, ns, AV1_SEQ_SIZE, AV1_SEQ_BITS_CONSUMED)) {
                            Hr_Equiv = Hr_Equiv + 1;
                            ok = 2;
                        }
                    }
                    if (ok == 2) { hr_puts("seq "); hr_putn(Hr_SeqN); hr_puts(" EQUIV\n"); }
                    else {
                        var d1 = hr_first_diff(pp + off, dr_bw_buf(bw), av1_min(nb, wb));
                        hr_report("seq", Hr_SeqN, ok, nb, wb, d1, rc);
                    }
                }
            }
            if (((t == AV1_OBU_FRAME_HEADER) || (t == AV1_OBU_FRAME)) && (seq != 0) && (dead == 0)) {
                memcpy(snap, refs, AV1REF_SIZE);   # the state the header is read against (the parse changes RefValid)
                var fe = 0;
                var fh = av1_frame_parse_uncompressed_header(seq, refs, av1_obu_tid(o), av1_obu_sid(o), pp + off, sz,
                  &fe);
                if ((fh == 0) || (fe != DR_OK)) {
                    Hr_Unparsed = Hr_Unparsed + 1;
                    hr_puts("frame UNPARSED err=");
                    hr_putn(fe);
                    hr_puts("\n");
                    dead = 1;   # the stream's reference state is lost: no later header can be read
                }
                else {
                    var inter = (av1_fh_show_existing_frame(fh) == 0) && (av1_fh_frame_is_intra(fh) == 0);
                    if (inter) { Hr_InN = Hr_InN + 1; } else { Hr_FrN = Hr_FrN + 1; }
                    var bw2 = dr_bw_init(256);
                    var rc2 = av1_frame_write_uncompressed_header(bw2, seq, snap, fh, av1_obu_tid(o), av1_obu_sid(o));
                    var nb2 = av1_fh_bits_consumed(fh);
                    var wb2 = dr_bw_bit_pos(bw2);
                    dr_bw_flush(bw2);
                    var ok2 = 0;
                    if ((rc2 == DR_OK) && (wb2 == nb2) && hr_bits_equal(pp + off, dr_bw_buf(bw2), nb2)) { ok2 = 1; }
                    if ((ok2 == 0) && (rc2 == DR_OK)) {
                        var re2 = 0;
                        memcpy(snap2, snap, AV1REF_SIZE);
                        var rf = av1_frame_parse_uncompressed_header(seq, snap2, av1_obu_tid(o), av1_obu_sid(o),
                          dr_bw_buf(bw2), (wb2 + 7) >> 3, &re2);
                        if ((rf != 0) && (re2 == DR_OK) && hr_records_equal(rf, fh, AV1FH_SIZE, AV1FH_BITS_CONSUMED)) {
                            Hr_Equiv = Hr_Equiv + 1;
                            ok2 = 2;
                        }
                    }
                    var kind = "frame";
                    var kn = Hr_FrN;
                    if (inter) { kind = "inter"; kn = Hr_InN; }
                    if (ok2 != 0) {
                        if (inter) { Hr_InOk = Hr_InOk + 1; hr_census(seq, fh); } else { Hr_FrOk = Hr_FrOk + 1; }
                    }
                    if (ok2 == 2) { hr_puts(kind); hr_puts(" "); hr_putn(kn); hr_puts(" EQUIV\n"); }
                    else {
                        hr_report(kind, kn, ok2, nb2, wb2, hr_first_diff(pp + off, dr_bw_buf(bw2), av1_min(nb2, wb2)),
                          rc2);
                    }
                    # 7.20 at the header level: what the next header reads (a decoder saves the decoded data beside it)
                    var ue = av1_frame_update_refs(refs, seq, fh);
                    if (ue != DR_OK) { hr_puts("SUMMARY oom\n"); return 1; }
                }
            }
        }
    }
    hr_puts("SUMMARY seq=");
    hr_putn(Hr_SeqOk);
    hr_puts("/");
    hr_putn(Hr_SeqN);
    hr_puts(" intra=");
    hr_putn(Hr_FrOk);
    hr_puts("/");
    hr_putn(Hr_FrN);
    hr_puts(" inter=");
    hr_putn(Hr_InOk);
    hr_puts("/");
    hr_putn(Hr_InN);
    hr_puts(" equiv=");
    hr_putn(Hr_Equiv);
    hr_puts(" unparsed=");
    hr_putn(Hr_Unparsed);
    hr_puts("\n");
    hr_puts("CENSUS");
    var ci = 0;
    while (ci < HRC_N) {
        hr_puts(" ");
        hr_putn(load64(Hr_Census + (ci * 8)));
        ci = ci + 1;
    }
    hr_puts("\n");
    return 0;
}

# ---- EMIT: a keyframe of w x h, every 64x64 superblock one skip DC_PRED block, from the writers alone ----
fn hr_emit_one(path, w, h, bd, mono, subx, suby, qidx): i64 {
    var e = 0;
    var s = av1_seq_init(w, h, bd, mono, subx, suby, &e);
    if (s == 0) { return e; }
    var fh = av1_fh_init_key(s, qidx, &e);
    if (fh == 0) { return e; }
    var np = av1_seq_num_planes(s);
    var frame = dr_frame_new(w, h, np, subx, suby, bd, 8, &e);
    if (frame == 0) { return e; }
    var mi_cols = av1_fh_mi_cols(fh);
    var mi_rows = av1_fh_mi_rows(fh);
    var tile = av1_tile_new(frame, mi_cols, mi_rows, qidx, load64(s + AV1_SEQ_ENABLE_INTRA_EDGE),
      av1_fh_reduced_tx_set(fh), np);
    if (tile == 0) { return DR_ERR_OOM; }
    if (av1_tile_grids_new(tile) != DR_OK) { return DR_ERR_OOM; }
    var sbc = (mi_cols + 15) >> 4;
    var sbr = (mi_rows + 15) >> 4;
    var nsb = sbc * sbr;
    var mi = av1_modeinfo_new();
    store64(mi + AV1MI_SKIP, 1);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    var pp = alloc(nsb * 8);
    var pm = alloc(nsb * 8);
    var ptx = alloc(nsb * 8);
    var k = 0;
    while (k < nsb) {
        store64(pp + (k * 8), AV1_PARTITION_NONE);
        store64(pm + (k * 8), mi);
        store64(ptx + (k * 8), AV1_TX_64X64);
        k = k + 1;
    }
    var tlen = 0;
    var tbytes = av1_encode_intra_tile(tile, pp, pm, ptx, av1_fh_disable_cdf_update(fh), &tlen);
    if (tbytes == 0) { return DR_ERR_OOM; }
    var tiles = alloc(8);
    var sizes = alloc(8);
    store64(tiles, tbytes);
    store64(sizes, tlen);
    var bw = dr_bw_init(4096);
    av1_td_write_obu(bw);
    av1_seq_write_obu(bw, s);
    var rc = av1_frame_write_obu(bw, s, 0, fh, 0, 0, 0, tiles, sizes);
    if (rc != DR_OK) { return rc; }
    var n = dr_bw_flush(bw);
    var iw = dr_ivf_writer_init(DR_FOURCC_AV01, w, h, 30, 1);
    if (iw == 0) { return DR_ERR_OOM; }
    dr_ivf_write_frame(iw, dr_bw_buf(bw), n, 0);
    var ilen = 0;
    var ibuf = dr_ivf_writer_finish(iw, &ilen);
    if (ibuf == 0) { return DR_ERR_OOM; }
    if (file_write_all(path, ibuf, ilen) < 0) { return DR_ERR_OTHER; }
    hr_puts("emit ");
    hr_puts(path);
    hr_puts(" ");
    hr_putn(ilen);
    hr_puts(" bytes\n");
    return DR_OK;
}

fn hr_emit(): i64 {
    var bad = 0;
    if (hr_emit_one("build/writer-420-64x64.ivf", 64, 64, 8, 0, 1, 1, 40) != DR_OK) { bad = bad + 1; }
    if (hr_emit_one("build/writer-mono-128x64.ivf", 128, 64, 8, 1, 1, 1, 40) != DR_OK) { bad = bad + 1; }
    if (hr_emit_one("build/writer-b10-420-128x128.ivf", 128, 128, 10, 0, 1, 1, 100) != DR_OK) { bad = bad + 1; }
    if (hr_emit_one("build/writer-444-64x64.ivf", 64, 64, 8, 0, 0, 0, 60) != DR_OK) { bad = bad + 1; }
    if (hr_emit_one("build/writer-422-b12-64x64.ivf", 64, 64, 12, 0, 1, 0, 200) != DR_OK) { bad = bad + 1; }
    hr_puts("SUMMARY emit_failed=");
    hr_putn(bad);
    hr_puts("\n");
    return bad;
}

fn main(): i64 {
    alloc_init();
    if (av1_tables_init() != DR_OK) { hr_puts("SUMMARY oom\n"); return 1; }
    var probe = alloc(8);
    if (file_read_all("build/hdr-rewrite.emit", probe, 8) >= 0) { return hr_emit(); }
    return hr_rewrite();
}

var exit_code = main();
syscall(60, exit_code);
