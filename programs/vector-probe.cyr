# drishti vector probe (Phase E1 diagnostic) — walk the OBUs of a real AV1 stream
# and print every sequence/frame-header field that drishti currently GATES on, so a
# conformance rejection can be attributed to a specific unimplemented feature
# instead of a bare DR_ERR_UNSUPPORTED.
#
# This is the companion to programs/conformance.cyr: that one answers "do the pixels
# match", this one answers "if not, which feature stopped us". Reads the same fixed
# input path (build/conformance-input.ivf) for the same reason (no arg module in
# [deps].stdlib); scripts/conformance.sh copies each vector into place.
#
# Fields are read via the raw AV1FH_* / AV1_SEQ_* record offsets rather than the
# accessor wrappers — the offsets are the enum contract and cannot drift out from
# under this program without the record itself changing.
#
# Build: cyrius build programs/vector-probe.cyr build/drishti-vector-probe

include "src/main.cyr"

enum ProbeConst {
    PROBE_MAX_INPUT = 8388608;
}

fn probe_puts(s): i64 { return print(s, strlen(s)); }
fn probe_putn(n): i64 {
    if (n == 0) { return probe_puts("0"); }
    var d = alloc(24);
    var i = 0;
    var v = n;
    if (v < 0) { probe_puts("-"); v = 0 - v; }
    while (v > 0) {
        store8(d + i, 48 + (v % 10));
        v = v / 10;
        i = i + 1;
    }
    var o = alloc(24);
    var j = 0;
    while (j < i) { store8(o + j, load8((d + i - 1) - j)); j = j + 1; }
    return print(o, i);
}
fn probe_kv(k, v): i64 {
    probe_puts("  ");
    probe_puts(k);
    probe_puts("=");
    probe_putn(v);
    probe_puts("\n");
    return 0;
}
# an i64 array as "k=v0,v1,...,v(n-1)" (the film grain point / AR-coefficient arrays, 0.8.4).
fn probe_arr(k, ptr, n): i64 {
    probe_puts("  ");
    probe_puts(k);
    probe_puts("=");
    var i = 0;
    while (i < n) {
        if (i > 0) { probe_puts(","); }
        probe_putn(load64(ptr + (i * 8)));
        i = i + 1;
    }
    probe_puts("\n");
    return 0;
}
# flag a field drishti REJECTS on when non-zero (or, for a few, when it differs from
# the supported value) so the offending feature is obvious in the output.
fn probe_gate(k, v, bad): i64 {
    probe_puts("  ");
    probe_puts(k);
    probe_puts("=");
    probe_putn(v);
    if (v == bad) { probe_puts("   <-- REJECTED BY DRISHTI"); }
    probe_puts("\n");
    return 0;
}

fn probe_seq(seq): i64 {
    probe_puts(" SEQUENCE HEADER\n");
    probe_kv("use_128x128_superblock", load64(seq + AV1_SEQ_SB128));   # decodes as of 0.7.126 (E2a)
    probe_kv("bit_depth", load64(seq + AV1_SEQ_BITDEPTH));
    probe_kv("num_planes", load64(seq + AV1_SEQ_NUM_PLANES));
    probe_kv("subsampling_x", load64(seq + AV1_SEQ_SUBX));
    probe_kv("subsampling_y", load64(seq + AV1_SEQ_SUBY));
    probe_kv("enable_cdef", load64(seq + AV1_SEQ_ENABLE_CDEF));
    probe_kv("enable_restoration", load64(seq + AV1_SEQ_ENABLE_RESTORATION));
    probe_kv("enable_filter_intra", load64(seq + AV1_SEQ_ENABLE_FILTER_INTRA));
    probe_kv("enable_intra_edge_filter", load64(seq + AV1_SEQ_ENABLE_INTRA_EDGE));
    probe_kv("enable_order_hint", load64(seq + AV1_SEQ_ENABLE_ORDER_HINT));
    probe_kv("enable_ref_frame_mvs", load64(seq + AV1_SEQ_ENABLE_REF_FRAME_MVS));
    probe_kv("enable_jnt_comp", load64(seq + AV1_SEQ_ENABLE_JNT_COMP));
    probe_kv("enable_superres", load64(seq + AV1_SEQ_ENABLE_SUPERRES));
    probe_kv("matrix_coefficients", av1_seq_matrix_coefficients(seq));
    probe_kv("film_grain_params_present", av1_seq_film_grain_present(seq));
    return 0;
}

fn probe_fh(fh, seq): i64 {
    probe_puts(" FRAME HEADER\n");
    probe_kv("frame_type", load64(fh + AV1FH_FRAME_TYPE));
    probe_kv("show_existing_frame", load64(fh + AV1FH_SHOW_EXISTING));   # frame_type is the SHOWN slot's then
    probe_kv("frame_is_intra", load64(fh + AV1FH_FRAME_IS_INTRA));
    probe_kv("show_frame", load64(fh + AV1FH_SHOW_FRAME));
    probe_kv("mi_cols", load64(fh + AV1FH_MI_COLS));
    probe_kv("mi_rows", load64(fh + AV1FH_MI_ROWS));
    # frame geometry (0.8.3): the dimension-sweep cases prove a resize / superres stream really changes
    # size, and switch / error-resilient cases prove their signalling, from these.
    probe_kv("frame_width", load64(fh + AV1FH_FRAME_WIDTH));
    probe_kv("frame_height", load64(fh + AV1FH_FRAME_HEIGHT));
    probe_kv("upscaled_width", load64(fh + AV1FH_UPSCALED_WIDTH));
    probe_kv("use_superres", load64(fh + AV1FH_USE_SUPERRES));
    probe_kv("superres_denom", load64(fh + AV1FH_SUPERRES_DENOM));
    probe_kv("frame_size_override_flag", load64(fh + AV1FH_FRAME_SIZE_OVERRIDE));
    probe_kv("error_resilient_mode", load64(fh + AV1FH_ERROR_RESILIENT));
    probe_kv("frame_refs_short_signaling", load64(fh + AV1FH_SHORT_SIGNALING));
    probe_kv("base_q_idx", load64(fh + AV1FH_BASE_Q_IDX));
    probe_kv("coded_lossless", load64(fh + AV1FH_CODED_LOSSLESS));
    probe_kv("tx_mode", load64(fh + AV1FH_TX_MODE));
    probe_kv("reduced_tx_set", load64(fh + AV1FH_REDUCED_TX_SET));
    probe_kv("primary_ref_frame", load64(fh + AV1FH_PRIMARY_REF_FRAME));
    probe_kv("reference_select", load64(fh + AV1FH_REFERENCE_SELECT));   # compound prediction allowed
    probe_kv("refresh_frame_flags", load64(fh + AV1FH_REFRESH_FRAME_FLAGS));
    probe_kv("tile_cols", load64(fh + AV1FH_TILE_COLS));
    probe_kv("tile_rows", load64(fh + AV1FH_TILE_ROWS));
    probe_kv("uses_lr", load64(fh + AV1FH_USES_LR));
    # per-plane FrameRestorationType (0.8.3): the format cases prove CHROMA restoration ran, not just luma.
    probe_kv("lr_type_y", av1_fh_frame_restoration_type(fh, 0));
    probe_kv("lr_type_u", av1_fh_frame_restoration_type(fh, 1));
    probe_kv("lr_type_v", av1_fh_frame_restoration_type(fh, 2));
    probe_puts(" --- drishti reject gates ---\n");
    probe_kv("allow_screen_content_tools", load64(fh + AV1FH_ALLOW_SCT));   # decodes as of 0.8.2 (palette)
    probe_kv("allow_intrabc", load64(fh + AV1FH_ALLOW_INTRABC));            # decodes as of 0.8.4
    # quantizer matrices decode as of 0.8.4: reported, no longer gates (rejected 0.8.2 - 0.8.3).
    probe_kv("using_qmatrix", load64(fh + AV1FH_USING_QMATRIX));
    probe_kv("qm_y", load64(fh + AV1FH_QM_Y));
    probe_kv("qm_u", load64(fh + AV1FH_QM_U));
    probe_kv("qm_v", load64(fh + AV1FH_QM_V));
    probe_kv("qmatrix_applies", av1_fh_qm_applies(fh, av1_seq_num_planes(seq)));
    # per-superblock deltas decode as of 0.8.2: reported, no longer gates.
    probe_kv("delta_q_present", load64(fh + AV1FH_DELTA_Q_PRESENT));
    probe_kv("delta_q_res", load64(fh + AV1FH_DELTA_Q_RES));
    probe_kv("delta_lf_present", load64(fh + AV1FH_DELTA_LF_PRESENT));
    probe_kv("delta_lf_res", load64(fh + AV1FH_DELTA_LF_RES));
    probe_kv("delta_lf_multi", load64(fh + AV1FH_DELTA_LF_MULTI));
    probe_kv("segmentation_enabled", load64(fh + AV1FH_SEG_ENABLED));
    probe_kv("segmentation_update_map", load64(fh + AV1FH_SEG_UPDATE_MAP));
    probe_kv("segmentation_temporal_update", load64(fh + AV1FH_SEG_TEMPORAL_UPDATE));
    probe_kv("segmentation_update_data", load64(fh + AV1FH_SEG_UPDATE_DATA));
    # bit s = segment s has an enabled feature (after load_previous: an update_data 0 frame shows what it
    # INHERITED, which is why main() runs the 7.20 header update after every frame).
    var am = 0;
    var as = 0;
    while (as < AV1_MAX_SEGMENTS) {
        var aj = 0;
        while (aj < AV1_SEG_LVL_MAX) {
            if (av1_fh_feature_enabled(fh, as, aj) != 0) { am = am | (1 << as); }
            aj = aj + 1;
        }
        as = as + 1;
    }
    probe_kv("segmentation_active_mask", am);
    probe_kv("lossless_mask", av1_fh_lossless_mask(fh));   # LosslessArray, bit s = segment s
    probe_kv("disable_cdf_update", load64(fh + AV1FH_DISABLE_CDF_UPDATE));   # drives symbol adaptation
    probe_kv("disable_frame_end_update_cdf", load64(fh + AV1FH_DISABLE_FE_UPDATE_CDF));
    probe_kv("context_update_tile_id", load64(fh + AV1FH_CONTEXT_UPDATE_TILE_ID));
    # film_grain_params (5.9.30) as the output process will apply them: after load_grain_params for
    # update_grain 0 and for show_existing_frame (0.8.4). scripts/refs/grain_ref.py --crosscheck reads these.
    var g = av1_fh_grain(fh);
    probe_kv("fg_apply_grain", load64(g + AV1FG_APPLY));
    probe_kv("fg_grain_seed", load64(g + AV1FG_SEED));
    probe_kv("fg_update_grain", load64(g + AV1FG_UPDATE));
    probe_kv("fg_num_y_points", load64(g + AV1FG_NUM_Y));
    probe_arr("fg_point_y_value", g + AV1FG_Y_VALUE, 16);
    probe_arr("fg_point_y_scaling", g + AV1FG_Y_SCALING, 16);
    probe_kv("fg_chroma_scaling_from_luma", load64(g + AV1FG_CSFL));
    probe_kv("fg_num_cb_points", load64(g + AV1FG_NUM_CB));
    probe_arr("fg_point_cb_value", g + AV1FG_CB_VALUE, 16);
    probe_arr("fg_point_cb_scaling", g + AV1FG_CB_SCALING, 16);
    probe_kv("fg_num_cr_points", load64(g + AV1FG_NUM_CR));
    probe_arr("fg_point_cr_value", g + AV1FG_CR_VALUE, 16);
    probe_arr("fg_point_cr_scaling", g + AV1FG_CR_SCALING, 16);
    probe_kv("fg_grain_scaling_minus_8", load64(g + AV1FG_SCALING_M8));
    probe_kv("fg_ar_coeff_lag", load64(g + AV1FG_AR_LAG));
    probe_arr("fg_ar_coeffs_y_plus_128", g + AV1FG_AR_Y, 24);
    probe_arr("fg_ar_coeffs_cb_plus_128", g + AV1FG_AR_CB, 25);
    probe_arr("fg_ar_coeffs_cr_plus_128", g + AV1FG_AR_CR, 25);
    probe_kv("fg_ar_coeff_shift_minus_6", load64(g + AV1FG_AR_SHIFT_M6));
    probe_kv("fg_grain_scale_shift", load64(g + AV1FG_SCALE_SHIFT));
    probe_kv("fg_cb_mult", load64(g + AV1FG_CB_MULT));
    probe_kv("fg_cb_luma_mult", load64(g + AV1FG_CB_LUMA_MULT));
    probe_kv("fg_cb_offset", load64(g + AV1FG_CB_OFFSET));
    probe_kv("fg_cr_mult", load64(g + AV1FG_CR_MULT));
    probe_kv("fg_cr_luma_mult", load64(g + AV1FG_CR_LUMA_MULT));
    probe_kv("fg_cr_offset", load64(g + AV1FG_CR_OFFSET));
    probe_kv("fg_overlap_flag", load64(g + AV1FG_OVERLAP));
    probe_kv("fg_clip_to_restricted_range", load64(g + AV1FG_CLIP_RR));
    return 0;
}

fn main() {
    alloc_init();
    var buf = alloc(PROBE_MAX_INPUT);
    var n = file_read_all("build/conformance-input.ivf", buf, PROBE_MAX_INPUT);
    if (n <= 0) { probe_puts("cannot-read-input\n"); return 1; }
    var e = 0;
    var r = dr_ivf_reader_init(buf, n, &e);
    if ((r == 0) || (e != DR_OK)) { probe_puts("not-an-ivf\n"); return 1; }

    var refs = av1_ref_state_new();
    var seq = 0;
    var tu = 0;
    var go = 1;
    while (go == 1) {
        var pp = 0;
        var ps = 0;
        var pt = 0;
        if (dr_ivf_next_frame(r, &pp, &ps, &pt) != DR_OK) { go = 0; }
        else {
            tu = tu + 1;
            probe_puts("=== temporal unit ");
            probe_putn(tu);
            probe_puts(" (");
            probe_putn(ps);
            probe_puts(" bytes) ===\n");
            var it = av1_obu_iter_init(pp, ps);
            var otype = 0;
            var ooff = 0;
            var osize = 0;
            var rc = av1_obu_next(it, &otype, &ooff, &osize);
            while (rc == DR_OK) {
                probe_puts(" OBU type=");
                probe_putn(otype);
                probe_puts(" size=");
                probe_putn(osize);
                probe_puts("\n");
                if (otype == AV1_OBU_SEQUENCE_HEADER) {
                    var serr = 0;
                    seq = av1_seq_parse(pp + ooff, osize, &serr);
                    if ((seq == 0) || (serr != DR_OK)) {
                        probe_puts("  SEQ PARSE FAILED err=");
                        probe_putn(serr);
                        probe_puts("\n");
                    } else { probe_seq(seq); }
                }
                if ((otype == AV1_OBU_FRAME) || (otype == AV1_OBU_FRAME_HEADER)) {
                    if (seq == 0) { probe_puts("  (no seq yet)\n"); }
                    else {
                        var o = av1_obu_iter_obu(it);
                        var ferr = 0;
                        var fh = av1_frame_parse_uncompressed_header(seq, refs,
                          av1_obu_tid(o), av1_obu_sid(o), pp + ooff, osize, &ferr);
                        if ((fh == 0) || (ferr != DR_OK)) {
                            probe_puts("  FH PARSE FAILED err=");
                            probe_putn(ferr);
                            probe_puts(" (");
                            probe_puts(dr_err_name(ferr));
                            probe_puts(")\n");
                        } else {
                            probe_fh(fh, seq);
                            # 7.20, header half: later headers' load_previous / frame_size_with_refs / order
                            # hints read the slots this frame refreshes (no pixels — this is a header probe).
                            av1_frame_update_refs(refs, seq, fh);
                        }
                    }
                }
                rc = av1_obu_next(it, &otype, &ooff, &osize);
            }
        }
    }
    return 0;
}

var exit_code = main();
syscall(60, exit_code);
