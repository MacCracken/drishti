# drishti keyframe-encoder check (0.8.6) — encode a raw picture with av1_encode_keyframe (src/av1_enc.cyr) and write
# the standalone .ivf for make conformance to decode with aomdec, dav1d and drishti.
#
# I/O contract (fixed paths, as the other harness programs):
#   IN   build/enc-input.cfg   ASCII "W H BITDEPTH FORMAT QINDEX BLOCK SB [DECIDE]": FORMAT 0 monochrome, 1 4:2:0,
#                              2 4:2:2, 3 4:4:4; BLOCK the block size (3 = 8x8, 6 = 16x16, 9 = 32x32, 12 = 64x64,
#                              15 = 128x128); SB the superblock size, 64 or 128; DECIDE what the encoder decides
#                              (AV1ENC_DECIDE_* bits: 1 the luma mode, 2 the chroma mode; 0, the default, nothing)
#   IN   build/enc-input.yuv   the picture, planar in the `aomdec --rawvideo` layout: Y, then U and V (none for
#                              monochrome), each its visible rectangle, one byte per sample at 8 bits and two
#                              little-endian at 10 / 12
#   OUT  build/enc-out.ivf     the encoded stream: an IVF file, one temporal unit
#   stdout: "MODES y=<n> uv=<n> cfl=<cells> ymask=<bits> txsizes=<n> txtypes=<cells>" (what the decoder reads in the
#     stream: how many distinct luma / chroma modes, the CfL cells, the luma modes as a bit mask, how many distinct luma
#     transform sizes, the luma cells not DCT_DCT), "RD sse=<n> samples=<n> peak=<n>" (the
#     reconstruction's squared error over every visible sample of every plane, the sample count, the largest sample
#     value: a PSNR), "ENC bytes=<ivf bytes> decode_eq_recon=<1|0> lossless_exact=<1|0|->" and a SUMMARY line.
#     decode_eq_recon: drishti, decoding the .ivf it wrote (read back with the IVF reader), outputs exactly the
#       reconstruction the encoder returned — the script then holds that output to aomdec's and dav1d's.
#     lossless_exact (QINDEX 0 only): the reconstruction is the input picture, sample for sample.
# Exit 0 when the stream was written and every check printed holds.
#
# Build: cyrius build programs/enc-check.cyr build/drishti-enc-check

include "src/main.cyr"

enum EncCheckConst {
    EC_MAX_INPUT = 134217728;   # 128 MiB of raw samples
}

fn ec_puts(s): i64 { return print(s, strlen(s)); }
fn ec_putn(n): i64 {
    if (n == 0) { return ec_puts("0"); }
    var d = alloc(24);
    var i = 0;
    var v = n;
    if (v < 0) { ec_puts("-"); v = 0 - v; }
    while (v > 0) {
        store8(d + i, 48 + (v % 10));
        v = v / 10;
        i = i + 1;
    }
    var o = alloc(24);
    var j = 0;
    while (j < i) { store8(o + j, load8((d + i - 1) - j)); j = j + 1; }
    return print(o, i);
}
# the first `count` whitespace-separated non-negative decimal integers of buf[0..n) into out[]; how many were read
fn ec_parse(buf, n, out, count): i64 {
    var k = 0;
    var i = 0;
    while ((i < n) && (k < count)) {
        var ch = load8(buf + i);
        if ((ch >= 48) && (ch <= 57)) {
            var v = 0;
            while ((i < n) && (load8(buf + i) >= 48) && (load8(buf + i) <= 57) && (v < 100000000)) {
                v = (v * 10) + (load8(buf + i) - 48);
                i = i + 1;
            }
            store64(out + (k * 8), v);
            k = k + 1;
        } else {
            i = i + 1;
        }
    }
    return k;
}
# every visible sample of every plane equal
fn ec_same(a, b): i64 {
    if ((dr_frame_num_planes(a) != dr_frame_num_planes(b)) || (dr_frame_width(a) != dr_frame_width(b))
      || (dr_frame_height(a) != dr_frame_height(b))) { return 0; }
    var p = 0;
    while (p < dr_frame_num_planes(a)) {
        var y = 0;
        while (y < dr_frame_plane_height(a, p)) {
            var x = 0;
            while (x < dr_frame_plane_width(a, p)) {
                if (dr_frame_get(a, p, x, y) != dr_frame_get(b, p, x, y)) { return 0; }
                x = x + 1;
            }
            y = y + 1;
        }
        p = p + 1;
    }
    return 1;
}

# The decoder's own reading of the temporal unit's mode info (its frame pieces, as tests/av1_enc.tcyr reads them): the
# frame's grid tile, 0 on failure.
fn ec_decode_grids(tu, n): i64 {
    var it = av1_obu_iter_init(tu, n);
    var t = 0;
    var off = 0;
    var sz = 0;
    var seq = 0;
    var tile = 0;
    while (av1_obu_next(it, &t, &off, &sz) == DR_OK) {
        var e = 0;
        if (t == AV1_OBU_SEQUENCE_HEADER) { seq = av1_seq_parse(tu + off, sz, &e); }
        if ((t == AV1_OBU_FRAME) && (seq != 0)) {
            var fh = av1_frame_parse_uncompressed_header(seq, av1_ref_state_new(), 0, 0, tu + off, sz, &e);
            if (fh == 0) { return 0; }
            var hb = (av1_fh_bits_consumed(fh) + 7) >> 3;
            var fdc = av1_frame_dec_new(seq, fh, &e);
            if (fdc == 0) { return 0; }
            if (av1_frame_dec_group(fdc, tu + off + hb, sz - hb, &e) < 1) { return 0; }
            tile = av1_frame_dec_tile0(fdc);
        }
    }
    return tile;
}
# "MODES y=<distinct luma modes> uv=<distinct chroma modes> cfl=<CfL cells> ymask=<luma modes, bits>
# txsizes=<distinct luma TxSizes> txtypes=<luma cells whose TxType is not DCT_DCT>": over every MI cell of the frame,
# as the decoder read them (YModes, UVModes, InterTxSizes, TxTypes) — the proof a decided encode decided something
# (DC_PRED at the largest transform alone is y=1 uv=1 txsizes=1 txtypes=0).
fn ec_modes(tu, n, w, h, has_uv): i64 {
    var tile = ec_decode_grids(tu, n);
    if (tile == 0) { ec_puts("MODES unreadable\n"); return 0; }
    var ym = 0;
    var um = 0;
    var cfl = 0;
    var txm = 0;
    var ntt = 0;
    var rows = (h + 3) >> 2;
    var cols = (w + 3) >> 2;
    var r = 0;
    while (r < rows) {
        var c = 0;
        while (c < cols) {
            ym = ym | (1 << av1_grid_get(tile, AV1TILE_YMODES, r, c));
            var u = av1_grid_get(tile, AV1TILE_UVMODES, r, c);
            um = um | (1 << u);
            if (u == AV1_UV_CFL_PRED) { cfl = cfl + 1; }
            txm = txm | (1 << av1_grid_get(tile, AV1TILE_INTERTX, r, c));
            if (av1_grid_get(tile, AV1TILE_TXTYPES, r, c) != AV1_DCT_DCT) { ntt = ntt + 1; }
            c = c + 1;
        }
        r = r + 1;
    }
    var ny = 0;
    var nu = 0;
    var ntx = 0;
    var b = 0;
    while (b < 14) { ny = ny + ((ym >> b) & 1); nu = nu + ((um >> b) & 1); b = b + 1; }
    b = 0;
    while (b < 19) { ntx = ntx + ((txm >> b) & 1); b = b + 1; }
    if (has_uv == 0) { nu = 0; }
    ec_puts("MODES y=");
    ec_putn(ny);
    ec_puts(" uv=");
    ec_putn(nu);
    ec_puts(" cfl=");
    ec_putn(cfl);
    ec_puts(" ymask=");
    ec_putn(ym);
    ec_puts(" txsizes=");
    ec_putn(ntx);
    ec_puts(" txtypes=");
    ec_putn(ntt);
    ec_puts("\n");
    return 0;
}
fn main(): i64 {
    alloc_init();
    if (av1_tables_init() != DR_OK) { ec_puts("SUMMARY oom\n"); return 1; }
    var cbuf = alloc(256);
    var cn = file_read_all("build/enc-input.cfg", cbuf, 255);
    var cfg = alloc(8 * 8);
    var nc = 0;
    if (cn > 0) { nc = ec_parse(cbuf, cn, cfg, 8); }
    if ((nc != 7) && (nc != 8)) { ec_puts("SUMMARY bad-cfg\n"); return 1; }
    var decide = 0;
    if (nc == 8) { decide = load64(cfg + 56); }
    var w = load64(cfg);
    var h = load64(cfg + 8);
    var bd = load64(cfg + 16);
    var fmt = load64(cfg + 24);
    var q = load64(cfg + 32);
    var bs = load64(cfg + 40);
    var sbpx = load64(cfg + 48);
    if ((sbpx != 64) && (sbpx != 128)) { ec_puts("SUMMARY bad-cfg\n"); return 1; }
    var sb128 = 0;
    if (sbpx == 128) { sb128 = 1; }
    var np = 3;
    var subx = 1;
    var suby = 1;
    if (fmt == 0) { np = 1; }
    if (fmt == 2) { suby = 0; }
    if (fmt == 3) { subx = 0; suby = 0; }
    if ((fmt > 3) || (w < 1) || (h < 1) || (w > 16384) || (h > 16384)) { ec_puts("SUMMARY bad-cfg\n"); return 1; }
    var e = 0;
    var src = dr_frame_new(w, h, np, subx, suby, bd, 8, &e);
    if (src == 0) { ec_puts("SUMMARY bad-format\n"); return 1; }
    var bps = 1;
    if (bd > 8) { bps = 2; }
    var buf = alloc(EC_MAX_INPUT);
    var n = file_read_all("build/enc-input.yuv", buf, EC_MAX_INPUT);
    var need = 0;
    var p = 0;
    while (p < np) {
        need = need + (dr_frame_plane_width(src, p) * dr_frame_plane_height(src, p) * bps);
        p = p + 1;
    }
    if (n != need) { ec_puts("SUMMARY bad-input-size\n"); return 1; }
    var off = 0;
    var maxv = (1 << bd) - 1;
    p = 0;
    while (p < np) {
        var y = 0;
        while (y < dr_frame_plane_height(src, p)) {
            var x = 0;
            while (x < dr_frame_plane_width(src, p)) {
                var v = load8(buf + off);
                if (bps == 2) { v = v | (load8(buf + off + 1) << 8); }
                if (v > maxv) { ec_puts("SUMMARY sample-out-of-range\n"); return 1; }
                dr_frame_set(src, p, x, y, v);
                off = off + bps;
                x = x + 1;
            }
            y = y + 1;
        }
        p = p + 1;
    }
    var ilen = 0;
    var recon = 0;
    var ivf = av1_encode_keyframe_ivf(src, q, bs, sb128, decide, &ilen, &recon, &e);
    if (ivf == 0) { ec_puts("SUMMARY encode-error err="); ec_putn(e); ec_puts("\n"); return 1; }
    if (file_write_all("build/enc-out.ivf", ivf, ilen) < 0) { ec_puts("SUMMARY write-failed\n"); return 1; }
    # read the file back as a decoder would, and decode its one temporal unit
    var same = 0;
    var r = dr_ivf_reader_init(ivf, ilen, &e);
    var pp = 0;
    var ps = 0;
    var pt = 0;
    if ((r != 0) && (dr_ivf_next_frame(r, &pp, &ps, &pt) == DR_OK)) {
        var de = 0;
        var out = av1_decode_obus(pp, ps, &de);
        if ((out != 0) && (de == DR_OK)) { same = ec_same(out, recon); }
        ec_modes(pp, ps, w, h, np > 1);
    }
    var exact = 0 - 1;
    if (q == 0) { exact = ec_same(recon, src); }
    # the distortion of what the decoders output (the reconstruction, which aomdec's output is held to): the SSE over
    # every visible sample of every plane, against the input
    var sse = 0;
    var nsamp = 0;
    p = 0;
    while (p < np) {
        sse = sse + av1_rd_sse(src, recon, p, 0, 0, dr_frame_plane_width(src, p), dr_frame_plane_height(src, p));
        nsamp = nsamp + (dr_frame_plane_width(src, p) * dr_frame_plane_height(src, p));
        p = p + 1;
    }
    ec_puts("RD sse=");
    ec_putn(sse);
    ec_puts(" samples=");
    ec_putn(nsamp);
    ec_puts(" peak=");
    ec_putn(maxv);
    ec_puts("\n");
    ec_puts("ENC bytes=");
    ec_putn(ilen);
    ec_puts(" decode_eq_recon=");
    ec_putn(same);
    ec_puts(" lossless_exact=");
    if (exact < 0) { ec_puts("-"); } else { ec_putn(exact); }
    ec_puts("\n");
    if ((same == 1) && (exact != 0)) { ec_puts("SUMMARY ok\n"); return 0; }
    ec_puts("SUMMARY check-failed\n");
    return 1;
}

var exit_code = main();
syscall(60, exit_code);
