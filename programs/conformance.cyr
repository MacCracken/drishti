# drishti conformance harness (Phase E1) — decode a REAL, externally-produced AV1
# stream and dump each decoded frame as raw YUV so an outside reference (aomdec, or
# the libaom test-vector .md5 companions) can judge the pixels.
#
# This is the first evidence in the AV1 arc that drishti did not produce itself:
# every prior witness round-trips drishti's own writer into drishti's own decoder,
# or compares against an oracle derived from the same spec reading as the code, so
# a shared misreading passes both sides silently. A vector encoded by libaom, with
# a reference MD5 computed by libaom, cannot collude with drishti's bugs.
#
# I/O contract (fixed paths — the stdlib arg module is not in [deps].stdlib, and
# scripts/conformance.sh drives this by copying each vector into place):
#   IN   build/conformance-input.ivf
#   OUT  build/conformance-out-<k>.yuv   (k = 1..units, the frame temporal unit k shows)
#   stdout: one "frame <k> <status>" line per temporal unit, then a SUMMARY line.
#
# OUTPUT FORMAT = `aomdec --rawvideo`, so a frame's md5 compares directly against the
# reference decoder's: the VISIBLE rectangle of each plane in order Y, U, V; chroma
# planes (w + subsampling_x) >> subsampling_x wide (likewise high); one byte per sample
# at 8-bit and two (little-endian) at 10/12-bit; and a MONOCHROME frame is its Y plane
# ALONE (aomdec writes no chroma for it). Each frame is written at its own size, so a
# stream whose frame size changes (reference scaling) still compares frame by frame.
#
# STREAMING (0.8.3). Each temporal unit is fed once to a persistent av1_decoder, and
# the frame it shows is written as it comes out. The harness used to re-decode the
# k-unit PREFIX from the keyframe for every k (av1_decode_stream returns only the last
# shown frame), which was O(n^2) and capped at 9 frames by its single-digit output
# naming; a real GOP needs far more frames than that before its reference patterns
# repeat. A failed unit latches the decoder's error, so every later unit reports the
# same failure, exactly as the prefix re-decode did.
#
# Build: cyrius build programs/conformance.cyr build/drishti-conformance

include "src/main.cyr"

enum ConfConst {
    CONF_MAX_INPUT = 67108864;   # 64 MiB — a long GOP at a large size, with room to spare
}

fn conf_puts(s): i64 { return print(s, strlen(s)); }
# print a non-negative integer (no fmt dependency — keeps this program's deps to
# exactly what [deps].stdlib already carries).
fn conf_putn(n): i64 {
    if (n == 0) { return conf_puts("0"); }
    var d = alloc(24);
    var i = 0;
    var v = n;
    if (v < 0) { conf_puts("-"); v = 0 - v; }
    while (v > 0) {
        store8(d + i, 48 + (v % 10));
        v = v / 10;
        i = i + 1;
    }
    var o = alloc(24);
    var j = 0;
    while (j < i) { store8(o + j, load8((d + i - 1) - j)); j = j + 1; }
    return print(o, i);
}
# "build/conformance-out-<k>.yuv", k decimal (any number of digits).
fn conf_out_path(k): i64 {
    var pre = "build/conformance-out-";
    var suf = ".yuv";
    var np = strlen(pre);
    var ns = strlen(suf);
    var digits = alloc(24);
    var nd = 0;
    var v = k;
    if (v <= 0) { store8(digits, 48); nd = 1; }
    while (v > 0) { store8(digits + nd, 48 + (v % 10)); v = v / 10; nd = nd + 1; }
    var p = alloc(np + nd + ns + 1);
    var i = 0;
    while (i < np) { store8(p + i, load8(pre + i)); i = i + 1; }
    var j = 0;
    while (j < nd) { store8(p + np + j, load8(digits + (nd - 1) - j)); j = j + 1; }
    var m = 0;
    while (m < ns) { store8(p + np + nd + m, load8(suf + m)); m = m + 1; }
    store8(p + np + nd + ns, 0);
    return p;
}

# Serialise a decoded DrFrame in the `aomdec --rawvideo` layout (see the header):
# visible extent only — the frame buffer may be MI-aligned and bordered — planes Y,
# U, V (Y alone when monochrome), 1 byte per sample at 8-bit, 2 bytes LE above it.
# Returns bytes written, or a negative error.
fn conf_write_frame(f, path): i64 {
    var w = dr_frame_width(f);
    var h = dr_frame_height(f);
    var np = dr_frame_num_planes(f);
    var sx = dr_frame_subx(f);
    var sy = dr_frame_suby(f);
    var bps = 1;
    if (dr_frame_bit_depth(f) > 8) { bps = 2; }
    var cw = (w + sx) >> sx;
    var ch = (h + sy) >> sy;
    var total = w * h;
    if (np > 1) { total = total + (2 * (cw * ch)); }
    var out = alloc(total * bps);
    if (out == 0) { return 0 - 1; }
    var off = 0;
    var p = 0;
    while (p < np) {
        var pw = w;
        var ph = h;
        if (p > 0) { pw = cw; ph = ch; }
        var y = 0;
        while (y < ph) {
            var x = 0;
            while (x < pw) {
                var v = dr_frame_get(f, p, x, y);
                store8(out + off, v & 255);
                if (bps == 2) { store8(out + off + 1, (v >> 8) & 255); }
                off = off + bps;
                x = x + 1;
            }
            y = y + 1;
        }
        p = p + 1;
    }
    if (file_write_all(path, out, off) < 0) { return 0 - 2; }
    return off;
}

# A large-scale tile output in libaom's YUV1D conformance layout (lightfield_tile_list_decoder, output format 0):
# the DECODED tiles only, in tile-list order, each as its Y then U then V rows (16-bit LE above 8 bits). The rest of
# the output frame is unspecified by the spec (7.3.1), so it is not written.
fn conf_write_tiles(f, path, count, tw, th, ow): i64 {
    var np = dr_frame_num_planes(f);
    var sx = dr_frame_subx(f);
    var sy = dr_frame_suby(f);
    var bps = 1;
    if (dr_frame_bit_depth(f) > 8) { bps = 2; }
    var per = tw * th;
    if (np > 1) { per = per + (2 * ((tw >> sx) * (th >> sy))); }
    var out = alloc(count * per * bps);
    if (out == 0) { return 0 - 1; }
    var off = 0;
    var t = 0;
    while (t < count) {
        var p = 0;
        while (p < np) {
            var psx = 0;
            var psy = 0;
            if (p > 0) { psx = sx; psy = sy; }
            var x0 = ((t % ow) * tw) >> psx;
            var y0 = ((t / ow) * th) >> psy;
            var y = 0;
            while (y < (th >> psy)) {
                var x = 0;
                while (x < (tw >> psx)) {
                    var v = dr_frame_get(f, p, x0 + x, y0 + y);
                    store8(out + off, v & 255);
                    if (bps == 2) { store8(out + off + 1, (v >> 8) & 255); }
                    off = off + bps;
                    x = x + 1;
                }
                y = y + 1;
            }
            p = p + 1;
        }
        t = t + 1;
    }
    if (file_write_all(path, out, off) < 0) { return 0 - 2; }
    return off;
}

# build/conformance-input.lst, when present, holds N: the stream is a large-scale tile file (libaom's lightfield
# layout) whose first N temporal units are the anchor frames — decoded normally, each kept as AnchorFrames[ k - 1 ]
# — after which the decoder switches to large-scale tile mode. Returns N, or 0 for an ordinary stream.
fn conf_lst_anchors(): i64 {
    var v = conf_read_uint("build/conformance-input.lst");
    if ((v < 1) || (v > 128)) { return 0; }
    return v;
}
# the leading decimal digits of a small sidecar file, or -1 when it is absent or starts with no digit
fn conf_read_uint(path): i64 {
    var b = alloc(32);   # bytes
    var n = file_read_all(path, b, 31);
    if (n <= 0) { return 0 - 1; }
    var v = 0;
    var i = 0;
    while ((i < n) && (i < 9) && (load8(b + i) >= 48) && (load8(b + i) <= 57)) {
        v = (v * 10) + (load8(b + i) - 48);
        i = i + 1;
    }
    if (i == 0) { return 0 - 1; }
    return v;
}

fn main() {
    alloc_init();
    # build/conformance-input.oom, when present, holds k for OOM fault injection (0.8.5): k >= 1 makes drishti's
    # k-th allocation fail (dr_alloc_fail_at) — the IVF reader and the decoder's own included — and 0 only counts
    # them; the count is reported before the SUMMARY. The harness's own buffers use the raw allocator, never failed.
    var oomk = conf_read_uint("build/conformance-input.oom");
    if (oomk >= 0) { dr_alloc_fail_at(oomk); }
    # the decoder's frame arena is POISONED at every reset (0.8.5): memory a frame used is filled with 0xA5 before the
    # next frame reuses it, so anything still pointing into it reads garbage — and the md5s below catch it
    dr_alloc_set_poison(1);
    var buf = alloc(CONF_MAX_INPUT);
    if (buf == 0) { conf_puts("SUMMARY oom\n"); return 1; }
    var n = file_read_all("build/conformance-input.ivf", buf, CONF_MAX_INPUT);
    if (n <= 0) {
        conf_puts("SUMMARY cannot-read-input\n");
        return 1;
    }
    if (n >= CONF_MAX_INPUT) {
        conf_puts("SUMMARY input-too-large\n");   # a truncated read would score as a short stream
        return 1;
    }
    var e = 0;
    var r = dr_ivf_reader_init(buf, n, &e);
    if ((r == 0) || (e != DR_OK)) {
        conf_puts("SUMMARY not-an-ivf err=");
        conf_putn(e);
        conf_puts("\n");
        return 1;
    }
    var hdr = dr_ivf_reader_hdr(r);
    conf_puts("input ");
    conf_putn(dr_ivf_hdr_width(hdr));
    conf_puts("x");
    conf_putn(dr_ivf_hdr_height(hdr));
    conf_puts(" declared_frames=");
    conf_putn(dr_ivf_hdr_frame_count(hdr));
    conf_puts("\n");

    var dec = av1_decoder_new(0);
    if (dec == 0) { conf_puts("SUMMARY decoder-new err=9 (out of memory)\n"); return 1; }
    # build/conformance-input.op, when present, holds the operating point to decode (0.8.4 scalability): only its
    # layers' OBUs are decoded, and a temporal unit with none of them shows no frame
    var opreq = conf_read_uint("build/conformance-input.op");
    if (opreq >= 0) {
        if (av1_decoder_set_operating_point(dec, opreq) != DR_OK) {
            conf_puts("SUMMARY bad-operating-point\n");
            return 1;
        }
        conf_puts("operating point requested: ");
        conf_putn(opreq);
        conf_puts("\n");
    }
    var nanch = conf_lst_anchors();
    if (nanch > 0) {
        conf_puts("large-scale tile: ");
        conf_putn(nanch);
        conf_puts(" anchor temporal units\n");
    }
    # build/conformance-input.loops, when present, holds K (1..16): the stream is fed K times through the SAME
    # decoder (0.8.5 memory bound). Unit k of pass p is written as unit (p - 1) * units + k, and after each pass
    # the harness reports the bytes drishti took from the global allocator during that pass's decode calls: once
    # the decoder has settled, a pass takes none.
    var loops = conf_read_uint("build/conformance-input.loops");
    if ((loops < 1) || (loops > 16)) { loops = 1; }
    var ok = 0;
    var k = 0;
    var go = 1;
    var pass = 1;
    var fatal = 0;
    while ((pass <= loops) && (fatal == 0)) {
        if (pass > 1) {
            r = dr_ivf_reader_init(buf, n, &e);
            if (r == 0) { go = 0; }
            av1_decoder_set_large_scale_tile(dec, 0);   # a pass starts with the anchor frames again
        }
        var ku = 0;
        var pass_bytes = 0;
        while (go == 1) {
            var pp = 0;
            var ps = 0;
            var pt = 0;
            if (dr_ivf_next_frame(r, &pp, &ps, &pt) != DR_OK) { go = 0; }
            else {
                k = k + 1;
                ku = ku + 1;
                var derr = 0;
                var lst_out = 0;
                if ((nanch > 0) && (ku > nanch)) { lst_out = 1; }
                var g0 = dr_alloc_global_bytes();
                var f = av1_decoder_decode(dec, pp, ps, &derr);
                if ((nanch > 0) && (ku <= nanch) && (derr == DR_OK)) {
                    # a failed anchor registration (DR_ERR_OOM) fails this unit and ends the stream: every tile list
                    # after it would decode against a missing anchor (0.8.5 — the harness dropped this result)
                    derr = av1_decoder_set_anchor(dec, ku - 1, av1_decoder_last_decoded(dec));
                    if (derr != DR_OK) { f = 0; go = 0; fatal = 1; }
                    if (ku == nanch) { av1_decoder_set_large_scale_tile(dec, 1); }
                }
                pass_bytes = pass_bytes + (dr_alloc_global_bytes() - g0);
                if (oomk >= 0) {   # the allocation count at this unit's end, so a sweep can aim at each unit
                    conf_puts("oom-unit ");
                    conf_putn(k);
                    conf_puts(" end ");
                    conf_putn(dr_alloc_count());
                    conf_puts("\n");
                }
                conf_puts("frame ");
                conf_putn(k);
                if (derr != DR_OK) {
                    conf_puts(" DECODE-FAILED err=");
                    conf_putn(derr);
                    conf_puts(" (");
                    conf_puts(dr_err_name(derr));
                    conf_puts(")\n");
                } else {
                    if (f == 0) {
                        conf_puts(" NO-OUTPUT (the unit showed no frame)\n");
                    } else {
                        var wrote = 0;
                        if (lst_out != 0) {
                            wrote = conf_write_tiles(f, conf_out_path(k), av1_decoder_tile_list_count(dec),
                              av1_decoder_tile_list_tile_w(dec), av1_decoder_tile_list_tile_h(dec),
                              av1_decoder_tile_list_out_w(dec));
                            conf_puts(" tile-list tiles=");
                            conf_putn(av1_decoder_tile_list_count(dec));
                        } else {
                            wrote = conf_write_frame(f, conf_out_path(k));
                        }
                        conf_puts(" decoded ");
                        conf_putn(dr_frame_width(f));
                        conf_puts("x");
                        conf_putn(dr_frame_height(f));
                        conf_puts(" planes=");
                        conf_putn(dr_frame_num_planes(f));
                        conf_puts(" bitdepth=");
                        conf_putn(dr_frame_bit_depth(f));
                        conf_puts(" shown=");
                        conf_putn(av1_decoder_shown_count(dec));
                        conf_puts(" wrote=");
                        conf_putn(wrote);
                        conf_puts("\n");
                        if (wrote > 0) { ok = ok + 1; }
                    }
                }
            }
        }
        if (loops > 1) {
            conf_puts("mem pass ");
            conf_putn(pass);
            conf_puts(" bytes ");
            conf_putn(pass_bytes);
            conf_puts(" arena ");
            conf_putn(av1_decoder_arena_bytes(dec));
            conf_puts(" pool-frames ");
            conf_putn(av1_decoder_pool_frames(dec));
            conf_puts("\n");
        }
        if (go == 0) { go = 1; }
        pass = pass + 1;
    }
    if (oomk >= 0) {
        conf_puts("oom: fail-at ");
        conf_putn(oomk);
        conf_puts(" allocations ");
        conf_putn(dr_alloc_count());
        conf_puts("\n");
    }
    if (opreq >= 0) {
        conf_puts("operating point chosen: ");
        conf_putn(av1_decoder_operating_point(dec));
        conf_puts(" idc=");
        conf_putn(av1_decoder_operating_point_idc(dec));
        conf_puts("\n");
    }
    conf_puts("SUMMARY decoded=");
    conf_putn(ok);
    conf_puts("/");
    conf_putn(k);
    conf_puts("\n");
    if ((k > 0) && (ok == k)) { return 0; }
    return 1;
}

var exit_code = main();
syscall(60, exit_code);
