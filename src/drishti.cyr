# @public — drishti core: error codes, DrErr record, version, stream sniffing.
# drishti (दृष्टि — sight/vision) — sovereign video codecs for AGNOS.
#
# This module is FLAT (no includes) — stdlib resolves via cyrius.cyml and
# the include chain is wired in src/main.cyr. Every symbol carries the dr_
# prefix (Cyrius has no module-private scoping; duplicate fn names silently
# shadow).
#
# DrErr struct layout (16 bytes, heap; chitra ChitraErr pattern —
# layout-compatible with mabda's GpuErr):
#   +0: code    — error code constant (one of the DR_* below)
#   +8: detail  — pointer to a detail cstring (or 0)

# ================================================================
# Error code constants
#
# Core codes are 0-9. Codec FAMILIES get reserved bands so their
# module-local enums never collide with core or each other:
#   10-29  AV1     (src/av1_*.cyr)
#   30-49  H.264   (src/h264_*.cyr)
#   50-69  H.265   (src/h265_*.cyr)
#   70-89  VP8/VP9 (src/vp8_*.cyr / src/vp9_*.cyr / src/vpx_*.cyr)
#   90-98  reserved (future families)
# Families REUSE the core codes for the generic conditions (truncation,
# bounds, oversize, ...) and mint band codes only for codec-specific
# failures. DR_ERR_OTHER = 99 is the catch-all.
# ================================================================

enum DrErrCode {
    DR_OK                = 0;   # no error
    DR_ERR_TRUNCATED     = 1;   # input ends before a field/payload completes
    DR_ERR_BOUNDS        = 2;   # out-of-bounds read/seek, bad offset, misalignment
    DR_ERR_FORBIDDEN_BIT = 3;   # forbidden/reserved bit set (e.g. H.264 7.4.1 forbidden_zero_bit)
    DR_ERR_BAD_LEB128    = 4;   # leb128 >8 bytes or value >32 bits (AV1 spec 4.10.5 conformance)
    DR_ERR_BAD_VLC       = 5;   # malformed variable-length code (uvlc / exp-Golomb overflow)
    DR_ERR_BAD_HEADER    = 6;   # malformed container/OBU/NAL header (magic, sizes, ordering)
    DR_ERR_UNSUPPORTED   = 7;   # valid stream, but the feature is out of drishti's scope
    DR_ERR_OVERSIZE      = 8;   # size field exceeds sanity cap (decompression-bomb guard)
    DR_ERR_OOM           = 9;   # allocation failed
    DR_ERR_OTHER         = 99;  # catch-all
}

# ================================================================
# Stream/container sniff kinds (dr_sniff result)
# ================================================================

enum DrSniffKind {
    DR_SNIFF_UNKNOWN = 0;   # neither IVF nor Annex-B
    DR_SNIFF_IVF     = 1;   # IVF container ("DKIF" magic)
    DR_SNIFF_ANNEXB  = 2;   # raw Annex-B byte stream (00 00 01 / 00 00 00 01)
}

# ================================================================
# FourCC constants — the u32 you get from a little-endian 32-bit read
# of the 4 ASCII bytes (byte order in file: 'D','K','I','F' etc.).
# ================================================================

enum DrFourcc {
    DR_FOURCC_DKIF = 0x46494B44;   # "DKIF" — IVF magic
    DR_FOURCC_AV01 = 0x31305641;   # "AV01" — AV1 in IVF
    DR_FOURCC_VP80 = 0x30385056;   # "VP80" — VP8 in IVF
    DR_FOURCC_VP90 = 0x30395056;   # "VP90" — VP9 in IVF
}

# ================================================================
# Version — MAJOR*1000000 + MINOR*1000 + PATCH, each component 0..999
# (0.8.0 -> 8000, 1.2.3 -> 1002003). Widened at 0.8.0 from
# MAJOR*10000 + MINOR*100 + PATCH, which overflowed once PATCH reached 100:
# 0.7.131 packed to 831, ABOVE 0.8.0's 800 under the old form. Every value
# the new form yields from 0.8.0 on is above every value the old one ever
# produced (its maximum was 831), so ordering holds across the change.
# Keep in sync with the VERSION file at each cut; scripts/version-check.sh
# enforces both the value and the 0..999 component range.
# ================================================================

fn drishti_version(): i64 {
    return 8005;
}

# ================================================================
# dr_alloc — every allocation in src/ goes through here (0.8.5), so an allocation FAILURE can be injected and every
# DR_ERR_OOM branch exercised, and so a decoder can serve its per-frame work from an arena. dr_alloc_fail_at(n),
# n >= 1, makes the n-th dr_alloc / dr_alloc_keep from then on return 0 (one failure, as if memory ran out at that
# call and only that call), then carries on normally; dr_alloc_fail_at(0) turns injection off. dr_alloc_count() is
# the number of calls since the last dr_alloc_fail_at. Test-only machinery: no decode or encode path calls
# dr_alloc_fail_at or dr_alloc_sweep.
#
# WHERE THE MEMORY COMES FROM. The stdlib allocator is a bump allocator: it never frees. Outside an allocation
# scope (the default) dr_alloc is that allocator. A streaming decoder opens a scope (dr_alloc_scope) over its own
# DrArena, and dr_alloc then serves from the arena, which the decoder rewinds at every frame start: a frame's tiles,
# grids, CDF contexts and per-block records are dead once it is decoded, and served from the bump they grew memory
# ~35-60 bytes per pixel per frame without bound (measured 0.8.5). What must outlive the frame is taken with
# dr_alloc_keep, or inside dr_persist_begin / dr_persist_end: the lazily-built tables and persistent scratch, the
# reference slots' saved state, the decoder's own records and its pooled frames (src/frame.cyr).
# ================================================================
var Dr_Alloc_Fail_Left = 0;   # 0 = off; else the countdown to the failing call
var Dr_Alloc_Calls = 0;       # dr_alloc / dr_alloc_keep calls since the last dr_alloc_fail_at
var Dr_Alloc_Arena = 0;       # the scope's DrArena (0 = no scope: the global allocator)
var Dr_Alloc_Persist = 0;     # > 0: inside dr_persist_begin / end, dr_alloc bypasses the arena
var Dr_Alloc_Poison = 0;      # 1: dr_arena_reset fills its chunks with 0xA5 first (a stale pointer reads garbage)
var Dr_Alloc_Global = 0;      # bytes drishti has taken from the global allocator (arena chunks included)
# 1 when this call must fail (counts it)
fn dr_alloc_inject(): i64 {
    Dr_Alloc_Calls = Dr_Alloc_Calls + 1;
    if (Dr_Alloc_Fail_Left > 0) {
        Dr_Alloc_Fail_Left = Dr_Alloc_Fail_Left - 1;
        if (Dr_Alloc_Fail_Left == 0) { return 1; }
    }
    return 0;
}
# Fill / copy n bytes a WORD at a time (with a byte tail). The stdlib memset / memcpy move one byte per iteration;
# the arena zeroes every allocation and a reference slot copies every block it saves, megabytes a frame, so the
# word loop is what keeps the memory bound cheap. dst / src should be 8-aligned (every allocation is).
fn dr_fill(dst, byte, n): i64 {
    var w = byte & 255;
    w = w | (w << 8);
    w = w | (w << 16);
    w = w | (w << 32);
    var i = 0;
    var nw = n & (0 - 8);
    while (i < nw) { store64(dst + i, w); i = i + 8; }
    while (i < n) { store8(dst + i, byte); i = i + 1; }
    return dst;
}
fn dr_copy(dst, src, n): i64 {
    var i = 0;
    var nw = n & (0 - 8);
    while (i < nw) { store64(dst + i, load64(src + i)); i = i + 8; }
    while (i < n) { store8(dst + i, load8(src + i)); i = i + 1; }
    return dst;
}
# the global allocator, counted
fn dr_alloc_global(size): i64 {
    var p = alloc(size);
    if (p != 0) { Dr_Alloc_Global = Dr_Alloc_Global + ((size + 7) & (0 - 8)); }
    return p;
}
fn dr_alloc_serve(size, keep): i64 {
    if ((keep == 0) && (Dr_Alloc_Arena != 0) && (Dr_Alloc_Persist == 0)) {
        return dr_arena_alloc(Dr_Alloc_Arena, size);
    }
    return dr_alloc_global(size);
}
fn dr_alloc(size): i64 {
    if (dr_alloc_inject() != 0) { return 0; }
    return dr_alloc_serve(size, 0);
}
# an allocation that outlives the current frame: always the global allocator, scope or not
fn dr_alloc_keep(size): i64 {
    if (dr_alloc_inject() != 0) { return 0; }
    return dr_alloc_serve(size, 1);
}
# everything allocated between these (a persistent object graph built by code that calls plain dr_alloc) is kept
fn dr_persist_begin(): i64 { Dr_Alloc_Persist = Dr_Alloc_Persist + 1; return 0; }
fn dr_persist_end(): i64 {
    if (Dr_Alloc_Persist > 0) { Dr_Alloc_Persist = Dr_Alloc_Persist - 1; }
    return 0;
}
# open (a != 0) or close (0) an allocation scope; returns the previous scope's arena, to restore it
fn dr_alloc_scope(a): i64 {
    var prev = Dr_Alloc_Arena;
    Dr_Alloc_Arena = a;
    return prev;
}
fn dr_alloc_set_poison(on): i64 { Dr_Alloc_Poison = on; return 0; }
fn dr_alloc_global_bytes(): i64 { return Dr_Alloc_Global; }

# ================================================================
# DrArena — a chain of chunks taken from the global allocator, bump-allocated. dr_arena_reset rewinds to the first
# chunk and KEEPS the chain, so a loop that resets once per frame settles at its high-water mark and then takes no
# more memory. Allocations are ZEROED: fresh bump memory always was, and code written against it must see no
# difference. Chunk: { next, cap, data[ cap ] }. A request larger than the chunk size gets a chunk of its own.
# ================================================================
enum DrArenaOff {
    DR_ARENA_FIRST = 0;    # the first chunk (0 until the first allocation)
    DR_ARENA_CUR   = 8;    # the chunk being bumped
    DR_ARENA_PTR   = 16;   # the bump pointer in it
    DR_ARENA_END   = 24;   # its end
    DR_ARENA_CHUNK = 32;   # the chunk size
    DR_ARENA_SIZE  = 40;   # bytes
}
fn dr_arena_new(chunk_size): i64 {
    var a = dr_alloc_keep(DR_ARENA_SIZE);   # DR_ARENA_SIZE bytes
    if (a == 0) { return 0; }
    memset(a, 0, DR_ARENA_SIZE);
    var cs = chunk_size;
    if (cs < 4096) { cs = 4096; }
    store64(a + DR_ARENA_CHUNK, cs);
    return a;
}
# make the arena's current chunk one with room for need bytes: the next chunk of the chain if it fits, else a new
# one linked in after the current. 1, or 0 when the global allocator fails.
fn dr_arena_grow(a, need): i64 {
    var cur = load64(a + DR_ARENA_CUR);
    var nxt = load64(a + DR_ARENA_FIRST);
    if (cur != 0) { nxt = load64(cur); }
    if ((nxt != 0) && (load64(nxt + 8) >= need)) {
        store64(a + DR_ARENA_CUR, nxt);
        store64(a + DR_ARENA_PTR, nxt + 16);
        store64(a + DR_ARENA_END, nxt + 16 + load64(nxt + 8));
        return 1;
    }
    var cap = load64(a + DR_ARENA_CHUNK);
    if (need > cap) { cap = need; }
    var ch = dr_alloc_global(cap + 16);
    if (ch == 0) { return 0; }
    store64(ch, nxt);
    store64(ch + 8, cap);
    if (cur == 0) { store64(a + DR_ARENA_FIRST, ch); } else { store64(cur, ch); }
    store64(a + DR_ARENA_CUR, ch);
    store64(a + DR_ARENA_PTR, ch + 16);
    store64(a + DR_ARENA_END, ch + 16 + cap);
    return 1;
}
fn dr_arena_alloc(a, size): i64 {
    if (size <= 0) { return 0; }
    var sz = (size + 7) & (0 - 8);
    var p = load64(a + DR_ARENA_PTR);
    if ((p == 0) || (sz > (load64(a + DR_ARENA_END) - p))) {
        if (dr_arena_grow(a, sz) == 0) { return 0; }
        p = load64(a + DR_ARENA_PTR);
    }
    store64(a + DR_ARENA_PTR, p + sz);
    dr_fill(p, 0, sz);
    return p;
}
# everything allocated from the arena is dead from here (poisoned first when Dr_Alloc_Poison is on)
fn dr_arena_reset(a): i64 {
    if (a == 0) { return 0; }
    var ch = load64(a + DR_ARENA_FIRST);
    if (Dr_Alloc_Poison != 0) {
        var c = ch;
        while (c != 0) { dr_fill(c + 16, 0xA5, load64(c + 8)); c = load64(c); }
    }
    store64(a + DR_ARENA_CUR, 0);
    store64(a + DR_ARENA_PTR, 0);
    store64(a + DR_ARENA_END, 0);
    return 0;
}
# the bytes the arena holds (every chunk's capacity) — its high-water mark once a loop has settled
fn dr_arena_capacity(a): i64 {
    if (a == 0) { return 0; }
    var total = 0;
    var c = load64(a + DR_ARENA_FIRST);
    while (c != 0) { total = total + load64(c + 8); c = load64(c); }
    return total;
}
fn dr_alloc_fail_at(n): i64 {
    Dr_Alloc_Fail_Left = n;
    if (n < 0) { Dr_Alloc_Fail_Left = 0; }
    Dr_Alloc_Calls = 0;
    return 0;
}
fn dr_alloc_count(): i64 { return Dr_Alloc_Calls; }
# dr_alloc_sweep(fp, arg, out_n) — the OOM witness the suites share. fp(arg) runs one operation and returns DR_OK,
# or the error it stopped with. The sweep runs it once to build any lazily-built state, once more to count its
# allocations N (written to *out_n), then N times more with the k-th allocation failing, k = 1..N. Every one of
# those must return DR_ERR_OOM: a crash is a crash, another code is a mislabelled OOM, and DR_OK means the failure
# was swallowed. A last fault-free run must be DR_OK again (no failed run left state behind). Returns 0 when all of
# that holds, the first k that broke it, or -1 when a fault-free run failed. Lazy state built by the first run is
# never failed here — make conformance's oom section fails it, in a fresh process per k.
fn dr_alloc_sweep(fp, arg, out_n): i64 {
    store64(out_n, 0);
    dr_alloc_fail_at(0);
    if (callptr(fp, arg) != DR_OK) { return 0 - 1; }
    dr_alloc_fail_at(0);
    if (callptr(fp, arg) != DR_OK) { return 0 - 1; }
    var n = dr_alloc_count();
    store64(out_n, n);
    var k = 1;
    while (k <= n) {
        dr_alloc_fail_at(k);
        var rc = callptr(fp, arg);
        dr_alloc_fail_at(0);
        if (rc != DR_ERR_OOM) { return k; }
        k = k + 1;
    }
    if (callptr(fp, arg) != DR_OK) { return 0 - 1; }
    return 0;
}

# ================================================================
# DrErr — 16-byte error record {code, detail-ptr}
# ================================================================

# Create a DrErr with code and an optional detail cstring (0 = none).
fn dr_err_new(code, detail): i64 {
    var e = dr_alloc(16);
    if (e == 0) { return 0; }
    store64(e, code);
    store64(e + 8, detail);
    return e;
}

# Create a DrErr with code only (no detail).
fn dr_err(code): i64 {
    return dr_err_new(code, 0);
}

# Get the error code.
fn dr_err_code(e): i64 {
    return load64(e);
}

# Get the detail string pointer (or 0).
fn dr_err_detail(e): i64 {
    return load64(e + 8);
}

# ================================================================
# Error name lookup — returns a cstring (never null). Family-band
# codes fall through to per-band names so an unmapped family code
# still prints something meaningful.
# ================================================================

fn dr_err_name(code): i64 {
    if (code == DR_OK)                { return "ok"; }
    if (code == DR_ERR_TRUNCATED)     { return "truncated input"; }
    if (code == DR_ERR_BOUNDS)        { return "out-of-bounds read"; }
    if (code == DR_ERR_FORBIDDEN_BIT) { return "forbidden bit set"; }
    if (code == DR_ERR_BAD_LEB128)    { return "bad leb128"; }
    if (code == DR_ERR_BAD_VLC)       { return "bad variable-length code"; }
    if (code == DR_ERR_BAD_HEADER)    { return "bad header"; }
    if (code == DR_ERR_UNSUPPORTED)   { return "unsupported feature"; }
    if (code == DR_ERR_OVERSIZE)      { return "oversize field"; }
    if (code == DR_ERR_OOM)           { return "out of memory"; }
    if (code == DR_ERR_OTHER)         { return "other error"; }
    if ((code >= 10) && (code <= 29)) { return "AV1 error"; }
    if ((code >= 30) && (code <= 49)) { return "H.264 error"; }
    if ((code >= 50) && (code <= 69)) { return "H.265 error"; }
    if ((code >= 70) && (code <= 89)) { return "VP8/VP9 error"; }
    return "unknown error";
}

# Print an error name to stderr (fd 2).
fn dr_err_print_name(code): i64 {
    var name = dr_err_name(code);
    syscall(1, 2, name, strlen(name));
    return 0;
}

# ================================================================
# dr_sniff — classify a byte buffer as IVF / Annex-B / unknown.
#
# IVF:     bytes 0-3 == "DKIF" (needs len >= 4). Full header
#          validation is dr_ivf_reader_init's job — sniff is cheap.
# Annex-B: 4-byte start code 00 00 00 01 checked BEFORE the 3-byte
#          00 00 01 (the 3-byte probe would match the 4-byte prefix
#          bytes 0-2 = 00 00 00 and misreport). H.264 spec Annex B /
#          H.265 Annex B byte-stream NAL unit syntax.
# Every read is bounds-checked against len; never reads past buf+len.
# ================================================================

fn dr_sniff(buf, len): i64 {
    if (len >= 4) {
        # "DKIF" byte-by-byte — no unaligned 32-bit read needed.
        if ((load8(buf) == 0x44) && (load8(buf + 1) == 0x4B)
          && (load8(buf + 2) == 0x49) && (load8(buf + 3) == 0x46)) {
            return DR_SNIFF_IVF;
        }
        if ((load8(buf) == 0) && (load8(buf + 1) == 0)
          && (load8(buf + 2) == 0) && (load8(buf + 3) == 1)) {
            return DR_SNIFF_ANNEXB;
        }
    }
    if (len >= 3) {
        if ((load8(buf) == 0) && (load8(buf + 1) == 0) && (load8(buf + 2) == 1)) {
            return DR_SNIFF_ANNEXB;
        }
    }
    return DR_SNIFF_UNKNOWN;
}

# dr_sniff_fourcc — for an IVF buffer, the codec FourCC at header
# bytes 8-11 as a little-endian u32 (compare against DR_FOURCC_*).
# Returns 0 if the buffer is not IVF or too short to carry the field.
# LE read inlined byte-by-byte: drishti.cyr is the dep-free root module
# and must not reach into bits.cyr (dr_rd_le32).
fn dr_sniff_fourcc(buf, len): i64 {
    if (dr_sniff(buf, len) != DR_SNIFF_IVF) { return 0; }
    if (len < 12) { return 0; }
    var v = load8(buf + 8);
    v = v + (load8(buf + 9) << 8);
    v = v + (load8(buf + 10) << 16);
    v = v + (load8(buf + 11) << 24);
    return v;
}
