# src/av1_dpb.cyr — AV1 decoded-picture buffer (DPB) + the reference-frame
# update / loading processes + a multi-frame stream driver.
#
# The spec's FrameStore[ 0..NUM_REF_FRAMES-1 ] is the ring of decoded reference
# frames that inter prediction reads from: after a frame is decoded (and in-loop
# filtered + upscaled), the reference frame update process (spec 7.20) saves its
# PIXELS into every slot flagged by refresh_frame_flags; a show_existing_frame
# then pulls a stored frame back out via the reference frame loading process
# (7.21). This module is the PIXEL half of that ring — the eight decoded-frame
# (DrFrame) slots. The per-slot METADATA half (dimensions, order hints, saved
# global-motion) already lives in Av1RefState (src/av1_frame.cyr), advanced by
# av1_frame_update_refs; av1_dpb_update runs both together so one call is the
# whole 7.20 process.
#
# This is the piece the inter layer needs: av1_dpb_ref_frame maps a frame's
# LAST..ALTREF reference through ref_frame_idx to the stored DrFrame that the MC
# driver (av1_mc_pred_block, 0.7.60) reads. It also unlocks MULTI-FRAME decode:
# av1_decode_stream walks a whole OBU stream, decodes each frame into the DPB,
# and serves show_existing_frame from it (av1_decode_obus stays the single-frame
# entry; this is its multi-frame superset).
#
# FLAT module — wired LAST in the AV1 chain (after src/av1_decode.cyr) so it can
# call the frame-decode driver + OBU walk. Family av1_. Depends on: av1_decode
# (av1_decode_frame / av1_frame_dec_* / av1_obu_*), av1_frame (av1_fh_* / refs /
# av1_frame_update_refs), av1_seq, frame (DrFrame), drishti (DR_ERR_*).
#
# Derived from the AV1 spec §7.20 (reference frame update) + §7.21 (reference
# frame loading) + §7.2 (general OBU decode order). SCOPE (0.7.61): the decoded
# frame ring + store/load/ref-frame accessors + the multi-frame walk. Only the
# PIXEL FrameStore is new here; the saved-CDF / saved-MV / saved-segment-id state
# (7.20's other outputs) belongs to later inter bites. Because the tile decoder
# is intra-only so far, av1_decode_stream decodes multi-KEYFRAME / intra streams
# and serves show_existing; a genuine inter frame's tiles await the inter
# mode-info bite (roadmap.md).

# ================================================================
# Av1Dpb — the decoded-frame ring. Eight slots, each a DrFrame pointer
# (FrameStore[i]); null = empty. Slots may alias the same DrFrame buffer (a
# frame that refreshes several references, or a KEY show_existing that refreshes
# all) — the arena owns the buffers (never freed), so aliasing is safe.
# ================================================================
enum Av1DpbOff {
    AV1DPB_FRAMES = 0;    # [AV1_NUM_REF_FRAMES] DrFrame pointers -> 64
    AV1DPB_SIZE   = 64;
}

# av1_dpb_new — allocate an empty DPB (all eight slots null). Returns the handle
# or 0 on OOM.
fn av1_dpb_new(): i64 {
    var d = dr_alloc(AV1DPB_SIZE);
    if (d == 0) { return 0; }
    memset(d, 0, AV1DPB_SIZE);
    return d;
}

# av1_dpb_frame — the DrFrame in slot i (i in 0..NUM_REF_FRAMES-1), or 0 if the
# index is out of range or the slot is empty.
fn av1_dpb_frame(dpb, i): i64 {
    if ((dpb == 0) || (i < 0) || (i >= AV1_NUM_REF_FRAMES)) { return 0; }
    return load64(dpb + AV1DPB_FRAMES + (i * 8));
}

# av1_dpb_valid — 1 if slot i holds a frame, else 0.
fn av1_dpb_valid(dpb, i): i64 {
    if (av1_dpb_frame(dpb, i) != 0) { return 1; }
    return 0;
}

# av1_dpb_count — number of occupied slots.
fn av1_dpb_count(dpb): i64 {
    if (dpb == 0) { return 0; }
    var n = 0;
    var i = 0;
    while (i < AV1_NUM_REF_FRAMES) {
        if (load64(dpb + AV1DPB_FRAMES + (i * 8)) != 0) { n = n + 1; }
        i = i + 1;
    }
    return n;
}

# ================================================================
# av1_dpb_store — reference frame update process (spec 7.20), PIXEL half: store
# `frame` into every slot i where bit i of refresh_frame_flags is 1. A frame that
# refreshes several references (or a KEY show_existing → all 255) aliases one
# buffer across those slots. Returns DR_OK, or DR_ERR_BOUNDS on a null dpb/frame.
# The METADATA half (RefValid / dims / order hints / gm) is av1_frame_update_refs;
# av1_dpb_update runs both.
# ================================================================
fn av1_dpb_store(dpb, fh, frame): i64 {
    if ((dpb == 0) || (frame == 0)) { return DR_ERR_BOUNDS; }
    var flags = av1_fh_refresh_frame_flags(fh);
    var i = 0;
    while (i < AV1_NUM_REF_FRAMES) {
        if ((flags >> i) & 1) {
            store64(dpb + AV1DPB_FRAMES + (i * 8), frame);
        }
        i = i + 1;
    }
    return DR_OK;
}

# av1_dpb_update — the WHOLE reference frame update process (7.20): the pixel
# store (av1_dpb_store) AND the metadata save (av1_frame_update_refs), so one
# call advances both halves of the ring in lockstep. Returns DR_OK / DR_ERR_*.
fn av1_dpb_update(dpb, refs, s, fh, frame): i64 {
    var rc = av1_dpb_store(dpb, fh, frame);
    if (rc != DR_OK) { return rc; }
    return av1_frame_update_refs(refs, s, fh);
}

# ================================================================
# av1_dpb_load — reference frame loading process (spec 7.21), PIXEL half: return
# FrameStore[ frame_to_show_map_idx ] for a show_existing_frame. Validates the
# index range and that the slot is occupied (a show_existing pointing at an empty
# slot is a malformed stream — DR_ERR_BAD_HEADER, never a null-deref). Writes
# *out_err. The metadata half (loading dims / order hints back into the frame
# variables) is surfaced by the header parser inline (av1_frame_parse_..., the
# show_existing branch) for the fields the decode consults.
# ================================================================
fn av1_dpb_load(dpb, fh, out_err): i64 {
    store64(out_err, DR_OK);
    if (dpb == 0) { store64(out_err, DR_ERR_BOUNDS); return 0; }
    var idx = av1_fh_frame_to_show(fh);
    if ((idx < 0) || (idx >= AV1_NUM_REF_FRAMES)) {
        store64(out_err, DR_ERR_BAD_HEADER); return 0;
    }
    var frame = load64(dpb + AV1DPB_FRAMES + (idx * 8));
    if (frame == 0) { store64(out_err, DR_ERR_BAD_HEADER); return 0; }
    return frame;
}

# ================================================================
# av1_dpb_ref_frame — the inter-prediction hook: return the decoded reference
# frame for a symbolic reference `refFrame` (LAST_FRAME..ALTREF_FRAME) of the
# current frame, i.e. FrameStore[ ref_frame_idx[ refFrame - LAST_FRAME ] ]. This
# is the DrFrame the MC driver (av1_mc_pred_block) reads from. Returns 0 if
# refFrame is out of range, the mapped slot index is out of range, or the slot is
# empty (the caller treats 0 as "reference unavailable").
# ================================================================
fn av1_dpb_ref_frame(dpb, fh, refFrame): i64 {
    if ((dpb == 0) || (refFrame < AV1_LAST_FRAME) || (refFrame > AV1_ALTREF_FRAME)) {
        return 0;
    }
    var slot = av1_fh_ref_frame_idx(fh, refFrame - AV1_LAST_FRAME);
    return av1_dpb_frame(dpb, slot);
}

# ================================================================
# Av1Decoder — the STREAMING decoder (0.8.3). The DPB, the reference metadata
# (Av1RefState), the active sequence header and any frame still waiting for tile
# groups all PERSIST across calls, so a caller feeds a stream one temporal unit
# at a time and gets each unit's shown frame back as it is decoded — the way a
# player (or `aomdec`) consumes a stream. av1_decode_stream is the whole-buffer
# form of the same walk.
#
# WHY IT EXISTS. av1_decode_stream returns only the LAST shown frame of its
# input, so the conformance harness used to recover frame k by re-decoding the
# k-unit PREFIX from the keyframe with a fresh DPB: O(n^2) decode work, and a cap
# of 9 frames. A real GOP (hidden ARFs, show_existing overlays, a refresh pattern
# that cycles all eight slots) needs dozens of frames before its interesting
# reference states even occur. Streaming makes each frame cost one decode.
#
# One temporal unit carries exactly one shown frame per layer (7.5), and the
# output process without all-layers output shows the LAST one (7.18), which is
# what av1_decoder_decode returns for a call. NSHOWN counts them all, so a
# caller can tell a unit with no shown frame (0) from one with several.
#
# Errors are STICKY: a failed call leaves the reference state mid-update, so every
# later call returns the same error without reading its input (trust no input
# byte — a decoder must never limp on from a state it cannot vouch for).
# ================================================================
enum Av1DecOff {
    AV1DEC_DPB    = 0;    # Av1Dpb — the decoded-frame ring
    AV1DEC_REFS   = 8;    # Av1RefState — the per-slot reference metadata
    AV1DEC_SEQ    = 16;   # the active sequence header (0 until one is seen)
    AV1DEC_FH     = 24;   # a FRAME_HEADER still awaiting its tile groups (0 = none)
    AV1DEC_FDC    = 32;   # that frame's decode context (0 until its first tile group)
    AV1DEC_SHOWN  = 40;   # the last frame SHOWN by the most recent av1_decoder_decode call
    AV1DEC_NSHOWN = 48;   # how many frames that call showed
    AV1DEC_COUNT  = 56;   # frames processed since av1_decoder_new (coded + show_existing)
    AV1DEC_ERR    = 64;   # sticky error (DR_OK while healthy)
    AV1DEC_GRAIN  = 72;   # Av1GrainCtx for the film grain output process (0 until a frame needs grain)
    AV1DEC_LAST   = 80;   # the most recently DECODED frame, shown or not (a large-scale-tile anchor source)
    AV1DEC_LST    = 88;   # large-scale tile mode (7.3; 0 = off): frame headers are camera headers, tile lists decode
    AV1DEC_ANCH   = 96;   # AnchorFrames: 128 DrFrame pointers (0 until the first av1_decoder_set_anchor)
    AV1DEC_NANCH  = 104;  # 1 + the highest anchor index set
    AV1DEC_CAMFH  = 112;  # the camera frame header the tile lists decode against (0 = none yet)
    AV1DEC_TL_N   = 120;  # the last tile list: tile_count_minus_1 + 1
    AV1DEC_TL_TW  = 128;  # ...its TileWidth / TileHeight in samples
    AV1DEC_TL_TH  = 136;
    AV1DEC_TL_OW  = 144;  # ...output_frame_width_in_tiles_minus_1 + 1
    AV1DEC_OPREQ  = 152;  # the operating point requested by the application (0 = the stream's preferred)
    AV1DEC_OPSEL  = 160;  # the operating point chosen at the last sequence header (5.5.1 choose_operating_point)
    AV1DEC_OPIDC  = 168;  # OperatingPointIdc = operating_point_idc[ OPSEL ] (0 = every OBU decodes)
    # memory (0.8.5) — see "MEMORY" below
    AV1DEC_ARENA  = 176;  # the DrArena every frame's working memory comes from, reset at each frame start
    AV1DEC_POOL   = 184;  # the DrFramePool every frame the decoder makes comes from, swept at each frame start
    AV1DEC_IT     = 192;  # the OBU iterator, reused by every call
    AV1DEC_SEQBUF = 200;  # the decoder's own copy of the active sequence header (AV1DEC_SEQ points here)
    AV1DEC_CAMBUF = 208;  # its own copy of the camera frame header (AV1DEC_CAMFH points here)
    AV1DEC_MAXPIX = 216;  # the frame size limit in luma samples (0 = none): av1_decoder_set_frame_size_limit
    AV1DEC_SIZE   = 224;
}
# MEMORY (0.8.5). drishti's allocator never frees, and a decoder that took everything from it grew by ~35-60 bytes per
# pixel per frame, for ever. Now a decoder owns its memory, and a long stream settles at a fixed footprint:
#   - while av1_decoder_decode runs, every allocation is served from the decoder's ARENA (dr_alloc_scope), which
#     is rewound at each FRAME START — a frame header (FRAME_HEADER / FRAME, outside large-scale tile mode) or a
#     tile list — and at the start of a call that has no frame pending. A frame's tiles, grids, CDF contexts,
#     headers and per-block records are dead by then;
#   - every frame it makes (the reconstruction, the CDEF / loop-restoration / upscaled frames, a tile list's output,
#     the film grain output) comes from its frame POOL. At each frame start the pool keeps only what is still held —
#     the eight reference slots, the last decoded and last shown frames, the anchors, the grain output — and the rest
#     is reused;
#   - what outlives a frame is kept (dr_alloc_keep): the reference slots' saved blocks (their own copies), the sequence
#     and camera headers (copied into AV1DEC_SEQBUF / CAMBUF), the lazily-built tables, the grain context.
# The returned frame is therefore valid until the NEXT av1_decoder_decode call on the same decoder (a frame the
# DPB still holds lives longer, but nothing promises that); consume it, or copy it, before then.
# The frame start: everything the arena served is dead, and every pooled frame nothing holds is free again.
fn av1_decoder_frame_start(dec): i64 {
    var pool = load64(dec + AV1DEC_POOL);
    if (pool == 0) { return 0; }   # a decoder without its memory (a test's unbounded reference): nothing to do
    dr_frame_pool_sweep(pool);
    var dpb = load64(dec + AV1DEC_DPB);
    var i = 0;
    while (i < AV1_NUM_REF_FRAMES) { dr_frame_pool_root(pool, av1_dpb_frame(dpb, i)); i = i + 1; }
    dr_frame_pool_root(pool, load64(dec + AV1DEC_LAST));
    dr_frame_pool_root(pool, load64(dec + AV1DEC_SHOWN));
    var gc = load64(dec + AV1DEC_GRAIN);
    if (gc != 0) { dr_frame_pool_root(pool, load64(gc + AV1GC_OUT)); }
    var anch = load64(dec + AV1DEC_ANCH);
    if (anch != 0) {
        var j = 0;
        while (j < load64(dec + AV1DEC_NANCH)) { dr_frame_pool_root(pool, load64(anch + (j * 8))); j = j + 1; }
    }
    dr_frame_pool_poison_free(pool);   # only with poisoning on (make conformance, the corpus fuzzer)
    dr_arena_reset(load64(dec + AV1DEC_ARENA));
    store64(dec + AV1DEC_FH, 0);    # anything pending died with the arena
    store64(dec + AV1DEC_FDC, 0);
    return 0;
}
# copy the header record at src (n bytes) into the decoder's own buffer at field own_off (kept, made on first use);
# returns the buffer, or 0 on OOM
fn av1_decoder_own_copy(dec, own_off, src, n): i64 {
    var own = load64(dec + own_off);
    if (own == 0) {
        own = dr_alloc_keep(n);
        if (own == 0) { return 0; }
        store64(dec + own_off, own);
    }
    if (own != src) { dr_copy(own, src, n); }
    return own;
}

# av1_decoder_new — a streaming decoder over `dpb` (0 = allocate a fresh, empty
# one). Returns the handle, or 0 on OOM.
fn av1_decoder_new(dpb): i64 {
    dr_persist_begin();   # the decoder and everything it owns outlive every frame (and any enclosing scope)
    var d = av1_decoder_new_in(dpb);
    dr_persist_end();
    return d;
}
fn av1_decoder_new_in(dpb): i64 {
    var d = dr_alloc(AV1DEC_SIZE);   # AV1DEC_SIZE bytes
    if (d == 0) { return 0; }
    memset(d, 0, AV1DEC_SIZE);
    var ring = dpb;
    if (ring == 0) { ring = av1_dpb_new(); }
    var refs = av1_ref_state_new();
    if ((ring == 0) || (refs == 0)) { return 0; }
    var arena = dr_arena_new(1 << 20);   # 1 MiB chunks
    var pool = dr_frame_pool_new();
    var it = av1_obu_iter_init(d, 0);    # re-pointed at each call's buffer
    if ((arena == 0) || (pool == 0) || (it == 0)) { return 0; }
    store64(d + AV1DEC_DPB, ring);
    store64(d + AV1DEC_REFS, refs);
    store64(d + AV1DEC_ERR, DR_OK);
    store64(d + AV1DEC_ARENA, arena);
    store64(d + AV1DEC_POOL, pool);
    store64(d + AV1DEC_IT, it);
    return d;
}
# Refuse any frame larger than max_pixels luma samples with DR_ERR_OVERSIZE, as dav1d's frame_size_limit does: a
# stream that declares a huge frame cannot make the decoder allocate and clear it. Checked at every frame header
# (UpscaledWidth x FrameHeight) and for every large-scale tile list's output frame. 0 (the default) is no limit beyond
# DR_FRAME_MAX_DIM per side. A negative limit is DR_ERR_BOUNDS. Takes effect at the next frame header or tile list.
fn av1_decoder_set_frame_size_limit(dec, max_pixels): i64 {
    if (max_pixels < 0) { return DR_ERR_BOUNDS; }
    store64(dec + AV1DEC_MAXPIX, max_pixels);
    return DR_OK;
}
# 1 when the frame header fh is over the decoder's frame size limit
fn av1_decoder_over_limit(dec, fh): i64 {
    return av1_decoder_over_limit_wh(dec, av1_fh_upscaled_width(fh), av1_fh_frame_height(fh));
}
# 1 when a w x h frame is over it — every frame the decoder makes from stream-declared sizes is checked, a large-scale
# tile list's OUTPUT frame included: that one is sized by the tile list's own header (up to 256 x 256 tiles), not by
# any frame header, and until 0.8.5 bite 10 it escaped the limit (found by the corpus fuzzer)
fn av1_decoder_over_limit_wh(dec, w, h): i64 {
    var lim = load64(dec + AV1DEC_MAXPIX);
    if (lim == 0) { return 0; }
    return (w * h) > lim;
}
# Restart the decoder as if it were new — no sequence header, empty reference slots, no sticky error, no anchors or
# large-scale tile mode — while it keeps its memory: its arena, its frame pool, its slots' own buffers, its header
# copies, and its settings (the requested operating point, the frame size limit). A caller that seeks, or decodes
# many independent streams, reuses one decoder instead of building (and never freeing) one each time. Every frame it
# returned is invalid after this. Returns DR_OK.
fn av1_decoder_reset(dec): i64 {
    memset(load64(dec + AV1DEC_DPB), 0, AV1DPB_SIZE);
    memset(load64(dec + AV1DEC_REFS), 0, AV1REF_OWN);   # everything up to the slots' own buffers, which stay
    store64(dec + AV1DEC_SEQ, 0);
    store64(dec + AV1DEC_FH, 0);
    store64(dec + AV1DEC_FDC, 0);
    store64(dec + AV1DEC_SHOWN, 0);
    store64(dec + AV1DEC_NSHOWN, 0);
    store64(dec + AV1DEC_COUNT, 0);
    store64(dec + AV1DEC_ERR, DR_OK);
    store64(dec + AV1DEC_LAST, 0);
    store64(dec + AV1DEC_LST, 0);
    var anch = load64(dec + AV1DEC_ANCH);
    if (anch != 0) { memset(anch, 0, 128 * 8); }
    store64(dec + AV1DEC_NANCH, 0);
    store64(dec + AV1DEC_CAMFH, 0);
    store64(dec + AV1DEC_TL_N, 0);
    store64(dec + AV1DEC_TL_TW, 0);
    store64(dec + AV1DEC_TL_TH, 0);
    store64(dec + AV1DEC_TL_OW, 0);
    store64(dec + AV1DEC_OPSEL, 0);
    store64(dec + AV1DEC_OPIDC, 0);
    av1_decoder_frame_start(dec);   # nothing is rooted now but the grain output: every pooled frame is free
    return DR_OK;
}
# the decoder's memory, for a caller that bounds or reports it: the bytes its arena holds, and its pooled frames
fn av1_decoder_arena_bytes(dec): i64 { return dr_arena_capacity(load64(dec + AV1DEC_ARENA)); }
fn av1_decoder_pool_frames(dec): i64 { return dr_frame_pool_count(load64(dec + AV1DEC_POOL)); }
fn av1_decoder_dpb(dec): i64 { return load64(dec + AV1DEC_DPB); }
fn av1_decoder_refs(dec): i64 { return load64(dec + AV1DEC_REFS); }
fn av1_decoder_seq(dec): i64 { return load64(dec + AV1DEC_SEQ); }
fn av1_decoder_count(dec): i64 { return load64(dec + AV1DEC_COUNT); }
fn av1_decoder_shown_count(dec): i64 { return load64(dec + AV1DEC_NSHOWN); }
fn av1_decoder_error(dec): i64 { return load64(dec + AV1DEC_ERR); }
# Request operating point op (0..31) for scalable streams (6.4.1 note: "decoders may allow the operating point to be
# explicitly signaled by external means"). Like choose_operating_point itself it takes effect at the next sequence
# header, so set it before decoding; a stream without that many operating points gets operating point 0. Only the
# OBUs of the chosen point's layers are decoded (5.3.1 drop_obu), and each av1_decoder_decode call returns the last
# frame it showed: given a whole temporal unit, the highest spatial layer in the operating point (7.18.1's note).
# DR_ERR_BOUNDS for an op outside 0..31 (operating_points_cnt_minus_1 is f(5)).
fn av1_decoder_set_operating_point(dec, op): i64 {
    if ((op < 0) || (op > 31)) { return DR_ERR_BOUNDS; }
    store64(dec + AV1DEC_OPREQ, op);
    return DR_OK;
}
# The operating point chosen at the last sequence header, and its operating_point_idc (OperatingPointIdc).
fn av1_decoder_operating_point(dec): i64 { return load64(dec + AV1DEC_OPSEL); }
fn av1_decoder_operating_point_idc(dec): i64 { return load64(dec + AV1DEC_OPIDC); }
# the most recently decoded frame, shown or not (0 before the first) — what libaom's AV1_COPY_NEW_FRAME_IMAGE hands a
# large-scale-tile application as an anchor.
fn av1_decoder_last_decoded(dec): i64 { return load64(dec + AV1DEC_LAST); }

# latch a decoder failure: the error becomes sticky and the call returns 0.
fn av1_decoder_fail(dec, err, out_err): i64 {
    store64(dec + AV1DEC_ERR, err);
    store64(dec + AV1DEC_SHOWN, 0);
    store64(out_err, err);
    return 0;
}
# a frame finished decoding (or was shown from the DPB): count it, and record it as
# this call's output when it is shown. The OUTPUT is the output process's (7.18): with
# film_grain_params_present and the header's (possibly loaded) apply_grain, the film
# grain synthesis (7.18.3, src/av1_grain.cyr) runs on a COPY — the decoder's reused
# grain frame, valid until the next grain output — and the DPB keeps the clean frame.
# Returns DR_OK, or the synthesis's allocation error.
fn av1_decoder_emit(dec, seq, fh, frame, shown): i64 {
    store64(dec + AV1DEC_COUNT, load64(dec + AV1DEC_COUNT) + 1);
    store64(dec + AV1DEC_LAST, frame);
    if (shown == 1) {
        var outf = frame;
        if ((av1_seq_film_grain_present(seq) != 0) && (av1_fh_apply_grain(fh) != 0)) {
            var gc = load64(dec + AV1DEC_GRAIN);
            if (gc == 0) {
                dr_persist_begin();   # the grain context is the decoder's for its whole life
                gc = av1_grain_ctx_new();
                dr_persist_end();
                if (gc == 0) { return DR_ERR_OOM; }
                store64(dec + AV1DEC_GRAIN, gc);
            }
            var gerr = 0;
            outf = av1_grain_apply(gc, av1_fh_grain(fh), av1_seq_matrix_coefficients(seq), frame, &gerr);
            if (outf == 0) { return gerr; }
        }
        store64(dec + AV1DEC_SHOWN, outf);
        store64(dec + AV1DEC_NSHOWN, load64(dec + AV1DEC_NSHOWN) + 1);
    }
    return DR_OK;
}

# ================================================================
# av1_decoder_decode — walk the OBUs in buf[0..sz) against the decoder's
# persistent state, decoding every coded frame into the DPB and serving
# show_existing_frame from it. Returns the last frame SHOWN by this call, or 0
# (with *out_err DR_OK) when the call showed none — a sequence header alone, a
# hidden frame, or a frame whose tile groups have not all arrived yet.
#
#   SEQUENCE_HEADER -> the active sequence.
#   FRAME_HEADER    -> the active frame header. If show_existing_frame: load the
#                      shown frame from the DPB (7.21), run the ref update (7.20),
#                      and record it as output — no tile groups follow.
#   FRAME (type 6)  -> parse fh, split off the embedded tile group (5.10), decode,
#                      run the ref update, record output if show_frame.
#   TILE_GROUP      -> accumulate into a frame-decode context; on the last group,
#                      finish the frame, run the ref update, record output if shown.
#   TILE_LIST       -> large-scale tile mode only (av1_decoder_set_large_scale_tile): decode
#                      the listed tiles against the camera frame header and the
#                      application's AnchorFrames (src/av1_lst.cyr) and output the frame
#                      they build. Outside that mode it is DR_ERR_UNSUPPORTED.
# In large-scale tile mode a FRAME_HEADER / FRAME is the camera frame header: parsed and
# kept, nothing decoded or output. temporal_delimiter / metadata / padding /
# redundant_frame_header are skipped. Before any of that, an OBU outside the operating
# point (av1_decoder_set_operating_point) is dropped whole (5.3.1 drop_obu).
#
# The returned frame is the OUTPUT (7.18): when the shown frame carries film grain it is
# the decoder's reused grain frame, else the decoded frame itself. Either way it is valid
# until the NEXT call on this decoder (see MEMORY above) — consume it before then — and
# must not be modified.
#
# On any parse/decode fault: returns 0 with *out_err set, and the error is latched
# (see Av1Decoder). A null decoder or buffer, or a negative size, is DR_ERR_BOUNDS
# and latches nothing.
# ================================================================
fn av1_decoder_decode(dec, buf, sz, out_err): i64 {
    store64(out_err, DR_OK);
    if ((dec == 0) || (buf == 0) || (sz < 0)) { store64(out_err, DR_ERR_BOUNDS); return 0; }
    if (load64(dec + AV1DEC_ERR) != DR_OK) {
        store64(out_err, load64(dec + AV1DEC_ERR)); return 0;
    }
    # the decoder's memory scope for the length of the call (MEMORY above), restored on every return
    var prev_arena = dr_alloc_scope(load64(dec + AV1DEC_ARENA));
    var prev_pool = dr_frame_pool_use(load64(dec + AV1DEC_POOL));
    var f = av1_decoder_decode_in(dec, buf, sz, out_err);
    dr_frame_pool_use(prev_pool);
    dr_alloc_scope(prev_arena);
    return f;
}
fn av1_decoder_decode_in(dec, buf, sz, out_err): i64 {
    store64(dec + AV1DEC_SHOWN, 0);
    store64(dec + AV1DEC_NSHOWN, 0);
    # nothing pending: whatever the last call left in the arena is dead
    if ((load64(dec + AV1DEC_FH) == 0) && (load64(dec + AV1DEC_FDC) == 0)) {
        dr_arena_reset(load64(dec + AV1DEC_ARENA));
    }
    var dpb = load64(dec + AV1DEC_DPB);
    var refs = load64(dec + AV1DEC_REFS);
    var it = av1_obu_iter_reset(load64(dec + AV1DEC_IT), buf, sz);
    if (it == 0) { return av1_decoder_fail(dec, DR_ERR_BOUNDS, out_err); }
    var otype = 0;
    var ooff = 0;
    var osize = 0;
    var rc = av1_obu_next(it, &otype, &ooff, &osize);
    while (rc == DR_OK) {
        var seq = load64(dec + AV1DEC_SEQ);
        var fh = load64(dec + AV1DEC_FH);
        # the OBU header's fields, read NOW: its record is arena memory, and a frame start below rewinds the arena
        var xo = av1_obu_iter_obu(it);
        var oext = av1_obu_ext(xo);
        var otid = av1_obu_tid(xo);
        var osid = av1_obu_sid(xo);
        if (av1_obu_in_operating_point(load64(dec + AV1DEC_OPIDC), otype, oext, otid, osid) == 0) {
            otype = 0 - 1;   # drop_obu( ) (5.3.1): not in the operating point, so none of the branches below sees it
        }
        if (otype == AV1_OBU_SEQUENCE_HEADER) {
            var serr = 0;
            var nseq = av1_seq_parse(buf + ooff, osize, &serr);
            if (serr != DR_OK) { return av1_decoder_fail(dec, serr, out_err); }
            if (nseq == 0) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            # the decoder's own copy: the parse is arena memory, and the sequence outlives every frame
            nseq = av1_decoder_own_copy(dec, AV1DEC_SEQBUF, nseq, AV1_SEQ_SIZE);
            if (nseq == 0) { return av1_decoder_fail(dec, DR_ERR_OOM, out_err); }
            store64(dec + AV1DEC_SEQ, nseq);
            # choose_operating_point( ) and OperatingPointIdc (5.5.1), for this coded video sequence
            var op = av1_seq_choose_operating_point(nseq, load64(dec + AV1DEC_OPREQ));
            store64(dec + AV1DEC_OPSEL, op);
            store64(dec + AV1DEC_OPIDC, av1_seq_op_idc(nseq, op));
        }
        if ((load64(dec + AV1DEC_LST) != 0)
          && ((otype == AV1_OBU_FRAME_HEADER) || (otype == AV1_OBU_FRAME))) {
            # large-scale tile mode (7.3): a frame header is the CAMERA frame header the tile lists decode
            # against — no tile group of its own is decoded (an OBU_FRAME's tile data, if any, is skipped, as
            # libaom does: its lightfield files carry a header-only OBU_FRAME), no reference update, no output.
            if (seq == 0) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            var cerr = 0;
            var cfh = av1_frame_parse_uncompressed_header(seq, refs, otid, osid, buf + ooff, osize, &cerr);
            if (cerr != DR_OK) { return av1_decoder_fail(dec, cerr, out_err); }
            if (cfh == 0) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            if (av1_decoder_over_limit(dec, cfh) != 0) { return av1_decoder_fail(dec, DR_ERR_OVERSIZE, out_err); }
            # the decoder's own copy: every tile list after it is a frame start, which rewinds the arena
            cfh = av1_decoder_own_copy(dec, AV1DEC_CAMBUF, cfh, AV1FH_SIZE);
            if (cfh == 0) { return av1_decoder_fail(dec, DR_ERR_OOM, out_err); }
            store64(dec + AV1DEC_CAMFH, cfh);
            otype = 0 - 1;   # handled: none of the branches below may see it
        }
        if (otype == AV1_OBU_TILE_LIST) {
            # a tile list only means something to the large-scale tile process, which needs AnchorFrames supplied
            # by the application: outside that mode it is refused, never silently skipped.
            if (load64(dec + AV1DEC_LST) == 0) { return av1_decoder_fail(dec, DR_ERR_UNSUPPORTED, out_err); }
            av1_decoder_frame_start(dec);
            var lerr2 = 0;
            var lout = av1_decode_tile_list(dec, buf + ooff, osize, &lerr2);
            if (lout == 0) {
                if (lerr2 == DR_OK) { lerr2 = DR_ERR_BAD_HEADER; }
                return av1_decoder_fail(dec, lerr2, out_err);
            }
            store64(dec + AV1DEC_COUNT, load64(dec + AV1DEC_COUNT) + 1);
            store64(dec + AV1DEC_SHOWN, lout);
            store64(dec + AV1DEC_NSHOWN, load64(dec + AV1DEC_NSHOWN) + 1);
        }
        if (otype == AV1_OBU_FRAME_HEADER) {
            if (seq == 0) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            av1_decoder_frame_start(dec);
            var ferr = 0;
            var nfh = av1_frame_parse_uncompressed_header(seq, refs, otid, osid, buf + ooff, osize, &ferr);
            if (ferr != DR_OK) { return av1_decoder_fail(dec, ferr, out_err); }
            if (nfh == 0) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            if (av1_decoder_over_limit(dec, nfh) != 0) { return av1_decoder_fail(dec, DR_ERR_OVERSIZE, out_err); }
            store64(dec + AV1DEC_FH, nfh);
            store64(dec + AV1DEC_FDC, 0);   # a new frame begins; any prior context is retired
            if (av1_fh_show_existing_frame(nfh) == 1) {
                # 7.21 load + 7.20 update + output; no tile groups follow.
                var lerr = 0;
                var shown = av1_dpb_load(dpb, nfh, &lerr);
                if (lerr != DR_OK) { return av1_decoder_fail(dec, lerr, out_err); }
                var uerr = av1_dpb_update(dpb, refs, seq, nfh, shown);
                if (uerr != DR_OK) { return av1_decoder_fail(dec, uerr, out_err); }
                var eerr = av1_decoder_emit(dec, seq, nfh, shown, 1);
                if (eerr != DR_OK) { return av1_decoder_fail(dec, eerr, out_err); }
                store64(dec + AV1DEC_FH, 0);
            }
        }
        if (otype == AV1_OBU_FRAME) {
            if (seq == 0) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            av1_decoder_frame_start(dec);
            var frr = 0;
            var ffh = av1_frame_parse_uncompressed_header(seq, refs, otid, osid, buf + ooff, osize, &frr);
            if (frr != DR_OK) { return av1_decoder_fail(dec, frr, out_err); }
            if (ffh == 0) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            if (av1_decoder_over_limit(dec, ffh) != 0) { return av1_decoder_fail(dec, DR_ERR_OVERSIZE, out_err); }
            var hbytes = (av1_fh_bits_consumed(ffh) + 7) >> 3;
            if (hbytes > osize) { return av1_decoder_fail(dec, DR_ERR_TRUNCATED, out_err); }
            var derr = 0;
            var frame = av1_decode_frame_ref(seq, ffh, dpb, refs, buf + ooff + hbytes,
              osize - hbytes, &derr);
            if (frame == 0) {   # av1_decode_frame wrote the precise cause
                if (derr == DR_OK) { derr = DR_ERR_BAD_HEADER; }
                return av1_decoder_fail(dec, derr, out_err);
            }
            var uerr2 = av1_dpb_update(dpb, refs, seq, ffh, frame);
            if (uerr2 != DR_OK) { return av1_decoder_fail(dec, uerr2, out_err); }
            var eerr2 = av1_decoder_emit(dec, seq, ffh, frame, av1_fh_show_frame(ffh));
            if (eerr2 != DR_OK) { return av1_decoder_fail(dec, eerr2, out_err); }
            store64(dec + AV1DEC_FH, 0);
            store64(dec + AV1DEC_FDC, 0);
        }
        if (otype == AV1_OBU_TILE_GROUP) {
            if ((seq == 0) || (fh == 0)) { return av1_decoder_fail(dec, DR_ERR_BAD_HEADER, out_err); }
            var fdc = load64(dec + AV1DEC_FDC);
            if (fdc == 0) {
                var nerr = 0;
                fdc = av1_frame_dec_new(seq, fh, &nerr);
                if (fdc == 0) {
                    if (nerr == DR_OK) { nerr = DR_ERR_OOM; }
                    return av1_decoder_fail(dec, nerr, out_err);
                }
                av1_frame_dec_set_inter(fdc, dpb, refs);
                store64(dec + AV1DEC_FDC, fdc);
            }
            var gerr = 0;
            var gdone = av1_frame_dec_group(fdc, buf + ooff, osize, &gerr);
            if (gdone < 0) {
                if (gerr == DR_OK) { gerr = DR_ERR_BAD_HEADER; }
                return av1_decoder_fail(dec, gerr, out_err);
            }
            if (gdone == 1) {
                var gfin_err = 0;
                var gframe = av1_frame_dec_finish(fdc, &gfin_err);
                if (gfin_err != DR_OK) { return av1_decoder_fail(dec, gfin_err, out_err); }
                var uerr3 = av1_dpb_update(dpb, refs, seq, fh, gframe);
                if (uerr3 != DR_OK) { return av1_decoder_fail(dec, uerr3, out_err); }
                var eerr3 = av1_decoder_emit(dec, seq, fh, gframe, av1_fh_show_frame(fh));
                if (eerr3 != DR_OK) { return av1_decoder_fail(dec, eerr3, out_err); }
                store64(dec + AV1DEC_FDC, 0);
                store64(dec + AV1DEC_FH, 0);
            }
        }
        rc = av1_obu_next(it, &otype, &ooff, &osize);
    }
    if (rc != AV1_OBU_END) { return av1_decoder_fail(dec, rc, out_err); }
    return load64(dec + AV1DEC_SHOWN);
}

# ================================================================
# av1_decode_stream — the WHOLE-BUFFER form of the streaming decoder: walk
# buf[0..sz), decode EVERY coded frame into `dpb`, serve show_existing_frame from
# it, and return the last OUTPUT (shown) frame (writes *out_err; *out_count, if
# non-null, gets the number of frames processed). This is av1_decode_obus's
# multi-frame superset — where that returns the first frame and stops, this keeps
# walking, running the reference frame update after each frame so a later frame
# can reference an earlier one through the DPB. It is one av1_decoder_decode call
# over a fresh decoder (0.8.3); the walk itself lives there.
#
# Returns 0 with *out_err on any parse/decode fault. A stream with no coded frame
# at all -> 0 + DR_ERR_BAD_HEADER (as av1_decode_obus). A stream whose frames are
# all non-shown -> 0 + DR_OK (the frames are in the DPB; none were output).
# ================================================================
fn av1_decode_stream(dpb, buf, sz, out_count, out_err): i64 {
    store64(out_err, DR_OK);
    if (out_count != 0) { store64(out_count, 0); }
    if ((dpb == 0) || (buf == 0) || (sz < 0)) { store64(out_err, DR_ERR_BOUNDS); return 0; }
    var dec = av1_decoder_new(dpb);
    if (dec == 0) { store64(out_err, DR_ERR_OOM); return 0; }
    var output = av1_decoder_decode(dec, buf, sz, out_err);
    if (load64(out_err) != DR_OK) { return 0; }
    var count = av1_decoder_count(dec);
    if (count == 0) { store64(out_err, DR_ERR_BAD_HEADER); return 0; }
    if (out_count != 0) { store64(out_count, count); }
    return output;
}
