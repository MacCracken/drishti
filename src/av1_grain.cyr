# src/av1_grain.cyr — AV1 film grain synthesis (spec 7.18.3), the last step of the output process (7.18.1).
#
# When film_grain_params_present and apply_grain, the frame that is OUTPUT gets synthetic grain: white noise from
# Gaussian_Sequence driven by a 16-bit LFSR (7.18.3.2), shaped by an auto-regressive filter into 82x73 luma and
# 44x38 / 82x73 chroma templates (7.18.3.3), scaled by a piecewise-linear function of the sample value (7.18.3.4)
# and laid over the picture in 32x32 blocks at pseudo-random template offsets, optionally blended across block
# edges (7.18.3.5). The REFERENCE frames stay grain-free: the noise goes onto a COPY (the decoder's reused output
# frame), never into the DPB.
#
# The add-noise process is computed stripe by stripe — each 32-luma-row stripe's noiseStripe is built, blended
# vertically with the previous stripe's last rows, and applied at once (chroma rows first: they read the luma
# samples BEFORE that stripe's luma noise lands, as the spec's chroma-then-luma order requires) — instead of the
# spec's full-frame noiseStripe / noiseImage arrays (the spec's note allows it). The arithmetic is the spec's.
#
# Known answers: scripts/refs/grain_ref.py, a spec-literal port (full arrays, as written) that was cross-checked
# against aomdec on every frame of 22 libaom streams — all 16 --film-grain-test parameter sets, 8/10/12-bit,
# 4:2:0 / 4:2:2 / 4:4:4 / monochrome, hidden frames shown through show_existing_frame and an update_grain 0 reload.
# The Gaussian_Sequence fill lines are generated by `scripts/refs/grain_ref.py --emit` from the spec markdown.
#
# FLAT module (no includes) — wiring in src/main.cyr, after av1_superres.cyr. Family av1_ (av1_grain_*).

var Av1_GrainGauss = 0;   # Gaussian_Sequence[2048], i64 slots (2048 * 8 bytes), lazily decoded

# Decode 3-hex-digit groups (v + 2048) from the NUL-terminated string s into i64 slots t[idx..]. Returns the count.
fn av1_grain_hex(t, idx, s): i64 {
    var k = 0;
    while (load8(s + (k * 3)) != 0) {
        var v = (av1_qm_hexval(load8(s + (k * 3))) * 256) + (av1_qm_hexval(load8(s + (k * 3) + 1)) * 16)
        + av1_qm_hexval(load8(s + (k * 3) + 2));
        store64(t + ((idx + k) * 8), v - 2048);
        k = k + 1;
    }
    return k;
}

# Round2 (spec 4.7) on a signed value: the spec's >> is arithmetic, so >>> here; n == 0 returns x.
fn av1_grain_round2(x, n): i64 {
    if (n == 0) { return x; }
    return (x + (1 << (n - 1))) >>> n;
}

# ================================================================
# Av1GrainCtx — one decoder's synthesis scratch, reused from output frame to output frame: the LFSR, the three
# grain templates, the scaling tables, two noise stripes per plane (current + previous), and the output frame.
# ================================================================
enum Av1GrainCtxOff {
    AV1GC_RNG     = 0;     # RandomRegister (16 bits)
    AV1GC_LUMA    = 8;     # LumaGrain[73][82], i64, stride 82
    AV1GC_CB      = 16;    # CbGrain[chromaH][chromaW], i64, stride 82
    AV1GC_CR      = 24;    # CrGrain, as CbGrain
    AV1GC_LUT     = 32;    # ScalingLut[3][256], i64
    AV1GC_STRIPE  = 40;    # [2 buffers][3 planes] i64 pointers -> 88: rows x AV1GC_SW i64 each
    AV1GC_SW      = 88;    # stripe width capacity, in samples (0 = no stripes yet)
    AV1GC_OUT     = 96;    # the reused output DrFrame (0 = none yet)
    AV1GC_GMIN    = 104;   # GrainMin
    AV1GC_GMAX    = 112;   # GrainMax
    AV1GC_SIZE    = 120;
}

fn av1_grain_ctx_new(): i64 {
    var gc = dr_alloc(AV1GC_SIZE);   # AV1GC_SIZE bytes
    if (gc == 0) { return 0; }
    memset(gc, 0, AV1GC_SIZE);
    var l = dr_alloc(73 * 82 * 8);   # 73 * 82 i64
    var cb = dr_alloc(73 * 82 * 8);
    var cr = dr_alloc(73 * 82 * 8);
    var lut = dr_alloc(3 * 256 * 8);   # 3 * 256 i64
    if ((l == 0) || (cb == 0) || (cr == 0) || (lut == 0)) { return 0; }
    store64(gc + AV1GC_LUMA, l);
    store64(gc + AV1GC_CB, cb);
    store64(gc + AV1GC_CR, cr);
    store64(gc + AV1GC_LUT, lut);
    return gc;
}

# get_random_number( bits ) (7.18.3.2).
fn av1_grain_rand(gc, bits): i64 {
    var r = load64(gc + AV1GC_RNG);
    var bit = ((r >> 0) ^ (r >> 1) ^ (r >> 3) ^ (r >> 12)) & 1;
    r = (r >> 1) | (bit << 15);
    store64(gc + AV1GC_RNG, r);
    return (r >> (16 - bits)) & ((1 << bits) - 1);
}

# The generate grain process (7.18.3.3) for the parameter block g. Fills LumaGrain, and CbGrain / CrGrain unless
# mono. RandomRegister must hold grain_seed on entry (7.18.3.1 step 1).
fn av1_grain_generate(gc, g, bit_depth, mono, subx, suby): i64 {
    var gs = av1_grain_gauss();
    var luma = load64(gc + AV1GC_LUMA);
    var gmin = load64(gc + AV1GC_GMIN);
    var gmax = load64(gc + AV1GC_GMAX);
    var shift = (12 - bit_depth) + load64(g + AV1FG_SCALE_SHIFT);
    var num_y = load64(g + AV1FG_NUM_Y);
    var y = 0;
    while (y < 73) {
        var x = 0;
        while (x < 82) {
            var v = 0;
            if (num_y > 0) { v = load64(gs + (av1_grain_rand(gc, 11) * 8)); }
            store64(luma + (((y * 82) + x) * 8), av1_grain_round2(v, shift));
            x = x + 1;
        }
        y = y + 1;
    }
    var lag = load64(g + AV1FG_AR_LAG);
    var ar_shift = load64(g + AV1FG_AR_SHIFT_M6) + 6;
    y = 3;
    while (y < 73) {
        var x2 = 3;
        while (x2 < (82 - 3)) {
            var s = 0;
            var pos = 0;
            var dr = 0 - lag;
            var done = 0;
            while ((dr <= 0) && (done == 0)) {
                var dc = 0 - lag;
                while ((dc <= lag) && (done == 0)) {
                    if ((dr == 0) && (dc == 0)) {
                        done = 1;
                    } else {
                        var c = load64(g + AV1FG_AR_Y + (pos * 8)) - 128;
                        s = s + (load64(luma + ((((y + dr) * 82) + x2 + dc) * 8)) * c);
                        pos = pos + 1;
                        dc = dc + 1;
                    }
                }
                dr = dr + 1;
            }
            var at = luma + (((y * 82) + x2) * 8);
            store64(at, av1_clip3(gmin, gmax, load64(at) + av1_grain_round2(s, ar_shift)));
            x2 = x2 + 1;
        }
        y = y + 1;
    }
    if (mono != 0) { return 0; }
    var cw = 82;
    if (subx != 0) { cw = 44; }
    var ch = 73;
    if (suby != 0) { ch = 38; }
    var cb = load64(gc + AV1GC_CB);
    var cr = load64(gc + AV1GC_CR);
    var csfl = load64(g + AV1FG_CSFL);
    var seed = load64(g + AV1FG_SEED);
    var pl = 1;
    while (pl <= 2) {
        var arr = cb;
        var npts = load64(g + AV1FG_NUM_CB);
        store64(gc + AV1GC_RNG, seed ^ 46372);   # grain_seed ^ 0xb524
        if (pl == 2) {
            arr = cr;
            npts = load64(g + AV1FG_NUM_CR);
            store64(gc + AV1GC_RNG, seed ^ 18904);   # grain_seed ^ 0x49d8
        }
        var cy = 0;
        while (cy < ch) {
            var cx = 0;
            while (cx < cw) {
                var cv = 0;
                if ((npts > 0) || (csfl != 0)) { cv = load64(gs + (av1_grain_rand(gc, 11) * 8)); }
                store64(arr + (((cy * 82) + cx) * 8), av1_grain_round2(cv, shift));
                cx = cx + 1;
            }
            cy = cy + 1;
        }
        pl = pl + 1;
    }
    y = 3;
    while (y < ch) {
        var x3 = 3;
        while (x3 < (cw - 3)) {
            var s0 = 0;
            var s1 = 0;
            var p2 = 0;
            var dr2 = 0 - lag;
            var done2 = 0;
            while ((dr2 <= 0) && (done2 == 0)) {
                var dc2 = 0 - lag;
                while ((dc2 <= lag) && (done2 == 0)) {
                    var c0 = load64(g + AV1FG_AR_CB + (p2 * 8)) - 128;
                    var c1 = load64(g + AV1FG_AR_CR + (p2 * 8)) - 128;
                    if ((dr2 == 0) && (dc2 == 0)) {
                        if (num_y > 0) {
                            var lsum = 0;
                            var lx = ((x3 - 3) << subx) + 3;
                            var ly = ((y - 3) << suby) + 3;
                            var i = 0;
                            while (i <= suby) {
                                var j = 0;
                                while (j <= subx) {
                                    lsum = lsum + load64(luma + ((((ly + i) * 82) + lx + j) * 8));
                                    j = j + 1;
                                }
                                i = i + 1;
                            }
                            lsum = av1_grain_round2(lsum, subx + suby);
                            s0 = s0 + (lsum * c0);
                            s1 = s1 + (lsum * c1);
                        }
                        done2 = 1;
                    } else {
                        s0 = s0 + (load64(cb + ((((y + dr2) * 82) + x3 + dc2) * 8)) * c0);
                        s1 = s1 + (load64(cr + ((((y + dr2) * 82) + x3 + dc2) * 8)) * c1);
                        p2 = p2 + 1;
                        dc2 = dc2 + 1;
                    }
                }
                dr2 = dr2 + 1;
            }
            var at0 = cb + (((y * 82) + x3) * 8);
            var at1 = cr + (((y * 82) + x3) * 8);
            store64(at0, av1_clip3(gmin, gmax, load64(at0) + av1_grain_round2(s0, ar_shift)));
            store64(at1, av1_clip3(gmin, gmax, load64(at1) + av1_grain_round2(s1, ar_shift)));
            x3 = x3 + 1;
        }
        y = y + 1;
    }
    return 0;
}

# get_x / get_y (7.18.3.4): point i of plane's scaling function (chroma_scaling_from_luma reads luma's).
fn av1_grain_point(g, plane, i, want_y): i64 {
    var vo = AV1FG_Y_VALUE;
    var so = AV1FG_Y_SCALING;
    if ((plane == 1) && (load64(g + AV1FG_CSFL) == 0)) { vo = AV1FG_CB_VALUE; so = AV1FG_CB_SCALING; }
    if ((plane == 2) && (load64(g + AV1FG_CSFL) == 0)) { vo = AV1FG_CR_VALUE; so = AV1FG_CR_SCALING; }
    if (want_y != 0) { return load64(g + so + (i * 8)); }
    return load64(g + vo + (i * 8));
}

# The scaling lookup initialisation process (7.18.3.4): ScalingLut[ plane ][ 0..255 ] for plane < num_planes. The
# parser guarantees strictly increasing point values (so deltaX > 0 and every index stays in 0..255).
fn av1_grain_scaling_init(gc, g, num_planes): i64 {
    var lut = load64(gc + AV1GC_LUT);
    memset(lut, 0, 3 * 256 * 8);
    var plane = 0;
    while (plane < num_planes) {
        var n = load64(g + AV1FG_NUM_Y);
        if ((plane == 1) && (load64(g + AV1FG_CSFL) == 0)) { n = load64(g + AV1FG_NUM_CB); }
        if ((plane == 2) && (load64(g + AV1FG_CSFL) == 0)) { n = load64(g + AV1FG_NUM_CR); }
        var t = lut + (plane * 256 * 8);
        if (n > 0) {
            var x = 0;
            while (x < av1_grain_point(g, plane, 0, 0)) {
                store64(t + (x * 8), av1_grain_point(g, plane, 0, 1));
                x = x + 1;
            }
            var i = 0;
            while (i < (n - 1)) {
                var dy = av1_grain_point(g, plane, i + 1, 1) - av1_grain_point(g, plane, i, 1);
                var dx = av1_grain_point(g, plane, i + 1, 0) - av1_grain_point(g, plane, i, 0);
                var delta = dy * ((65536 + (dx >> 1)) / dx);
                var k = 0;
                while (k < dx) {
                    store64(t + ((av1_grain_point(g, plane, i, 0) + k) * 8),
                      av1_grain_point(g, plane, i, 1) + (((k * delta) + 32768) >>> 16));
                    k = k + 1;
                }
                i = i + 1;
            }
            x = av1_grain_point(g, plane, n - 1, 0);
            while (x < 256) {
                store64(t + (x * 8), av1_grain_point(g, plane, n - 1, 1));
                x = x + 1;
            }
        }
        plane = plane + 1;
    }
    return 0;
}

# scale_lut( plane, index ) (7.18.3.5): the piecewise-linear lookup, interpolated above 8 bits.
fn av1_grain_scale_lut(gc, plane, index, bit_depth): i64 {
    var t = load64(gc + AV1GC_LUT) + (plane * 256 * 8);
    var shift = bit_depth - 8;
    var x = index >> shift;
    var rem = index - (x << shift);
    if ((bit_depth == 8) || (x == 255)) { return load64(t + (x * 8)); }
    var start = load64(t + (x * 8));
    var end = load64(t + ((x + 1) * 8));
    return start + av1_grain_round2((end - start) * rem, shift);
}

# One noiseStripe (7.18.3.5, the first loop) for stripe lumaNum into the stripe buffers bufs[plane] (rows x sw).
fn av1_grain_stripe(gc, g, bufs, sw, luma_num, w, num_planes, subx, suby): i64 {
    var seed = load64(g + AV1FG_SEED);
    var r = seed;
    r = r ^ ((((luma_num * 37) + 178) & 255) << 8);
    r = r ^ (((luma_num * 173) + 105) & 255);
    store64(gc + AV1GC_RNG, r);
    var overlap = load64(g + AV1FG_OVERLAP);
    var gmin = load64(gc + AV1GC_GMIN);
    var gmax = load64(gc + AV1GC_GMAX);
    var x = 0;
    while (x < ((w + 1) / 2)) {
        var rnd = av1_grain_rand(gc, 8);
        var offx = rnd >> 4;
        var offy = rnd & 15;
        var plane = 0;
        while (plane < num_planes) {
            var psx = 0;
            var psy = 0;
            var tmpl = load64(gc + AV1GC_LUMA);
            if (plane > 0) {
                psx = subx;
                psy = suby;
                tmpl = load64(gc + AV1GC_CB);
                if (plane == 2) { tmpl = load64(gc + AV1GC_CR); }
            }
            var pox = 9 + (offx * 2);
            if (psx != 0) { pox = 6 + offx; }
            var poy = 9 + (offy * 2);
            if (psy != 0) { poy = 6 + offy; }
            var buf = load64(bufs + (plane * 8));
            var i = 0;
            while (i < (34 >> psy)) {
                var j = 0;
                while (j < (34 >> psx)) {
                    var gv = load64(tmpl + ((((poy + i) * 82) + pox + j) * 8));
                    if (psx == 0) {
                        var col = (x * 2) + j;
                        if ((j < 2) && (overlap != 0) && (x > 0)) {
                            var old = load64(buf + (((i * sw) + col) * 8));
                            if (j == 0) { gv = (old * 27) + (gv * 17); } else { gv = (old * 17) + (gv * 27); }
                            gv = av1_clip3(gmin, gmax, av1_grain_round2(gv, 5));
                        }
                        store64(buf + (((i * sw) + col) * 8), gv);
                    } else {
                        var col2 = x + j;
                        if ((j == 0) && (overlap != 0) && (x > 0)) {
                            var old2 = load64(buf + (((i * sw) + col2) * 8));
                            gv = av1_clip3(gmin, gmax, av1_grain_round2((old2 * 23) + (gv * 22), 5));
                        }
                        store64(buf + (((i * sw) + col2) * 8), gv);
                    }
                    j = j + 1;
                }
                i = i + 1;
            }
            plane = plane + 1;
        }
        x = x + 16;
    }
    return 0;
}

# noiseImage[ plane ][ y ][ x ] (7.18.3.5, the second loop) for a row y of stripe luma_num: the current stripe's
# sample, blended with the previous stripe's last rows across the stripe edge when overlap_flag.
fn av1_grain_noise(gc, g, cur, prev, sw, plane_suby, luma_num, y, x): i64 {
    var i = y - (luma_num << (5 - plane_suby));
    var gv = load64(cur + (((i * sw) + x) * 8));
    if ((luma_num > 0) && (load64(g + AV1FG_OVERLAP) != 0)) {
        if (plane_suby == 0) {
            if (i < 2) {
                var old = load64(prev + ((((i + 32) * sw) + x) * 8));
                if (i == 0) { gv = (old * 27) + (gv * 17); } else { gv = (old * 17) + (gv * 27); }
                gv = av1_clip3(load64(gc + AV1GC_GMIN), load64(gc + AV1GC_GMAX), av1_grain_round2(gv, 5));
            }
        } else {
            if (i < 1) {
                var old2 = load64(prev + ((((i + 16) * sw) + x) * 8));
                gv = av1_clip3(load64(gc + AV1GC_GMIN), load64(gc + AV1GC_GMAX),
                  av1_grain_round2((old2 * 23) + (gv * 22), 5));
            }
        }
    }
    return gv;
}

# The film grain synthesis process (7.18.3) on a COPY of src (the decoded / shown frame, never modified): returns
# the output frame — the decoder's reused grain frame, valid until the next synthesis — or 0 with *out_err set
# (DR_ERR_OOM, or a DrFrame allocation error). mc is the sequence's matrix_coefficients. When g does not apply grain
# (apply_grain 0) src itself is returned.
fn av1_grain_apply(gc, g, mc, src, out_err): i64 {
    store64(out_err, DR_OK);
    if (load64(g + AV1FG_APPLY) == 0) { return src; }
    if (av1_grain_gauss() == 0) { store64(out_err, DR_ERR_OOM); return 0; }
    var w = dr_frame_width(src);
    var h = dr_frame_height(src);
    var np = dr_frame_num_planes(src);
    var subx = dr_frame_subx(src);
    var suby = dr_frame_suby(src);
    var bd = dr_frame_bit_depth(src);
    # the reused output frame, re-made when the format changes
    var out = load64(gc + AV1GC_OUT);
    if ((out == 0) || (dr_frame_width(out) != w) || (dr_frame_height(out) != h) || (dr_frame_num_planes(out) != np)
      || (dr_frame_subx(out) != subx) || (dr_frame_suby(out) != suby) || (dr_frame_bit_depth(out) != bd)) {
        var ferr = 0;
        out = dr_frame_new(w, h, np, subx, suby, bd, 0, &ferr);
        if (out == 0) { store64(out_err, ferr); return 0; }
        store64(gc + AV1GC_OUT, out);
    }
    # the stripe buffers: cols up to 2 * (last block x) + 33 <= w + 32 are written; rows 34 (luma)
    var sw = w + 64;
    if (load64(gc + AV1GC_SW) < sw) {
        var b = 0;
        while (b < 6) {
            var sb = dr_alloc(34 * sw * 8);   # 34 rows * sw i64
            if (sb == 0) { store64(out_err, DR_ERR_OOM); return 0; }
            store64(gc + AV1GC_STRIPE + (b * 8), sb);
            b = b + 1;
        }
        store64(gc + AV1GC_SW, sw);
    }
    sw = load64(gc + AV1GC_SW);
    var cw = (w + subx) >> subx;
    var ch = (h + suby) >> suby;
    var p = 0;
    while (p < np) {   # OutY / OutU / OutV (7.18.2): the visible samples
        var pw = w;
        var ph = h;
        if (p > 0) { pw = cw; ph = ch; }
        var yy = 0;
        while (yy < ph) {
            var xx = 0;
            while (xx < pw) { dr_frame_set(out, p, xx, yy, dr_frame_get(src, p, xx, yy)); xx = xx + 1; }
            yy = yy + 1;
        }
        p = p + 1;
    }
    # 7.18.3.1 steps 1-6
    store64(gc + AV1GC_RNG, load64(g + AV1FG_SEED));
    var center = 128 << (bd - 8);
    store64(gc + AV1GC_GMIN, 0 - center);
    store64(gc + AV1GC_GMAX, ((256 << (bd - 8)) - 1) - center);
    var mono = 0;
    if (np == 1) { mono = 1; }
    av1_grain_generate(gc, g, bd, mono, subx, suby);
    av1_grain_scaling_init(gc, g, np);
    # 7.18.3.5: the blend limits
    var minv = 0;
    var maxl = (256 << (bd - 8)) - 1;
    var maxc = maxl;
    if (load64(g + AV1FG_CLIP_RR) != 0) {
        minv = 16 << (bd - 8);
        maxl = 235 << (bd - 8);
        maxc = 240 << (bd - 8);
        if (mc == 0) { maxc = maxl; }   # MC_IDENTITY
    }
    var sshift = load64(g + AV1FG_SCALING_M8) + 8;
    var num_y = load64(g + AV1FG_NUM_Y);
    var num_cb = load64(g + AV1FG_NUM_CB);
    var num_cr = load64(g + AV1FG_NUM_CR);
    var csfl = load64(g + AV1FG_CSFL);
    var cur = gc + AV1GC_STRIPE;          # [3] pointers
    var prev = gc + AV1GC_STRIPE + 24;
    var luma_num = 0;
    while ((luma_num * 16) < ((h + 1) / 2)) {
        var t = cur;
        cur = prev;
        prev = t;
        av1_grain_stripe(gc, g, cur, sw, luma_num, w, np, subx, suby);
        # chroma rows of this stripe first: they read OutY before this stripe's luma noise (spec order)
        if (np > 1) {
            var cy = luma_num << (5 - suby);
            var cend = av1_min((luma_num + 1) << (5 - suby), ch);
            while (cy < cend) {
                var cx = 0;
                while (cx < cw) {
                    var lx = cx << subx;
                    var ly = cy << suby;
                    var avg = dr_frame_get(out, 0, lx, ly);
                    if (subx != 0) {
                        avg = av1_grain_round2(avg + dr_frame_get(out, 0, av1_min(lx + 1, w - 1), ly), 1);
                    }
                    var pl = 1;
                    while (pl <= 2) {
                        var npts = num_cb;
                        var mult = load64(g + AV1FG_CB_MULT);
                        var lmult = load64(g + AV1FG_CB_LUMA_MULT);
                        var off = load64(g + AV1FG_CB_OFFSET);
                        if (pl == 2) {
                            npts = num_cr;
                            mult = load64(g + AV1FG_CR_MULT);
                            lmult = load64(g + AV1FG_CR_LUMA_MULT);
                            off = load64(g + AV1FG_CR_OFFSET);
                        }
                        if ((npts > 0) || (csfl != 0)) {
                            var orig = dr_frame_get(out, pl, cx, cy);
                            var merged = avg;
                            if (csfl == 0) {
                                var comb = (avg * (lmult - 128)) + (orig * (mult - 128));
                                merged = dr_clip1((comb >>> 6) + ((off - 256) << (bd - 8)), bd);
                            }
                            var nz = av1_grain_noise(gc, g, load64(cur + (pl * 8)), load64(prev + (pl * 8)), sw, suby,
                              luma_num, cy, cx);
                            nz = av1_grain_round2(av1_grain_scale_lut(gc, pl, merged, bd) * nz, sshift);
                            dr_frame_set(out, pl, cx, cy, av1_clip3(minv, maxc, orig + nz));
                        }
                        pl = pl + 1;
                    }
                    cx = cx + 1;
                }
                cy = cy + 1;
            }
        }
        if (num_y > 0) {
            var y = luma_num << 5;
            var yend = av1_min((luma_num + 1) << 5, h);
            while (y < yend) {
                var x = 0;
                while (x < w) {
                    var o = dr_frame_get(out, 0, x, y);
                    var n0 = av1_grain_noise(gc, g, load64(cur), load64(prev), sw, 0, luma_num, y, x);
                    n0 = av1_grain_round2(av1_grain_scale_lut(gc, 0, o, bd) * n0, sshift);
                    dr_frame_set(out, 0, x, y, av1_clip3(minv, maxl, o + n0));
                    x = x + 1;
                }
                y = y + 1;
            }
        }
        luma_num = luma_num + 1;
    }
    return out;
}

