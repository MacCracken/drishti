# @public — drishti AV1: the KEYFRAME ENCODER (0.8.6; intra mode decision 0.8.7) — a picture in, a temporal unit out.
#
# One KEY_FRAME in one tile, at 64x64 or 128x128 superblocks, every superblock split down to one block size (and SPLIT
# wherever a larger block would cross the frame edge), the largest transform the block allows (DCT_DCT for luma; the
# 4x4 WHT when lossless), and every transform block's levels from the quantizer (src/av1_fquant.cyr) applied to the
# forward transform (src/av1_ftx.cyr) of the source minus the prediction, at the frame's base_q_idx (0 = lossless). A
# block whose levels are all 0 is coded skip. The headers are the writers' (src/av1_hdrw.cyr): av1_seq_init /
# av1_fh_init_key, no loop filter, CDEF or restoration.
#
# THE MODES are DC_PRED in every plane (decide 0: the 0.8.6 encoder, byte for byte), or decided by rate and distortion
# (src/av1_rd.cyr) block by block (0.8.7): AV1ENC_DECIDE_YMODE picks the luma mode — the 13 intra modes, the five
# filter intra modes (enable_filter_intra is then set in the sequence header) and the angle deltas of the two best
# directional modes — and AV1ENC_DECIDE_UVMODE the chroma mode: the 13 modes, their angle deltas likewise, and
# chroma-from-luma with an alpha searched per plane. Each candidate is a TRIAL: the decoder's own residual pass over the
# planes it changes (prediction, levels, reconstruction), its rate from the candidate's mode info, tx size and coeffs( )
# written against the symbol coder's estimator (under the CDFs as the block finds them; nothing coded, nothing adapted),
# its distortion the SSE against the source, and its cost libaom's RDCOST at libaom's key-frame multiplier. A trial
# leaves the coefficient contexts as it found them and the BlockDecoded cells it marked are cleared before the next, so
# every trial, and the final pass after them, starts from the state the decoder will be in at that block.
#
# THE RECONSTRUCTION IS THE DECODER'S OWN. The encoder takes its frame and its tile from the decoder's setup
# (av1_frame_dec_new: the same allocation; av1_frame_tile_setup: the same tile), and runs each block's residual through
# the decoder's driver (av1_residual -> av1_transform_block) with AV1TILE_EKEY set, so that av1_transform_block takes
# each transform block's levels from av1_enc_tx_levels below — the source quantized against the prediction it has just
# made — instead of reading coeffs( ). Prediction, dequantization, the inverse transform, BlockDecoded and the loop
# filter transform sizes are then the decoder's code on the decoder's data, and the frame is finished by the decoder's
# av1_frame_dec_finish. So the reconstruction returned is the picture a conforming decoder outputs; make conformance
# holds that against aomdec and dav1d.
#
# Each block is coded in two passes once its modes are decided. The residual pass predicts, quantizes and reconstructs
# every transform block in decode order, recording each one's levels and coefficient-context position (Av1EncRec). The
# symbol pass then writes the mode info (with the skip the levels decided), the tx size, and each recorded block's
# coeffs( ) in that order — the order the decoder reads them. The first pass writes no symbol, the second no sample.
#
# FLAT module (no includes) — wiring in src/main.cyr, last of the AV1 modules: it calls the tile, partition, residual,
# mode info, coefficient, transform, quantizer, header writer, rate and distortion, and decoder setup code of every
# module before it.
#
# 128x128 superblocks change the superblock loop, the partition tree's root (its W128 CDF and 8-symbol alphabet), the
# clear_cdef of four 64x64 units, the BlockDecoded mask and the 64x64 chunking of a 128-wide block's residual
# (5.11.34) — all but the first three already the decoder's code, which the encoder runs.

enum Av1EncConst {
    AV1ENC_BLOCK_8X8     = 3;    # the block sizes av1_encode_keyframe takes (square, BLOCK_8X8 .. the superblock)
    AV1ENC_BLOCK_16X16   = 6;
    AV1ENC_BLOCK_32X32   = 9;
    AV1ENC_BLOCK_64X64   = 12;
    AV1ENC_BLOCK_128X128 = 15;   # 128x128 superblocks only
    AV1ENC_TX_MAX        = 4096; # samples in the largest transform block (64x64)
    AV1ENC_LV_MAX        = 1024; # Quant[] entries of the largest (32x32 kept of a 64-point transform)
    # records per block: a 64x64 block of 4x4 lossless transforms in every 4:4:4 plane; four times that at 128x128
    AV1ENC_REC_CAP       = 768;
    AV1ENC_REC_CAP_128   = 3072;
    # what av1_encode_keyframe decides (its decide argument); 0 decides nothing (DC_PRED everywhere)
    AV1ENC_DECIDE_YMODE  = 1;    # the luma mode: 13 modes, filter intra, angle deltas
    AV1ENC_DECIDE_UVMODE = 2;    # the chroma mode: 13 modes, angle deltas, CfL and its alphas
    AV1ENC_DECIDE_TXSIZE = 4;    # the luma transform size: every tx depth the block allows
    AV1ENC_DECIDE_TXTYPE = 8;    # each luma transform block's type: its intra tx set
    AV1ENC_DECIDE_ALL    = 15;
    AV1ENC_TOPY          = 3;    # luma candidates the transform search re-tries
    AV1ENC_J_MAX         = 4611686018427387904;   # 2^62: no candidate yet
}

# the encoder context the tile's AV1TILE_EKEY points to
enum Av1EncCtx {
    AV1EC_SRC     = 0;    # the source DrFrame
    AV1EC_FQ      = 8;    # [3] Av1FQuant, one per plane (the plane's DC / AC deltas) -> 32
    AV1EC_RESID   = 32;   # AV1ENC_TX_MAX i64: the transform block's residual, w-stride
    AV1EC_COEFF   = 40;   # AV1ENC_TX_MAX i64: its forward transform
    AV1EC_N       = 48;   # transform blocks recorded for the current block
    AV1EC_RECS    = 56;   # AV1ENC_REC_CAP records of AV1ER_SIZE bytes
    AV1EC_LEVELS  = 64;   # level storage: AV1ENC_REC_CAP * 16 i64 (a block's levels fit: see av1_enc_new)
    AV1EC_LV_USED = 72;   # i64 entries of AV1EC_LEVELS in use for the current block
    AV1EC_LV_CAP  = 80;   # its capacity (i64 entries)
    AV1EC_REC_CAP = 88;   # records AV1EC_RECS holds
    AV1EC_DECIDE  = 96;   # AV1ENC_DECIDE_* bits
    AV1EC_EST     = 104;  # the symbol estimator trials cost their symbols against (0 when deciding nothing)
    AV1EC_RDMULT  = 112;  # av1_rd_mult at the frame's bit depth and base_q_idx
    AV1EC_BD      = 120;  # the bit depth
    AV1EC_CTX     = 128;  # 384 i64: the block's coefficient contexts as it found them (av1_enc_ctx_save)
    AV1EC_BLK     = 136;  # the block record, reused block to block (Av1Block)
    AV1EC_MI      = 144;  # its mode info (Av1ModeInfo)
    AV1EC_NB      = 152;  # 6 i64: its neighbours (av1_block_neighbours)
    AV1EC_MODEJ   = 160;  # 13 i64: the cost of each mode at angle delta 0 in the current search
    AV1EC_ARENA   = 168;  # the block arena: every residual pass's scratch (av1_enc_residual)
    AV1EC_TXSEARCH = 176; # 1: the hook searches each luma transform block's type (av1_enc_tx_type_search)
    AV1EC_PRED    = 184;  # 256 i64: a searched transform block's prediction, put back after each candidate
    AV1EC_BESTLV  = 192;  # 256 i64: the cheapest candidate's levels
    AV1EC_TXCTX   = 200;  # 64 i64: the transform block's coefficient contexts as it found them
    AV1EC_DQ      = 208;  # 3 i64: a candidate's dequantization (av1_tx_dequant)
    AV1EC_TOPY    = 216;  # AV1ENC_TOPY x 5 i64: the cheapest luma candidates (cost, mode, delta, fi, fi mode)
    AV1EC_CARENA  = 224;  # the candidate arena: one transform type candidate's reconstruction scratch
    AV1EC_SIZE    = 232;
}
# one recorded transform block: everything coeffs( ) needs, in the decoder's terms
enum Av1EncRec {
    AV1ER_PLANE  = 0;
    AV1ER_TXSZ   = 8;
    AV1ER_TXTYPE = 16;    # PlaneTxType (compute_tx_type)
    AV1ER_X4     = 24;    # the coefficient-context column / row (av1_coeff_ctx_col / _row)
    AV1ER_Y4     = 32;
    AV1ER_MAXX4  = 40;    # the plane's MI extent, for the skip context
    AV1ER_MAXY4  = 48;
    AV1ER_BW     = 56;    # the block's plane width / height in samples
    AV1ER_BH     = 64;
    AV1ER_EOB    = 72;
    AV1ER_LEVELS = 80;    # Quant[], min(32, w) x min(32, h), stride min(32, w)
    AV1ER_SIZE   = 88;
}

# The context for coding src under sequence s / frame header fh, deciding what decide says: a quantizer per plane at
# base_q_idx with the plane's deltas, the transform scratch, the record and level storage one block of the superblock
# size needs, the block scratch, and when deciding the estimator and the RD multiplier. 0 on OOM.
fn av1_enc_new(src, s, fh, decide): i64 {
    var ec = dr_alloc(AV1EC_SIZE);
    if (ec == 0) { return 0; }
    store64(ec + AV1EC_SRC, src);
    store64(ec + AV1EC_DECIDE, decide);
    store64(ec + AV1EC_BD, av1_seq_bitdepth(s));
    store64(ec + AV1EC_RDMULT, av1_rd_mult(av1_seq_bitdepth(s), av1_fh_base_q_idx(fh)));
    store64(ec + AV1EC_EST, 0);
    if (decide != 0) {
        var est = av1_sym_enc_est_new();
        if (est == 0) { return 0; }
        store64(ec + AV1EC_EST, est);
    }
    var ctx = dr_alloc(384 * 8);
    var blk = av1_block_new();
    var mi = av1_modeinfo_new();
    var nb = dr_alloc(6 * 8);
    var mj = dr_alloc(13 * 8);
    var arena = dr_arena_new(1 << 18);              # 256 KiB chunks
    if ((ctx == 0) || (blk == 0) || (mi == 0) || (nb == 0) || (mj == 0) || (arena == 0)) { return 0; }
    store64(ec + AV1EC_ARENA, arena);
    var pred = dr_alloc(256 * 8);
    var blv = dr_alloc(256 * 8);
    var txc = dr_alloc(64 * 8);
    var dq = dr_alloc(3 * 8);
    var top = dr_alloc(AV1ENC_TOPY * 5 * 8);
    var carena = dr_arena_new(1 << 16);             # 64 KiB chunks
    if ((pred == 0) || (blv == 0) || (txc == 0) || (dq == 0) || (top == 0) || (carena == 0)) { return 0; }
    store64(ec + AV1EC_CARENA, carena);
    store64(ec + AV1EC_PRED, pred);
    store64(ec + AV1EC_BESTLV, blv);
    store64(ec + AV1EC_TXCTX, txc);
    store64(ec + AV1EC_DQ, dq);
    store64(ec + AV1EC_TOPY, top);
    store64(ec + AV1EC_TXSEARCH, 0);
    store64(ec + AV1EC_CTX, ctx);
    store64(ec + AV1EC_BLK, blk);
    store64(ec + AV1EC_MI, mi);
    store64(ec + AV1EC_NB, nb);
    store64(ec + AV1EC_MODEJ, mj);
    var bd = av1_seq_bitdepth(s);
    var plane = 0;
    while (plane < 3) {
        var p = av1_fquant_new();
        if (p == 0) { return 0; }
        if (av1_fquant_set(p, bd, av1_fh_base_q_idx(fh), av1_plane_dc_delta(fh, plane),
            av1_plane_ac_delta(fh, plane)) != DR_OK) { return 0; }
        store64(ec + AV1EC_FQ + (plane * 8), p);
        plane = plane + 1;
    }
    var resid = dr_alloc(AV1ENC_TX_MAX * 8);
    var coeff = dr_alloc(AV1ENC_TX_MAX * 8);
    var rec_cap = AV1ENC_REC_CAP;
    if (av1_seq_use_128x128(s)) { rec_cap = AV1ENC_REC_CAP_128; }
    var recs = dr_alloc(rec_cap * AV1ER_SIZE);
    # a block keeps at most one level per sample per plane (32x32 of a 64-point transform; one per sample otherwise):
    # 3 * 4096 entries for a 64x64 block, 3 * 16384 for a 128x128 — rec_cap * 16 either way
    var lv_cap = rec_cap * 16;
    var lv = dr_alloc(lv_cap * 8);
    if ((resid == 0) || (coeff == 0) || (recs == 0) || (lv == 0)) { return 0; }
    store64(ec + AV1EC_RESID, resid);
    store64(ec + AV1EC_COEFF, coeff);
    store64(ec + AV1EC_RECS, recs);
    store64(ec + AV1EC_LEVELS, lv);
    store64(ec + AV1EC_LV_CAP, lv_cap);
    store64(ec + AV1EC_REC_CAP, rec_cap);
    store64(ec + AV1EC_N, 0);
    store64(ec + AV1EC_LV_USED, 0);
    return ec;
}

# The forward transform of the residual (AV1EC_RESID) at tx_type and its levels into the tile's Quant[] (what the
# reconstruction that follows dequantizes). Returns the eob — one past the last nonzero level in the decoder's scan for
# this (TxSz, type), segEob long (5.11.39), 0 for none — or 0 - DR_ERR_*.
fn av1_enc_quantize_tx(tile, ec, plane, tx_sz, tx_type, lossless): i64 {
    var coeff = load64(ec + AV1EC_COEFF);
    var rc = av1_forward_transform_2d(load64(ec + AV1EC_RESID), coeff, tx_sz, tx_type, lossless);
    if (rc != DR_OK) { return 0 - rc; }
    var quant = load64(tile + AV1TILE_QUANT);
    var nz = 0;
    rc = av1_quantize_block(coeff, quant, tx_sz, load64(ec + AV1EC_FQ + (plane * 8)), 0, &nz);
    if (rc != DR_OK) { return 0 - rc; }
    var seg_eob = av1_min(1024, av1_tx_width(tx_sz) * av1_tx_height(tx_sz));
    if ((tx_sz == 17) || (tx_sz == 18)) { seg_eob = 512; }   # TX_16X64 / TX_64X16
    var scan = av1_get_scan(tx_sz, tx_type);
    var eob = 0;
    var c = seg_eob - 1;
    while ((c >= 0) && (eob == 0)) {
        if (load64(quant + (load64(scan + (c * 8)) * 8)) != 0) { eob = c + 1; }
        c = c - 1;
    }
    return eob;
}

# The luma transform block's coefficient contexts — above level / dc over its columns, left level / dc over its rows,
# the entries its coeffs( ) reads for all_zero and dc_sign and writes at its end — saved to AV1EC_TXCTX (save 1) or
# put back (save 0). A searched block is at most 16 x 16: 4 entries an array.
fn av1_enc_txctx_copy(tile, ec, x4, y4, w4, h4, save): i64 {
    var buf = load64(ec + AV1EC_TXCTX);
    var k = 0;
    while (k < 4) {
        var arr = load64(tile + AV1TILE_ALVL);
        if (k == 1) { arr = load64(tile + AV1TILE_ADC); }
        if (k == 2) { arr = load64(tile + AV1TILE_LLVL); }
        if (k == 3) { arr = load64(tile + AV1TILE_LDC); }
        var lo = x4;
        var n = w4;
        if (k >= 2) { lo = y4; n = h4; }
        var i = 0;
        while (i < n) {
            if (save) { store64(buf + (((k * 16) + i) * 8), load64(arr + ((lo + i) * 8))); }
            else { store64(arr + ((lo + i) * 8), load64(buf + (((k * 16) + i) * 8))); }
            i = i + 1;
        }
        k = k + 1;
    }
    return 0;
}

# The luma transform types an intra block of tx set `set` may code, in the order the search tries them: DCT_DCT first
# (so a tie keeps it), then the rest of Tx_Type_Intra_Inv_Set1 (INTRA_1: seven) or _Set2 (INTRA_2: five) in its order
# (5.11.47). av1_enc_tx_cand_count is how many; av1_enc_tx_cand( set, k ) the k-th, -1 past them. DCTONLY: DCT_DCT.
fn av1_enc_tx_cand_count(set): i64 {
    if (set == AV1_TX_SET_INTRA_1) { return 7; }
    if (set == AV1_TX_SET_INTRA_2) { return 5; }
    return 1;
}
fn av1_enc_tx_cand(set, k): i64 {
    if (k == 0) { return AV1_DCT_DCT; }
    if ((k < 0) || (k >= av1_enc_tx_cand_count(set))) { return 0 - 1; }
    var i = 0;
    var seen = 0;                                 # the non-DCT_DCT entries passed
    while (i < av1_enc_tx_cand_count(set)) {
        var t = av1_intra_tx_inv_set2(i);
        if (set == AV1_TX_SET_INTRA_1) { t = av1_intra_tx_inv_set1(i); }
        if (t != AV1_DCT_DCT) {
            seen = seen + 1;
            if (seen == k) { return t; }
        }
        i = i + 1;
    }
    return 0 - 1;
}

# The luma transform type by RD (AV1ENC_DECIDE_TXTYPE), for one transform block whose prediction is in the frame and
# residual in AV1EC_RESID: each type of its intra tx set (5.11.48 get_tx_set: INTRA_1's seven, INTRA_2's five; DCT_DCT
# first, so a tie keeps it) quantized, its rate its coeffs( ) against the estimator — the intra_tx_type symbol, coded
# against a CDF the luma mode selects, among them — from the contexts the block found, its distortion the SSE of the
# decoder's own reconstruction of it (av1_reconstruct_qm at av1_tx_dequant's steps, in place over the prediction,
# which is put back). The cheapest's levels are left in Quant[], its type at *out_type (DCT_DCT when every level is 0,
# as the decoder holds an all-zero block), and the contexts as its coeffs( ) leaves them, so the next transform block
# of the pass is costed from where the decoder will be (av1_enc_residual puts the block's back after the pass).
# Returns its eob, or 0 - DR_ERR_*.
fn av1_enc_tx_type_search(tile, ec, tx_sz, start_x, start_y, x4, y4, max_x4, max_y4, bw, bh, set, out_type): i64 {
    var frame = load64(tile + AV1TILE_FRAME);
    var src = load64(ec + AV1EC_SRC);
    var ttx = load64(tile + AV1TILE_TTX);
    var cc = load64(tile + AV1TILE_CC);
    var ncc = load64(tile + AV1TILE_NCC);
    var est = load64(ec + AV1EC_EST);
    var quant = load64(tile + AV1TILE_QUANT);
    var pred = load64(ec + AV1EC_PRED);
    var blv = load64(ec + AV1EC_BESTLV);
    var dq = load64(ec + AV1EC_DQ);
    var w = av1_tx_width(tx_sz);
    var h = av1_tx_height(tx_sz);
    var nlv = w * h;                              # a searched block is at most 16 x 16: every level kept
    var alvl = load64(tile + AV1TILE_ALVL);
    var llvl = load64(tile + AV1TILE_LLVL);
    var adc = load64(tile + AV1TILE_ADC);
    var ldc = load64(tile + AV1TILE_LDC);
    var i = 0;
    while (i < h) {
        var j = 0;
        while (j < w) {
            store64(pred + (((i * w) + j) * 8), dr_frame_get(frame, 0, start_x + j, start_y + i));
            j = j + 1;
        }
        i = i + 1;
    }
    av1_enc_txctx_copy(tile, ec, x4, y4, w >> 2, h >> 2, 1);
    var n = av1_enc_tx_cand_count(set);
    var best = AV1ENC_J_MAX;
    var bt = AV1_DCT_DCT;
    var beob = 0;
    var k = 0;
    while (k < n) {
        var t = av1_enc_tx_cand(set, k);
        if (t >= 0) {
            var eob = av1_enc_quantize_tx(tile, ec, 0, tx_sz, t, 0);
            if (eob < 0) { return eob; }
            av1_enc_txctx_copy(tile, ec, x4, y4, w >> 2, h >> 2, 0);
            av1_sym_enc_set_cost(est, 0);
            var ce = av1_coeffs_encode(est, cc, ncc, 0, tx_sz, ttx, t, x4, y4, max_x4, max_y4, bw, bh,
              alvl, llvl, adc, ldc, quant, eob);
            if (ce == DR_OK) { ce = av1_sym_enc_err(est); }
            if (ce != DR_OK) { return 0 - ce; }
            var rate = av1_sym_enc_cost(est);
            if (eob > 0) {
                # the reconstruction's scratch from the candidate arena, dead at the next candidate (a pass's
                # thousands of candidates would otherwise pile up in the block arena until the pass ends)
                var carena = load64(ec + AV1EC_CARENA);
                dr_arena_reset(carena);
                var prev = dr_alloc_scope(carena);
                var de = av1_tx_dequant(tile, 0, tx_sz, t, 0, dq);
                if (de == DR_OK) {
                    de = av1_reconstruct_qm(frame, 0, start_x, start_y, tx_sz, t, 0, quant, load64(dq), load64(dq + 8),
                      load64(dq + 16));
                }
                dr_alloc_scope(prev);
                if (de != DR_OK) { return 0 - de; }
            }
            var sse = av1_rd_sse(src, frame, 0, start_x, start_y, w, h);
            if (eob > 0) {
                i = 0;
                while (i < h) {
                    var jj = 0;
                    while (jj < w) {
                        dr_frame_set(frame, 0, start_x + jj, start_y + i, load64(pred + (((i * w) + jj) * 8)));
                        jj = jj + 1;
                    }
                    i = i + 1;
                }
            }
            var jt = av1_rd_cost(load64(ec + AV1EC_RDMULT), rate, av1_rd_dist(sse, load64(ec + AV1EC_BD)));
            if (jt < best) {
                best = jt;
                bt = t;
                beob = eob;
                i = 0;
                while (i < nlv) { store64(blv + (i * 8), load64(quant + (i * 8))); i = i + 1; }
            }
        }
        k = k + 1;
    }
    i = 0;
    while (i < nlv) { store64(quant + (i * 8), load64(blv + (i * 8))); i = i + 1; }
    if (beob == 0) { bt = AV1_DCT_DCT; }
    av1_enc_txctx_copy(tile, ec, x4, y4, w >> 2, h >> 2, 0);
    var ca = av1_coeffs_encode(est, cc, ncc, 0, tx_sz, ttx, bt, x4, y4, max_x4, max_y4, bw, bh,
      alvl, llvl, adc, ldc, quant, beob);
    if (ca != DR_OK) { return 0 - ca; }
    store64(out_type, bt);
    return beob;
}

# The residual pass's hook (called by av1_transform_block, src/av1_residual.cyr, with the prediction for this transform
# block already in the reconstruction frame): the source minus the prediction over the transform block (0 outside the
# visible plane, where the decoder's output is cropped away), its forward transform, its levels into the tile's Quant[]
# (what the reconstruction that follows dequantizes), PlaneTxType into the tile's out_tx_type, and a record of the block
# for the symbol pass. The type is compute_tx_type's from DCT_DCT (luma) or the chroma mode — or, for a luma block
# while AV1EC_TXSEARCH is set, the transform type search's (av1_enc_tx_type_search) over its intra tx set when the set
# has more than DCT_DCT and the qindex codes intra_tx_type. Returns the eob, or 0 - DR_ERR_*.
fn av1_enc_tx_levels(tile, ec, plane, tx_sz, start_x, start_y, x4, y4, max_x4, max_y4, bw, bh, lossless): i64 {
    var frame = load64(tile + AV1TILE_FRAME);
    var src = load64(ec + AV1EC_SRC);
    var ttx = load64(tile + AV1TILE_TTX);
    # DC_PRED codes DCT_DCT (Mode_To_Txfm in chroma); compute_tx_type gives the type the decoder will apply
    var tx_type = av1_compute_tx_type(plane, tx_sz, ttx, AV1_DCT_DCT);
    var w = av1_tx_width(tx_sz);
    var h = av1_tx_height(tx_sz);
    var pw = dr_frame_plane_width(src, plane);
    var ph = dr_frame_plane_height(src, plane);
    var resid = load64(ec + AV1EC_RESID);
    var i = 0;
    while (i < h) {
        var y = start_y + i;
        var j = 0;
        while (j < w) {
            var x = start_x + j;
            var v = 0;
            if ((x < pw) && (y < ph)) { v = dr_frame_get(src, plane, x, y) - dr_frame_get(frame, plane, x, y); }
            store64(resid + (((i * w) + j) * 8), v);
            j = j + 1;
        }
        i = i + 1;
    }
    var set = AV1_TX_SET_DCTONLY;
    if ((plane == 0) && (lossless == 0) && (load64(ec + AV1EC_TXSEARCH) != 0) && (load64(ttx + AV1TTC_BASE_Q) > 0)) {
        set = av1_get_tx_set(tx_sz, 0, load64(ttx + AV1TTC_REDUCED_TX));
    }
    var eob = 0;
    if (set == AV1_TX_SET_DCTONLY) {
        eob = av1_enc_quantize_tx(tile, ec, plane, tx_sz, tx_type, lossless);
    } else {
        eob = av1_enc_tx_type_search(tile, ec, tx_sz, start_x, start_y, x4, y4, max_x4, max_y4, bw, bh, set, &tx_type);
    }
    if (eob < 0) { return eob; }
    store64(load64(tile + AV1TILE_OTT), tx_type);
    if ((plane == 0) && (tx_type != AV1_DCT_DCT)) { Av1_Enc_Log_Types = Av1_Enc_Log_Types + 1; }
    var quant = load64(tile + AV1TILE_QUANT);
    # the record, with a copy of Quant[]
    var n = load64(ec + AV1EC_N);
    var nlv = av1_min(w, 32) * av1_min(h, 32);
    var used = load64(ec + AV1EC_LV_USED);
    if ((n >= load64(ec + AV1EC_REC_CAP)) || ((used + nlv) > load64(ec + AV1EC_LV_CAP))) { return 0 - DR_ERR_BOUNDS; }
    var lv = load64(ec + AV1EC_LEVELS) + (used * 8);
    var k = 0;
    while (k < nlv) { store64(lv + (k * 8), load64(quant + (k * 8))); k = k + 1; }
    var rec = load64(ec + AV1EC_RECS) + (n * AV1ER_SIZE);
    store64(rec + AV1ER_PLANE, plane);
    store64(rec + AV1ER_TXSZ, tx_sz);
    store64(rec + AV1ER_TXTYPE, tx_type);
    store64(rec + AV1ER_X4, x4);
    store64(rec + AV1ER_Y4, y4);
    store64(rec + AV1ER_MAXX4, max_x4);
    store64(rec + AV1ER_MAXY4, max_y4);
    store64(rec + AV1ER_BW, bw);
    store64(rec + AV1ER_BH, bh);
    store64(rec + AV1ER_EOB, eob);
    store64(rec + AV1ER_LEVELS, lv);
    store64(ec + AV1EC_N, n + 1);
    store64(ec + AV1EC_LV_USED, used + nlv);
    return eob;
}

# The decisions, as a test sees them (0.8.7): while Av1_Enc_Log is set (av1_enc_set_log), each block appends its mode
# info as decided — AV1ENC_LOG_W i64: MiRow, MiCol, YMode, AngleDeltaY, use_filter_intra, filter_intra_mode, UVMode,
# AngleDeltaUV, CflAlphaU, CflAlphaV, the luma TxSize, and the luma transform blocks not DCT_DCT (counted by the hook
# over the final residual pass) — until cap entries are held. What the stream codes is the decoder's to say
# (decode == reconstruction, and aomdec); this says what the search chose, for tests that know the answer by
# construction.
enum Av1EncLogConst { AV1ENC_LOG_W = 12; }
var Av1_Enc_Log = 0;
var Av1_Enc_Log_Cap = 0;
var Av1_Enc_Log_N = 0;
fn av1_enc_set_log(buf, cap): i64 {
    Av1_Enc_Log = buf;
    Av1_Enc_Log_Cap = cap;
    Av1_Enc_Log_N = 0;
    return 0;
}
fn av1_enc_log_count(): i64 { return Av1_Enc_Log_N; }
var Av1_Enc_Log_Types = 0;   # the luma transform blocks not DCT_DCT in the block being coded
fn av1_enc_log_block(r, c, mi, tx_size): i64 {
    if ((Av1_Enc_Log == 0) || (Av1_Enc_Log_N >= Av1_Enc_Log_Cap)) { return 0; }
    var e = Av1_Enc_Log + (Av1_Enc_Log_N * AV1ENC_LOG_W * 8);
    store64(e, r);
    store64(e + 8, c);
    store64(e + 16, load64(mi + AV1MI_YMODE));
    store64(e + 24, load64(mi + AV1MI_ANGLE_Y));
    store64(e + 32, load64(mi + AV1MI_USE_FI));
    store64(e + 40, load64(mi + AV1MI_FI_MODE));
    store64(e + 48, load64(mi + AV1MI_UVMODE));
    store64(e + 56, load64(mi + AV1MI_ANGLE_UV));
    store64(e + 64, load64(mi + AV1MI_CFL_U));
    store64(e + 72, load64(mi + AV1MI_CFL_V));
    store64(e + 80, tx_size);
    store64(e + 88, Av1_Enc_Log_Types);
    Av1_Enc_Log_N = Av1_Enc_Log_N + 1;
    return 0;
}

# The mode info back to av1_modeinfo_new's: DC_PRED / DC_PRED, no angle, CfL, filter intra, palette or skip.
fn av1_enc_mi_reset(mi): i64 {
    dr_fill(mi, 0, AV1MI_SIZE);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    return 0;
}

# BlockDecoded back to 0 over the block's footprint in the planes of mask (bit p = plane p): the cells its transform
# blocks mark (av1_transform_block), each 0 before the block (5.11.3 clears the superblock's interior). A trial's marks
# must not survive into the next trial, whose prediction reads them for above-right / below-left availability.
fn av1_enc_bd_reset(tile, r, c, bw4, bh4, mask): i64 {
    var sbmask = av1_tile_sb_mask(tile);
    var plane = 0;
    while (plane < 3) {
        if ((mask >> plane) & 1) {
            var sx = 0;
            var sy = 0;
            if (plane > 0) {
                sx = load64(tile + AV1TILE_SUBX);
                sy = load64(tile + AV1TILE_SUBY);
            }
            var r1 = ((r + bh4) - 1) & sbmask;
            var c1 = ((c + bw4) - 1) & sbmask;
            var y = (r & sbmask) >> sy;
            while (y <= (r1 >> sy)) {
                var x = (c & sbmask) >> sx;
                while (x <= (c1 >> sx)) {
                    av1_bd_set(tile, plane, y, x, 0);
                    x = x + 1;
                }
                y = y + 1;
            }
        }
        plane = plane + 1;
    }
    return 0;
}

# The coefficient contexts over the block's span — above level / dc at its columns, left level / dc at its rows, per
# plane, the entries coeffs( ) writes and reset_block_context clears (src/av1_partition.cyr) — saved to AV1EC_CTX
# (save 1) or put back from it (save 0). At most 32 entries per array: a 128-sample side in 4x4 units.
fn av1_enc_ctx_copy(tile, ec, r, c, bw4, bh4, num_planes, save): i64 {
    var buf = load64(ec + AV1EC_CTX);
    var subx = load64(tile + AV1TILE_SUBX);
    var suby = load64(tile + AV1TILE_SUBY);
    var col0 = load64(tile + AV1TILE_COL_START);
    var row0 = load64(tile + AV1TILE_ROW_START);
    var plane = 0;
    while (plane < num_planes) {
        var sx = 0;
        var sy = 0;
        if (plane > 0) { sx = subx; sy = suby; }
        var k = 0;
        while (k < 4) {
            var arr = 0;
            var lo = 0;
            var hi = 0;
            if (k < 2) {
                arr = load64(tile + AV1TILE_ALVL + (plane * 8));
                if (k == 1) { arr = load64(tile + AV1TILE_ADC + (plane * 8)); }
                lo = (c >> sx) - (col0 >> sx);
                hi = ((c + bw4) >> sx) - (col0 >> sx);
            } else {
                arr = load64(tile + AV1TILE_LLVL + (plane * 8));
                if (k == 3) { arr = load64(tile + AV1TILE_LDC + (plane * 8)); }
                lo = (r >> sy) - (row0 >> sy);
                hi = ((r + bh4) >> sy) - (row0 >> sy);
            }
            var slot = buf + ((((plane * 4) + k) * 32) * 8);
            var i = lo;
            while ((i < hi) && ((i - lo) < 32)) {
                if (save) { store64(slot + ((i - lo) * 8), load64(arr + (i * 8))); }
                else { store64(arr + (i * 8), load64(slot + ((i - lo) * 8))); }
                i = i + 1;
            }
            k = k + 1;
        }
        plane = plane + 1;
    }
    return 0;
}

# The block's mode info (5.11.7 intra_frame_mode_info) against enc — the coder in the symbol pass, the estimator in a
# trial — from the block record and its neighbours. Palette is never used, so palette_tokens( ) between this and the tx
# size codes nothing.
fn av1_enc_write_mode_info(tile, enc, blk, nb): i64 {
    return av1_intra_frame_mode_info_encode(enc, load64(tile + AV1TILE_NCC), load64(blk + AV1BLK_MI),
      load64(blk + AV1BLK_MI_SIZE), load64(blk + AV1BLK_HAS_CHROMA),
      load64(blk + AV1BLK_AVAIL_U), load64(nb + 0), load64(blk + AV1BLK_AVAIL_L), load64(nb + 8),
      load64(nb + 16), load64(nb + 24),
      load64(tile + AV1TILE_LOSSLESS_MASK), load64(tile + AV1TILE_SUBX), load64(tile + AV1TILE_SUBY),
      load64(tile + AV1TILE_ENABLE_FI), load64(tile + AV1TILE_CDEF_CTX),
      load64(blk + AV1BLK_MI_ROW), load64(blk + AV1BLK_MI_COL), tile);
}
# read_block_tx_size's mirror for the block (tx depth from AV1BLK_TX_SIZE)
fn av1_enc_write_tx_size(tile, enc, blk, nb): i64 {
    var bsize = load64(blk + AV1BLK_MI_SIZE);
    var tx_ctx = av1_tx_depth_ctx(load64(blk + AV1BLK_AVAIL_U), load64(nb + 32), load64(blk + AV1BLK_AVAIL_L),
      load64(nb + 40), av1_max_tx_size_rect(bsize));
    av1_write_tx_size(enc, load64(tile + AV1TILE_NCC), bsize, load64(blk + AV1BLK_LOSSLESS),
      load64(tile + AV1TILE_TX_MODE), 1, tx_ctx, load64(blk + AV1BLK_TX_SIZE));
    return av1_sym_enc_err(enc);
}
# Each recorded transform block's coeffs( ) against enc, in decode order. Updates the coefficient contexts.
fn av1_enc_write_coeffs(tile, ec, enc): i64 {
    var ttx = load64(tile + AV1TILE_TTX);
    var cc = load64(tile + AV1TILE_CC);
    var ncc = load64(tile + AV1TILE_NCC);
    var recs = load64(ec + AV1EC_RECS);
    var n = load64(ec + AV1EC_N);
    var k = 0;
    while (k < n) {
        var rec = recs + (k * AV1ER_SIZE);
        var p = load64(rec + AV1ER_PLANE);
        var ce = av1_coeffs_encode(enc, cc, ncc, p, load64(rec + AV1ER_TXSZ), ttx, load64(rec + AV1ER_TXTYPE),
          load64(rec + AV1ER_X4), load64(rec + AV1ER_Y4), load64(rec + AV1ER_MAXX4), load64(rec + AV1ER_MAXY4),
          load64(rec + AV1ER_BW), load64(rec + AV1ER_BH),
          load64(tile + AV1TILE_ALVL + (p * 8)), load64(tile + AV1TILE_LLVL + (p * 8)),
          load64(tile + AV1TILE_ADC + (p * 8)), load64(tile + AV1TILE_LDC + (p * 8)),
          load64(rec + AV1ER_LEVELS), load64(rec + AV1ER_EOB));
        if (ce != DR_OK) { return ce; }
        k = k + 1;
    }
    return av1_sym_enc_err(enc);
}

# The residual pass over the planes of mask: the block's BlockDecoded cells in them cleared, then the decoder's
# residual( ) over those planes alone, recording each transform block (av1_enc_tx_levels). The decoder's per-transform
# block scratch (prediction edges, the inverse transform, the reconstruction's dequantized block) is what a decoder
# takes from its frame arena (ADR 0002); here it comes from the block arena, in scope for the block's decisions and
# residual pass (av1_enc_block), and is dead at the next pass — so a block's seventy-odd trials take one trial's
# memory, not seventy.
fn av1_enc_residual(tile, ec, blk, mask): i64 {
    dr_arena_reset(load64(ec + AV1EC_ARENA));
    av1_enc_bd_reset(tile, load64(blk + AV1BLK_MI_ROW), load64(blk + AV1BLK_MI_COL),
      av1_num_4x4_w(load64(blk + AV1BLK_MI_SIZE)), av1_num_4x4_h(load64(blk + AV1BLK_MI_SIZE)), mask);
    store64(blk + AV1BLK_PLANE_SKIP, 7 ^ mask);
    store64(ec + AV1EC_N, 0);
    store64(ec + AV1EC_LV_USED, 0);
    Av1_Enc_Log_Types = 0;
    var e = av1_residual(tile, blk);
    store64(blk + AV1BLK_PLANE_SKIP, 0);
    if (load64(ec + AV1EC_TXSEARCH) != 0) {
        # the type search costed each transform block from the contexts the one before it left: the block's back
        var num_planes = 1;
        if (load64(blk + AV1BLK_HAS_CHROMA)) { num_planes = 3; }
        var bsize = load64(blk + AV1BLK_MI_SIZE);
        av1_enc_ctx_copy(tile, ec, load64(blk + AV1BLK_MI_ROW), load64(blk + AV1BLK_MI_COL), av1_num_4x4_w(bsize),
          av1_num_4x4_h(bsize), num_planes, 0);
    }
    return e;
}

# One TRIAL of the block's mode info as it stands, over the planes of mask: the residual pass over them, the rate of
# the mode info, tx size and their coeffs( ) against the estimator (the coefficient contexts put back after), and the
# SSE of their reconstruction against the source. Returns the RD cost, or 0 - DR_ERR_* on an error. The planes' new
# reconstruction stays in the frame (a chroma trial's CfL reads the luma one).
fn av1_enc_trial(tile, ec, blk, nb, mask): i64 {
    var e = av1_enc_residual(tile, ec, blk, mask);
    if (e != DR_OK) { return 0 - e; }
    var est = load64(ec + AV1EC_EST);
    av1_sym_enc_set_cost(est, 0);
    e = av1_enc_write_mode_info(tile, est, blk, nb);
    if (e == DR_OK) { e = av1_enc_write_tx_size(tile, est, blk, nb); }
    if (e == DR_OK) { e = av1_enc_write_coeffs(tile, ec, est); }
    var r = load64(blk + AV1BLK_MI_ROW);
    var c = load64(blk + AV1BLK_MI_COL);
    var bsize = load64(blk + AV1BLK_MI_SIZE);
    var num_planes = 1;
    if (load64(blk + AV1BLK_HAS_CHROMA)) { num_planes = 3; }
    av1_enc_ctx_copy(tile, ec, r, c, av1_num_4x4_w(bsize), av1_num_4x4_h(bsize), num_planes, 0);
    if (e != DR_OK) { return 0 - e; }
    var src = load64(ec + AV1EC_SRC);
    var frame = load64(tile + AV1TILE_FRAME);
    var sse = 0;
    var plane = 0;
    while (plane < num_planes) {
        if ((mask >> plane) & 1) {
            var sx = 0;
            var sy = 0;
            if (plane > 0) {
                sx = load64(tile + AV1TILE_SUBX);
                sy = load64(tile + AV1TILE_SUBY);
            }
            var psz = av1_get_plane_residual_size(bsize, plane, sx, sy);
            sse = sse + av1_rd_sse(src, frame, plane, (c >> sx) * AV1_MI_SIZE, (r >> sy) * AV1_MI_SIZE,
              av1_block_width(psz), av1_block_height(psz));
        }
        plane = plane + 1;
    }
    return av1_rd_cost(load64(ec + AV1EC_RDMULT), av1_sym_enc_cost(est),
      av1_rd_dist(sse, load64(ec + AV1EC_BD)));
}

# The cheapest AV1ENC_TOPY luma candidates so far, cheapest first (AV1EC_TOPY: cost, mode, delta, fi, fi mode): a
# candidate goes in ahead of the first it is cheaper than, so a tie keeps the earlier.
fn av1_enc_top_insert(ec, j, mode, delta, use_fi, fi_mode): i64 {
    var top = load64(ec + AV1EC_TOPY);
    var at = 0;
    while ((at < AV1ENC_TOPY) && (load64(top + (at * 40)) <= j)) { at = at + 1; }
    if (at >= AV1ENC_TOPY) { return 0; }
    var k = AV1ENC_TOPY - 1;
    while (k > at) {
        var f = 0;
        while (f < 5) { store64(top + (k * 40) + (f * 8), load64(top + ((k - 1) * 40) + (f * 8))); f = f + 1; }
        k = k - 1;
    }
    store64(top + (at * 40), j);
    store64(top + (at * 40) + 8, mode);
    store64(top + (at * 40) + 16, delta);
    store64(top + (at * 40) + 24, use_fi);
    store64(top + (at * 40) + 32, fi_mode);
    return 0;
}
fn av1_enc_top_reset(ec): i64 {
    var top = load64(ec + AV1EC_TOPY);
    var k = 0;
    while (k < AV1ENC_TOPY) { dr_fill(top + (k * 40), 0, 40); store64(top + (k * 40), AV1ENC_J_MAX); k = k + 1; }
    return 0;
}
# a luma candidate: mode, angle delta, filter intra; its trial's cost (and its place among the cheapest)
fn av1_enc_try_y(tile, ec, blk, nb, mode, delta, use_fi, fi_mode): i64 {
    var mi = load64(blk + AV1BLK_MI);
    store64(mi + AV1MI_YMODE, mode);
    store64(mi + AV1MI_ANGLE_Y, delta);
    store64(mi + AV1MI_USE_FI, use_fi);
    store64(mi + AV1MI_FI_MODE, fi_mode);
    var j = av1_enc_trial(tile, ec, blk, nb, 1);
    if (j >= 0) { av1_enc_top_insert(ec, j, mode, delta, use_fi, fi_mode); }
    return j;
}
# the two directional modes (V_PRED .. D67_PRED) of lowest cost in AV1EC_MODEJ, into *out_a / *out_b
fn av1_enc_best_directional(ec, out_a, out_b): i64 {
    var mj = load64(ec + AV1EC_MODEJ);
    var a = AV1_V_PRED;
    var b = AV1_H_PRED;
    if (load64(mj + (b * 8)) < load64(mj + (a * 8))) {
        a = AV1_H_PRED;
        b = AV1_V_PRED;
    }
    var m = AV1_D45_PRED;
    while (m <= AV1_D67_PRED) {
        var j = load64(mj + (m * 8));
        if (j < load64(mj + (a * 8))) {
            b = a;
            a = m;
        } else {
            if (j < load64(mj + (b * 8))) { b = m; }
        }
        m = m + 1;
    }
    store64(out_a, a);
    store64(out_b, b);
    return 0;
}

# The luma mode by RD (AV1ENC_DECIDE_YMODE): each of the 13 modes at angle delta 0, each filter intra mode where filter
# intra is allowed (5.11.24: DC_PRED, no palette, at most 32x32), then the other six angle deltas of the two cheapest
# directional modes (5.11.42 intra_angle_info_y: a block of at least 8x8). Luma-only trials, with the chroma mode as it
# stands — its uv_mode symbol, coded against a CDF the luma mode selects, is part of each candidate's rate. The
# cheapest is left in the mode info, ties keeping the earlier, and the three cheapest in AV1EC_TOPY for the transform
# search. DR_OK, or the first trial's error.
fn av1_enc_pick_y(tile, ec, blk, nb): i64 {
    var mi = load64(blk + AV1BLK_MI);
    var bsize = load64(blk + AV1BLK_MI_SIZE);
    var mj = load64(ec + AV1EC_MODEJ);
    av1_enc_top_reset(ec);
    var best = AV1ENC_J_MAX;
    var bmode = AV1_DC_PRED;
    var bdelta = 0;
    var bfi = 0;
    var bfim = 0;
    var m = 0;
    while (m <= AV1_PAETH_PRED) {
        var j = av1_enc_try_y(tile, ec, blk, nb, m, 0, 0, 0);
        if (j < 0) { return 0 - j; }
        store64(mj + (m * 8), j);
        if (j < best) { best = j; bmode = m; bdelta = 0; bfi = 0; bfim = 0; }
        m = m + 1;
    }
    if (av1_filter_intra_allowed(load64(tile + AV1TILE_ENABLE_FI), bsize, AV1_DC_PRED, 0)) {
        var f = 0;
        while (f < 5) {
            var jf = av1_enc_try_y(tile, ec, blk, nb, AV1_DC_PRED, 0, 1, f);
            if (jf < 0) { return 0 - jf; }
            if (jf < best) { best = jf; bmode = AV1_DC_PRED; bdelta = 0; bfi = 1; bfim = f; }
            f = f + 1;
        }
    }
    if (av1_angle_delta_active(bsize, AV1_V_PRED)) {
        var da = 0;
        var db = 0;
        av1_enc_best_directional(ec, &da, &db);
        var t = 0;
        while (t < 2) {
            var dm = da;
            if (t == 1) { dm = db; }
            var d = 0 - AV1_MAX_ANGLE_DELTA;
            while (d <= AV1_MAX_ANGLE_DELTA) {
                if (d != 0) {
                    var jd = av1_enc_try_y(tile, ec, blk, nb, dm, d, 0, 0);
                    if (jd < 0) { return 0 - jd; }
                    if (jd < best) { best = jd; bmode = dm; bdelta = d; bfi = 0; bfim = 0; }
                }
                d = d + 1;
            }
            t = t + 1;
        }
    }
    store64(mi + AV1MI_YMODE, bmode);
    store64(mi + AV1MI_ANGLE_Y, bdelta);
    store64(mi + AV1MI_USE_FI, bfi);
    store64(mi + AV1MI_FI_MODE, bfim);
    return DR_OK;
}

# The luma transform by RD (AV1ENC_DECIDE_TXSIZE / _TXTYPE), after the luma mode search: each of its AV1ENC_TOPY
# cheapest candidates (the block's mode as it stands when the luma mode is not decided) re-tried at every tx depth the
# block allows (5.11.15 read_tx_size: Max_Tx_Size_Rect split once per depth, up to Min( Max_Tx_Depth, MAX_TX_DEPTH );
# depth 0 alone without AV1ENC_DECIDE_TXSIZE) with each luma transform block's type searched (with
# AV1ENC_DECIDE_TXTYPE); the tx_depth symbol is part of each one's rate. The cheapest candidate and size are left in
# the mode info and AV1BLK_TX_SIZE, and the type search stays on for the rest of the block, so every later luma pass
# reproduces the types it chose. A lossless block has one transform, the 4x4 WHT.
fn av1_enc_pick_tx(tile, ec, blk, nb): i64 {
    if (load64(blk + AV1BLK_LOSSLESS)) { return DR_OK; }
    var mi = load64(blk + AV1BLK_MI);
    var bsize = load64(blk + AV1BLK_MI_SIZE);
    var decide = load64(ec + AV1EC_DECIDE);
    var maxd = 0;
    if (decide & AV1ENC_DECIDE_TXSIZE) { maxd = av1_min(av1_max_tx_depth(bsize), AV1_MAX_TX_DEPTH); }
    if (decide & AV1ENC_DECIDE_TXTYPE) { store64(ec + AV1EC_TXSEARCH, 1); }
    var top = load64(ec + AV1EC_TOPY);
    if ((decide & AV1ENC_DECIDE_YMODE) == 0) {
        av1_enc_top_reset(ec);
        av1_enc_top_insert(ec, 0, load64(mi + AV1MI_YMODE), load64(mi + AV1MI_ANGLE_Y), load64(mi + AV1MI_USE_FI),
          load64(mi + AV1MI_FI_MODE));
    }
    var best = AV1ENC_J_MAX;
    var bc = 0;
    var btx = av1_max_tx_size_rect(bsize);
    var ci = 0;
    while ((ci < AV1ENC_TOPY) && (load64(top + (ci * 40)) < AV1ENC_J_MAX)) {
        store64(mi + AV1MI_YMODE, load64(top + (ci * 40) + 8));
        store64(mi + AV1MI_ANGLE_Y, load64(top + (ci * 40) + 16));
        store64(mi + AV1MI_USE_FI, load64(top + (ci * 40) + 24));
        store64(mi + AV1MI_FI_MODE, load64(top + (ci * 40) + 32));
        var t = av1_max_tx_size_rect(bsize);
        var d = 0;
        while (d <= maxd) {
            store64(blk + AV1BLK_TX_SIZE, t);
            var j = av1_enc_trial(tile, ec, blk, nb, 1);
            if (j < 0) { return 0 - j; }
            if (j < best) { best = j; bc = ci; btx = t; }
            t = av1_split_tx_size(t);
            d = d + 1;
        }
        ci = ci + 1;
    }
    store64(mi + AV1MI_YMODE, load64(top + (bc * 40) + 8));
    store64(mi + AV1MI_ANGLE_Y, load64(top + (bc * 40) + 16));
    store64(mi + AV1MI_USE_FI, load64(top + (bc * 40) + 24));
    store64(mi + AV1MI_FI_MODE, load64(top + (bc * 40) + 32));
    store64(blk + AV1BLK_TX_SIZE, btx);
    return DR_OK;
}

# a chroma candidate (CfL alphas as they stand); its trial's cost over both chroma planes
fn av1_enc_try_uv(tile, ec, blk, nb, mode, delta): i64 {
    var mi = load64(blk + AV1BLK_MI);
    store64(mi + AV1MI_UVMODE, mode);
    store64(mi + AV1MI_ANGLE_UV, delta);
    return av1_enc_trial(tile, ec, blk, nb, 6);
}
# One CfL alpha by RD, for plane 1 (CflAlphaU) or 2 (CflAlphaV) with the other as it stands: a coarse set of
# magnitudes 1, 3, 6, 10, 15 of each sign (and 0 when allow_zero: the other alpha is not 0, so cfl_alpha_signs can code
# it), then each untried value within 2 of the best. One-plane trials. Leaves the best in the mode info; returns its
# cost, or 0 - DR_ERR_*.
fn av1_enc_cfl_alpha(tile, ec, blk, nb, plane, allow_zero): i64 {
    var mi = load64(blk + AV1BLK_MI);
    var field = AV1MI_CFL_U;
    if (plane == 2) { field = AV1MI_CFL_V; }
    var tried = 0;                                   # bit a + 16 for each alpha a tried
    var best = AV1ENC_J_MAX;
    var ba = 0;
    var round = 0;
    while (round < 2) {
        var centre = ba;
        var k = 0;
        while (k < 11) {
            var a = 0;
            if (round == 0) {
                # 0, then +-1, +-3, +-6, +-10, +-15
                if (k > 0) {
                    var mag = 1;
                    var h = (k + 1) >> 1;
                    if (h == 2) { mag = 3; }
                    if (h == 3) { mag = 6; }
                    if (h == 4) { mag = 10; }
                    if (h == 5) { mag = 15; }
                    a = mag;
                    if ((k & 1) == 0) { a = 0 - mag; }
                }
            } else {
                a = 99;                              # past the refinement's four
                if (k < 4) {
                    a = centre - 2 + k;
                    if (k >= 2) { a = a + 1; }      # centre - 2, -1, +1, +2
                }
            }
            var ok = 1;
            if ((a < (0 - 16)) || (a > 16)) { ok = 0; }
            if ((a == 0) && (allow_zero == 0)) { ok = 0; }
            if (ok && (((tried >> (a + 16)) & 1) != 0)) { ok = 0; }
            if (ok) {
                tried = tried | (1 << (a + 16));
                store64(mi + field, a);
                var j = av1_enc_trial(tile, ec, blk, nb, 1 << plane);
                if (j < 0) { return j; }
                if (j < best) { best = j; ba = a; }
            }
            k = k + 1;
        }
        round = round + 1;
    }
    store64(mi + field, ba);
    return best;
}

# The chroma mode by RD (AV1ENC_DECIDE_UVMODE), after the luma mode is settled: the chosen luma reconstructed first
# (CfL predicts from it), then each of the 13 modes at angle delta 0, the other six angle deltas of the two cheapest
# directional modes, and, where CfL is allowed (CflAllowed, the uv_mode CDF selection of 9.3), UV_CFL_PRED with
# CflAlphaU searched against CflAlphaV = 0, CflAlphaV against it, and CflAlphaU again when CflAlphaV is not 0 (the
# joint sign never codes both zero). The trials are over both chroma planes, the alpha searches over one. The cheapest
# is left in the mode info.
fn av1_enc_pick_uv(tile, ec, blk, nb): i64 {
    var mi = load64(blk + AV1BLK_MI);
    var bsize = load64(blk + AV1BLK_MI_SIZE);
    var mj = load64(ec + AV1EC_MODEJ);
    var jl = av1_enc_trial(tile, ec, blk, nb, 1);
    if (jl < 0) { return 0 - jl; }
    var best = AV1ENC_J_MAX;
    var bmode = AV1_DC_PRED;
    var bdelta = 0;
    var bu = 0;
    var bv = 0;
    store64(mi + AV1MI_CFL_U, 0);
    store64(mi + AV1MI_CFL_V, 0);
    var m = 0;
    while (m <= AV1_PAETH_PRED) {
        var j = av1_enc_try_uv(tile, ec, blk, nb, m, 0);
        if (j < 0) { return 0 - j; }
        store64(mj + (m * 8), j);
        if (j < best) { best = j; bmode = m; bdelta = 0; }
        m = m + 1;
    }
    if (av1_angle_delta_active(bsize, AV1_V_PRED)) {
        var da = 0;
        var db = 0;
        av1_enc_best_directional(ec, &da, &db);
        var t = 0;
        while (t < 2) {
            var dm = da;
            if (t == 1) { dm = db; }
            var d = 0 - AV1_MAX_ANGLE_DELTA;
            while (d <= AV1_MAX_ANGLE_DELTA) {
                if (d != 0) {
                    var jd = av1_enc_try_uv(tile, ec, blk, nb, dm, d);
                    if (jd < 0) { return 0 - jd; }
                    if (jd < best) { best = jd; bmode = dm; bdelta = d; }
                }
                d = d + 1;
            }
            t = t + 1;
        }
    }
    if (av1_cfl_allowed(bsize, load64(blk + AV1BLK_LOSSLESS), load64(tile + AV1TILE_SUBX),
        load64(tile + AV1TILE_SUBY))) {
        store64(mi + AV1MI_UVMODE, AV1_UV_CFL_PRED);
        store64(mi + AV1MI_ANGLE_UV, 0);
        var ju = av1_enc_cfl_alpha(tile, ec, blk, nb, 1, 0);
        if (ju < 0) { return 0 - ju; }
        var jv = av1_enc_cfl_alpha(tile, ec, blk, nb, 2, 1);
        if (jv < 0) { return 0 - jv; }
        if (load64(mi + AV1MI_CFL_V) != 0) {
            ju = av1_enc_cfl_alpha(tile, ec, blk, nb, 1, 1);
            if (ju < 0) { return 0 - ju; }
        }
        var jc = av1_enc_trial(tile, ec, blk, nb, 6);
        if (jc < 0) { return 0 - jc; }
        if (jc < best) {
            best = jc;
            bmode = AV1_UV_CFL_PRED;
            bdelta = 0;
            bu = load64(mi + AV1MI_CFL_U);
            bv = load64(mi + AV1MI_CFL_V);
        }
    }
    store64(mi + AV1MI_UVMODE, bmode);
    store64(mi + AV1MI_ANGLE_UV, bdelta);
    store64(mi + AV1MI_CFL_U, bu);
    store64(mi + AV1MI_CFL_V, bv);
    return DR_OK;
}

# The block's modes decided (when asked) — trials from the coefficient contexts as the block finds them — then the
# residual pass: the decoder's residual( ) over every plane, levels from av1_enc_tx_levels.
fn av1_enc_decide_residual(tile, ec, blk, nb, num_planes): i64 {
    var r = load64(blk + AV1BLK_MI_ROW);
    var c = load64(blk + AV1BLK_MI_COL);
    var mi = load64(blk + AV1BLK_MI);
    var decide = load64(ec + AV1EC_DECIDE);
    store64(ec + AV1EC_TXSEARCH, 0);             # mode trials at the largest transform, DCT_DCT
    if (decide != 0) {
        var bsize = load64(blk + AV1BLK_MI_SIZE);
        av1_enc_ctx_copy(tile, ec, r, c, av1_num_4x4_w(bsize), av1_num_4x4_h(bsize), num_planes, 1);
        if (decide & AV1ENC_DECIDE_YMODE) {
            var ey = av1_enc_pick_y(tile, ec, blk, nb);
            if (ey != DR_OK) { return ey; }
        }
        if (decide & (AV1ENC_DECIDE_TXSIZE | AV1ENC_DECIDE_TXTYPE)) {
            var etx = av1_enc_pick_tx(tile, ec, blk, nb);
            if (etx != DR_OK) { return etx; }
        }
        if ((num_planes > 1) && ((decide & AV1ENC_DECIDE_UVMODE) != 0)) {
            var euv = av1_enc_pick_uv(tile, ec, blk, nb);
            if (euv != DR_OK) { return euv; }
        }
    }
    var er = av1_enc_residual(tile, ec, blk, (1 << num_planes) - 1);
    av1_enc_log_block(r, c, mi, load64(blk + AV1BLK_TX_SIZE));
    return er;
}

# One block at (r, c) of size bsize — decode_block (5.11.5) run as an encoder: the modes decided (when asked), the
# residual pass, then the symbol pass (outside the block arena: the coder's word buffer grows into memory that must
# outlive the block).
fn av1_enc_block(tile, ec, r, c, bsize): i64 {
    var frame = load64(tile + AV1TILE_FRAME);
    var enc = load64(tile + AV1TILE_ENC);
    var ncc = load64(tile + AV1TILE_NCC);
    var subx = load64(tile + AV1TILE_SUBX);
    var suby = load64(tile + AV1TILE_SUBY);
    var bw4 = av1_num_4x4_w(bsize);
    var bh4 = av1_num_4x4_h(bsize);
    var has_chroma = av1_has_chroma(frame, r, c, bw4, bh4, subx, suby);
    var avail_u = av1_is_inside(tile, r - 1, c);
    var avail_l = av1_is_inside(tile, r, c - 1);
    var avail_uc = avail_u;
    var avail_lc = avail_l;
    if (has_chroma) {
        if (suby && (bh4 == 1)) { avail_uc = av1_is_inside(tile, r - 2, c); }
        if (subx && (bw4 == 1)) { avail_lc = av1_is_inside(tile, r, c - 2); }
    } else {
        avail_uc = 0;
        avail_lc = 0;
    }
    var nb = load64(ec + AV1EC_NB);
    var mi = load64(ec + AV1EC_MI);
    var blk = load64(ec + AV1EC_BLK);
    av1_enc_mi_reset(mi);                         # DC_PRED / DC_PRED, segment 0, no palette, no filter intra
    av1_block_neighbours(tile, r, c, avail_u, avail_l, nb);
    av1_tile_block_setup(tile, load64(tile + AV1TILE_SEG_FH), 0);
    var lossless = load64(tile + AV1TILE_CUR_LOSSLESS);
    var tx_size = 0;                              # TX_4X4 when lossless (read_block_tx_size codes nothing)
    if (lossless == 0) { tx_size = av1_max_tx_size_rect(bsize); }   # tx depth 0: the largest
    store64(blk + AV1BLK_MI_ROW, r);
    store64(blk + AV1BLK_MI_COL, c);
    store64(blk + AV1BLK_MI_SIZE, bsize);
    store64(blk + AV1BLK_HAS_CHROMA, has_chroma);
    store64(blk + AV1BLK_LOSSLESS, lossless);
    store64(blk + AV1BLK_TX_SIZE, tx_size);
    store64(blk + AV1BLK_MI, mi);
    store64(blk + AV1BLK_AVAIL_L, avail_l);
    store64(blk + AV1BLK_AVAIL_U, avail_u);
    store64(blk + AV1BLK_AVAIL_LC, avail_lc);
    store64(blk + AV1BLK_AVAIL_UC, avail_uc);
    store64(blk + AV1BLK_FILTER_TYPE, 0);
    store64(blk + AV1BLK_PLANE_SKIP, 0);
    var num_planes = 1;
    if (has_chroma) { num_planes = 3; }
    # ---- the decisions, then the residual pass, their scratch from the block arena ----
    var arena = load64(ec + AV1EC_ARENA);
    var prev = dr_alloc_scope(arena);
    var rerr = av1_enc_decide_residual(tile, ec, blk, nb, num_planes);
    dr_alloc_scope(prev);
    dr_arena_reset(arena);
    if (rerr != DR_OK) { return rerr; }
    var n = load64(ec + AV1EC_N);
    var recs = load64(ec + AV1EC_RECS);
    var skip = 1;
    var k = 0;
    while (k < n) {
        if (load64(recs + (k * AV1ER_SIZE) + AV1ER_EOB) != 0) { skip = 0; }
        k = k + 1;
    }
    store64(mi + AV1MI_SKIP, skip);
    # ---- the symbol pass: mode info, palette (none), tx size, then each transform block's coeffs( ) ----
    var eme = av1_enc_write_mode_info(tile, enc, blk, nb);
    if (eme != DR_OK) { return eme; }
    var pc = av1_tile_palctx(tile);
    var ewt = av1_write_palette_tokens(enc, ncc, pc, mi, bsize, r, c, subx, suby);
    if (ewt != DR_OK) { return ewt; }
    var eps = av1_pal_store(pc, mi, r, c, bw4, bh4);
    if (eps != DR_OK) { return eps; }
    var etx = av1_enc_write_tx_size(tile, enc, blk, nb);
    if (etx != DR_OK) { return etx; }
    if (skip) {
        av1_reset_block_context(tile, c, r, bw4, bh4, has_chroma);
    } else {
        var ecf = av1_enc_write_coeffs(tile, ec, enc);
        if (ecf != DR_OK) { return ecf; }
    }
    av1_block_write_grids(tile, r, c, bw4, bh4, bsize, load64(mi + AV1MI_YMODE), load64(mi + AV1MI_UVMODE), skip,
      load64(blk + AV1BLK_TX_SIZE), has_chroma, 1);
    return av1_sym_enc_err(enc);
}

# decode_partition (5.11.4) run as an encoder over the fixed decision: SPLIT above the target size, and SPLIT where a
# block's half would leave the frame (NONE is not codable there); NONE at the target. A BLOCK_8X8 is always inside
# (MiRows / MiCols are even), so the walk never goes below the target's floor of 8x8.
fn av1_enc_partition(tile, ec, r, c, bsize, target): i64 {
    var mi_cols = load64(tile + AV1TILE_COL_END);
    var mi_rows = load64(tile + AV1TILE_ROW_END);
    if ((r >= mi_rows) || (c >= mi_cols)) { return DR_OK; }
    var enc = load64(tile + AV1TILE_ENC);
    var ncc = load64(tile + AV1TILE_NCC);
    var avail_u = av1_is_inside(tile, r - 1, c);
    var avail_l = av1_is_inside(tile, r, c - 1);
    var half = av1_num_4x4_w(bsize) >> 1;
    var has_rows = 0;
    if ((r + half) < mi_rows) { has_rows = 1; }
    var has_cols = 0;
    if ((c + half) < mi_cols) { has_cols = 1; }
    var partition = AV1_PARTITION_NONE;
    if ((bsize > target) || ((has_rows == 0) || (has_cols == 0))) { partition = AV1_PARTITION_SPLIT; }
    if (bsize >= AV1ENC_BLOCK_8X8) {
        var ctx = av1_partition_ctx(tile, r, c, bsize, avail_u, avail_l);
        var bsl = av1_mi_width_log2(bsize);
        if (has_rows && has_cols) {
            av1_write_partition(enc, ncc, ctx, bsl, partition);
        } else {
            if (has_cols) {
                av1_write_split_or_horz(enc, ncc, ctx, bsl, 1);   # split_or_horz: SPLIT
            } else {
                if (has_rows) { av1_write_split_or_vert(enc, ncc, ctx, bsl, 1); }   # split_or_vert: SPLIT
            }
        }
    }
    if (partition == AV1_PARTITION_SPLIT) {
        var sub = av1_partition_subsize(AV1_PARTITION_SPLIT, bsize);
        av1_enc_partition(tile, ec, r, c, sub, target);
        av1_enc_partition(tile, ec, r, c + half, sub, target);
        av1_enc_partition(tile, ec, r + half, c, sub, target);
        return av1_enc_partition(tile, ec, r + half, c + half, sub, target);
    }
    var e = av1_enc_block(tile, ec, r, c, bsize);
    if (e != DR_OK) { av1_sym_enc_fail(enc, e); }   # latched: the recursion above drops returns
    return e;
}

# decode_tile (5.11.2) run as an encoder: the contexts it clears, then each superblock's partition (sbSize from the
# tile, which the decoder's setup gave use_128x128_superblock).
fn av1_enc_tile(tile, ec, target): i64 {
    var frame = load64(tile + AV1TILE_FRAME);
    var num_planes = dr_frame_num_planes(frame);
    var row_start = load64(tile + AV1TILE_ROW_START);
    var row_end = load64(tile + AV1TILE_ROW_END);
    var col_start = load64(tile + AV1TILE_COL_START);
    var col_end = load64(tile + AV1TILE_COL_END);
    var fmi_cols = load64(tile + AV1TILE_FMI_COLS);
    var fmi_rows = load64(tile + AV1TILE_FMI_ROWS);
    av1_clear_above_context(tile, num_planes);
    av1_dctx_tile_reset(av1_tile_dctx(tile));
    var cdef_grid = load64(tile + AV1TILE_CDEFIDX);
    var use128 = load64(tile + AV1TILE_SB128);
    var sb4 = AV1_SB4;
    var sb_bsize = AV1ENC_BLOCK_64X64;
    if (use128 != 0) {
        sb4 = AV1_SB4_128;
        sb_bsize = AV1ENC_BLOCK_128X128;
    }
    var r = row_start;
    while (r < row_end) {
        av1_clear_left_context(tile, num_planes);
        var c = col_start;
        while (c < col_end) {
            av1_dctx_sb_start(av1_tile_dctx(tile));
            if (cdef_grid != 0) { av1_clear_cdef(cdef_grid, fmi_cols, fmi_rows, r, c, use128); }
            av1_bd_clear(tile, r, c, sb4, num_planes);
            av1_enc_partition(tile, ec, r, c, sb_bsize, target);
            c = c + sb4;
        }
        r = r + sb4;
    }
    return av1_sym_enc_err(load64(tile + AV1TILE_ENC));
}

# Encode src (a DrFrame of any format drishti decodes: 1 or 3 planes, 8 / 10 / 12 bits, 4:2:0 / 4:2:2 / 4:4:4, at
# most 4096 samples wide in one tile) as one shown KEY_FRAME at base_q_idx (0..255; 0 = lossless), at 64x64
# superblocks (sb128 0) or 128x128 (sb128 1), in blocks of block_size (BLOCK_8X8, BLOCK_16X16, BLOCK_32X32,
# BLOCK_64X64, and BLOCK_128X128 at 128x128 superblocks), deciding what decide says (AV1ENC_DECIDE_* bits; 0 = DC_PRED
# everywhere, the 0.8.6 encoder byte for byte). Returns a temporal unit — temporal delimiter, sequence header OBU,
# frame OBU — with its byte length at *out_len, and at *out_recon the frame any conforming decoder outputs for it
# (cropped to src's size). 0 on error, DR_ERR_* at *out_err: BOUNDS for a bad argument, UNSUPPORTED for a frame needing
# more than one tile, OOM.
fn av1_encode_keyframe(src, base_q_idx, block_size, sb128, decide, out_len, out_recon, out_err): i64 {
    store64(out_len, 0);
    store64(out_recon, 0);
    store64(out_err, DR_OK);
    var bs_ok = 0;
    if ((block_size == AV1ENC_BLOCK_8X8) || (block_size == AV1ENC_BLOCK_16X16)
      || (block_size == AV1ENC_BLOCK_32X32) || (block_size == AV1ENC_BLOCK_64X64)) {
        bs_ok = 1;
    }
    if ((block_size == AV1ENC_BLOCK_128X128) && (sb128 == 1)) { bs_ok = 1; }
    if ((src == 0) || (bs_ok == 0) || ((sb128 != 0) && (sb128 != 1)) || ((decide & (0 - 16)) != 0)) {
        store64(out_err, DR_ERR_BOUNDS); return 0;
    }
    var np = dr_frame_num_planes(src);
    var mono = 0;
    var subx = dr_frame_subx(src);
    var suby = dr_frame_suby(src);
    if (np == 1) {
        mono = 1;
        subx = 1;
        suby = 1;
    } else {
        if (np != 3) { store64(out_err, DR_ERR_BOUNDS); return 0; }
    }
    var e = 0;
    var s = av1_seq_init(dr_frame_width(src), dr_frame_height(src), dr_frame_bit_depth(src), mono, subx, suby, &e);
    if (s == 0) { store64(out_err, e); return 0; }
    av1_seq_set_sb128(s, sb128);
    # filter intra is a luma candidate: its tool on when the luma mode is decided (0.8.6's header otherwise)
    if (decide & AV1ENC_DECIDE_YMODE) { store64(s + AV1_SEQ_ENABLE_FILTER_INTRA, 1); }
    var fh = av1_fh_init_key(s, base_q_idx, &e);
    if (fh == 0) { store64(out_err, e); return 0; }
    # the decoder's frame and tile
    var fdc = av1_frame_dec_new(s, fh, &e);
    if (fdc == 0) { store64(out_err, e); return 0; }
    var tile = av1_frame_tile_setup(fdc, 0, &e);
    if (tile == 0) { store64(out_err, e); return 0; }
    var ec = av1_enc_new(src, s, fh, decide);
    var ncc = av1_ncdf_new();
    var cc = av1_ccdf_new(av1_coeff_cdf_qbucket(base_q_idx));
    var enc = av1_sym_enc_init(4096, av1_fh_disable_cdf_update(fh));
    if ((ec == 0) || (ncc == 0) || (cc == 0) || (enc == 0)) { store64(out_err, DR_ERR_OOM); return 0; }
    store64(tile + AV1TILE_ENC, enc);
    store64(tile + AV1TILE_CC, cc);
    store64(tile + AV1TILE_NCC, ncc);
    store64(tile + AV1TILE_EKEY, ec);
    av1_enc_tile(tile, ec, block_size);
    store64(tile + AV1TILE_EKEY, 0);
    var tlen = 0;
    var tbytes = av1_sym_enc_finish(enc, &tlen);
    if (tbytes == 0) {
        e = av1_sym_enc_err(enc);
        if (e == DR_OK) { e = DR_ERR_OOM; }
        store64(out_err, e); return 0;
    }
    # the decoder's frame end (its in-loop filters are all off here): the picture a decoder outputs
    var recon = av1_frame_dec_finish(fdc, &e);
    if (recon == 0) { store64(out_err, e); return 0; }
    var tiles = dr_alloc(8);
    var sizes = dr_alloc(8);
    var bw = dr_bw_init(tlen + 64);
    if ((tiles == 0) || (sizes == 0) || (bw == 0)) { store64(out_err, DR_ERR_OOM); return 0; }
    store64(tiles, tbytes);
    store64(sizes, tlen);
    var rc = av1_td_write_obu(bw);
    if (rc == DR_OK) { rc = av1_seq_write_obu(bw, s); }
    if (rc == DR_OK) { rc = av1_frame_write_obu(bw, s, fh, 0, 0, 0, tiles, sizes); }
    if (rc != DR_OK) { store64(out_err, rc); return 0; }
    var n = dr_bw_flush(bw);
    if (dr_bw_err(bw) != DR_OK) { store64(out_err, dr_bw_err(bw)); return 0; }
    store64(out_len, n);
    store64(out_recon, recon);
    return dr_bw_buf(bw);
}

# av1_encode_keyframe as a standalone IVF file (DKIF, AV01, src's size, a 30 / 1 timebase, the one frame at pts 0).
fn av1_encode_keyframe_ivf(src, base_q_idx, block_size, sb128, decide, out_len, out_recon, out_err): i64 {
    store64(out_len, 0);
    var n = 0;
    var tu = av1_encode_keyframe(src, base_q_idx, block_size, sb128, decide, &n, out_recon, out_err);
    if (tu == 0) { return 0; }
    var iw = dr_ivf_writer_init(DR_FOURCC_AV01, dr_frame_width(src), dr_frame_height(src), 30, 1);
    if (iw == 0) { store64(out_err, DR_ERR_OOM); return 0; }
    var rc = dr_ivf_write_frame(iw, tu, n, 0);
    if (rc != DR_OK) { store64(out_err, rc); return 0; }
    var buf = dr_ivf_writer_finish(iw, out_len);
    if (buf == 0) { store64(out_err, DR_ERR_OOM); return 0; }
    return buf;
}
