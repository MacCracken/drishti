# src/av1_qm.cyr — AV1 quantizer matrices (spec 7.12.3 step 1b; the Quantizer_Matrix and Qm_Offset tables, 9.5.3).
#
# With using_qmatrix == 1, PlaneTxType < IDTX and SegQMLevel[ plane ][ segment_id ] < 15, the dequantiser scales
# each coefficient's quantizer step: q2 = Round2( q * Quantizer_Matrix[ SegQMLevel ][ plane > 0 ][ Qm_Offset[ txSz ]
# + i * tw + j ], 5 ) (7.12.3 step 1b; applied in src/av1_recon.cyr). SegQMLevel (5.9.2) is 15 for a LOSSLESS
# segment and qm_y / qm_u / qm_v otherwise; level 15 is the flat matrix and has no table row.
#
# STORAGE. The normative table is Quantizer_Matrix[15][2][QM_TOTAL_SIZE = 3344], 100,320 entries. drishti stores
# each (level, plane type)'s FUNDAMENTAL matrices and expands them once by the spec's own 9.5.2 subsampling
# (informative; dav1d derives the same way, libaom stores the full table):
#   tri[528]    the 32x32 matrix's lower triangle, row-major: for r in 0..31, for c in 0..r: M32[r][c]
#   m3216[512]  the 32x16 matrix (Tx_Width 32, Tx_Height 16), row-major: M3216[r][c] at r * 32 + c
# 1040 bytes per (level, plane type), 31,200 in all, hex-encoded below; every value lies in 30..242 (one byte).
# The packing relies on two facts of the table — every 32x32 is SYMMETRIC, every 16x32 is the TRANSPOSE of its
# 32x16 — and the expansion on the 9.5.2 derivation reproducing the table. scripts/refs/qm_ref.py proves all
# three over every one of the 100,320 entries, reading the spec markdown, and checks the spec table against
# libaom's iwt_matrix_ref. TRAP: libaom stores every region TRANSPOSED (spec [i][j] is its [j * th + i], to suit
# its transposed scans); the square regions hide that (symmetric), the rectangular ones differ at 48,538
# entries, so libaom's table copied into the spec's i * tw + j indexing mis-dequantises every rectangular tx.
# The fill lines are generated by `scripts/refs/qm_ref.py --emit`, never edited by hand.
#
# FLAT module (no includes) — wiring in src/main.cyr, after av1_quant.cyr. Family av1_ (av1_qm_*).

# Lazily built (cyrius global array literals do not initialise reliably), cached in global scalars:
var Av1_QmPacked = 0;   # 31,200 BYTES: the packed fundamentals (layout above)
var Av1_QmTbl = 0;      # 100,320 BYTES: Quantizer_Matrix[15][2][3344] at ((level * 2) + ptype) * 3344 + k
var Av1_QmOff = 0;      # Qm_Offset[19] (9.5.3), i64 slots (19 * 8 bytes)

# Qm_Offset[ TX_SIZES_ALL ] (9.5.3). Every size with a 64 dimension ALIASES its 32-clamped size's region (the
# matrix index runs over tw x th = Min(32, w) x Min(32, h) only, 7.12.3). -1 for a tx_size outside 0..18.
fn av1_qm_offset(tx_size): i64 {
    if ((tx_size < 0) || (tx_size > 18)) { return 0 - 1; }
    if (Av1_QmOff == 0) {
        var t = dr_alloc_keep(19 * 8);   # 19 i64 slots
        if (t == 0) { return 0 - 1; }
        store64(t + (0 * 8), 0);       store64(t + (1 * 8), 16);      store64(t + (2 * 8), 80);
        store64(t + (3 * 8), 336);     store64(t + (4 * 8), 336);     store64(t + (5 * 8), 1360);
        store64(t + (6 * 8), 1392);    store64(t + (7 * 8), 1424);    store64(t + (8 * 8), 1552);
        store64(t + (9 * 8), 1680);    store64(t + (10 * 8), 2192);   store64(t + (11 * 8), 336);
        store64(t + (12 * 8), 336);    store64(t + (13 * 8), 2704);   store64(t + (14 * 8), 2768);
        store64(t + (15 * 8), 2832);   store64(t + (16 * 8), 3088);   store64(t + (17 * 8), 1680);
        store64(t + (18 * 8), 2192);
        Av1_QmOff = t;
    }
    return load64(Av1_QmOff + (tx_size * 8));
}

# One lower-case hex digit's value (the fill strings are generated, so anything else is a corrupt literal: 0).
fn av1_qm_hexval(c): i64 {
    if ((c >= 48) && (c <= 57)) { return c - 48; }    # '0'..'9'
    if ((c >= 97) && (c <= 102)) { return c - 87; }   # 'a'..'f'
    return 0;
}

# Decode the NUL-terminated hex string s into bytes at t + off. Returns the byte count.
fn av1_qm_hex(t, off, s): i64 {
    var k = 0;
    while (load8(s + (k * 2)) != 0) {
        store8(t + off + k, (av1_qm_hexval(load8(s + (k * 2))) * 16) + av1_qm_hexval(load8(s + (k * 2) + 1)));
        k = k + 1;
    }
    return k;
}

# The fundamental matrix of a tw x th size's shape class (9.5.2), at row r / column c, from one (level, ptype)
# group pk of the packed blob: tw == th reads the 32x32 (symmetric: the lower triangle at max/min), tw > th the
# 32x16, tw < th the 16x32 (the 32x16 transposed: M1632[r][c] = M3216[c][r]).
fn av1_qm_fund(pk, tw, th, r, c): i64 {
    if (tw == th) {
        var hi = r;
        var lo = c;
        if (c > r) { hi = c; lo = r; }
        return load8(pk + ((hi * (hi + 1)) / 2) + lo);
    }
    if (tw > th) { return load8(pk + 528 + (r * 32) + c); }
    return load8(pk + 528 + (c * 32) + r);
}

# Quantizer_Matrix[15][2][3344] (9.5.3), expanded once from the packed fundamentals by the 9.5.2 subsampling:
# fundamental fW x fH by shape class; ratioW = fW / tw, ratioH = fH / th; phaseW = (ratioW + 1) / 2 - 1 (and H);
# derived[i * tw + j] = fundamental[ratioH * i + phaseH][ratioW * j + phaseW]. Only the 14 sizes with both
# dimensions <= 32 are expanded: their regions tile all 3344 entries, and a 64-dimension size aliases one of
# them (Qm_Offset). Returns the table, or 0 when an allocation fails.
fn av1_qm_table(): i64 {
    if (Av1_QmTbl != 0) { return Av1_QmTbl; }
    var pk = av1_qm_packed();
    if (pk == 0) { return 0; }
    # Qm_Offset is lazy too, and its failure is -1: built inside the loop below, a failed build wrote every region
    # one byte LOW (the first store at t - 1, outside the allocation) and cached the corrupt table (0.8.5, found
    # by OOM injection). Build it first; once built it cannot fail.
    if (av1_qm_offset(0) < 0) { return 0; }
    # the loop sizes regions by av1_tx_width / height, which read the transform tables UNCHECKED: built here at
    # frame-header time (before av1_tables_init), a failed build of those was a null dereference (0.8.5).
    if (av1_itx_tables() == 0) { return 0; }
    var t = dr_alloc_keep(15 * 2 * 3344);   # 100,320 BYTES
    if (t == 0) { return 0; }
    var g = 0;
    while (g < 30) {   # g = level * 2 + ptype
        var tx = 0;
        while (tx < 19) {
            var tw = av1_tx_width(tx);
            var th = av1_tx_height(tx);
            if ((tw <= 32) && (th <= 32)) {
                var fw = 32;
                var fh = 32;
                if (tw > th) { fh = 16; }
                if (tw < th) { fw = 16; }
                var rw = fw / tw;
                var rh = fh / th;
                var pw = ((rw + 1) / 2) - 1;
                var ph = ((rh + 1) / 2) - 1;
                var base = t + (g * 3344) + av1_qm_offset(tx);
                var i = 0;
                while (i < th) {
                    var j = 0;
                    while (j < tw) {
                        store8(base + (i * tw) + j, av1_qm_fund(pk + (g * 1040), tw, th, (rh * i) + ph, (rw * j) + pw));
                        j = j + 1;
                    }
                    i = i + 1;
                }
            }
            tx = tx + 1;
        }
        g = g + 1;
    }
    Av1_QmTbl = t;
    return t;
}

# SegQMLevel[ plane ][ segment_id ] (5.9.2), given LosslessArray[ segment_id ] as lossless: 15 for a lossless
# segment, else qm_y / qm_u / qm_v by plane. 15 (no matrix) when using_qmatrix is 0 — the 7.12.3 condition
# requires using_qmatrix == 1 anyway.
fn av1_qm_level(fh, plane, lossless): i64 {
    if (av1_fh_using_qmatrix(fh) == 0) { return 15; }
    if (lossless != 0) { return 15; }
    if (plane == 0) { return av1_fh_qm_y(fh); }
    if (plane == 1) { return av1_fh_qm_u(fh); }
    return av1_fh_qm_v(fh);
}

# The matrix 7.12.3 step 1b scales by, for a transform block of tx_size / PlaneTxType tx_type on plane, in a
# segment whose LosslessArray entry is lossless: a pointer to Quantizer_Matrix[ SegQMLevel ][ plane > 0 ]
# [ Qm_Offset[ txSz ] ] (tw * th bytes, row-major i * tw + j), or 0 when q2 == q (fh 0 — a bare test tile —,
# using_qmatrix 0, PlaneTxType >= IDTX — identity and 1D transforms are flat —, or level 15). -1 when the table
# cannot be allocated.
fn av1_qm_matrix(fh, plane, tx_size, tx_type, lossless): i64 {
    if (fh == 0) { return 0; }
    if ((tx_size < 0) || (tx_size > 18)) { return 0; }
    if ((tx_type < 0) || (tx_type >= AV1_IDTX)) { return 0; }
    var level = av1_qm_level(fh, plane, lossless);
    if (level >= 15) { return 0; }
    var t = av1_qm_table();
    if (t == 0) { return 0 - 1; }
    var ptype = 0;
    if (plane > 0) { ptype = 1; }
    return t + (((level * 2) + ptype) * 3344) + av1_qm_offset(tx_size);
}

# The packed fundamentals (layout in the header), generated by `scripts/refs/qm_ref.py --emit` from the spec's
# Quantizer_Matrix. Returns the blob, or 0 when the allocation fails.
fn av1_qm_packed(): i64 {
    if (Av1_QmPacked != 0) { return Av1_QmPacked; }
    var t = dr_alloc_keep(31200);   # 31,200 BYTES
    if (t == 0) { return 0; }
    # level 0, luma: 32x32 lower triangle (528) then 32x16 (512)
    av1_qm_hex(t, 0, "201f201f20201f2020201f2020212120202021222322222122232527232222232425292b24232223");
    av1_qm_hex(t, 40, "24262a2d302726252627282d2f32362c2a29292a2a2f32363a3f2e2c2a2b2c2c3134373b4143302e");
