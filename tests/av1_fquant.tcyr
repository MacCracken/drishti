# tests/av1_fquant.tcyr — the quantizer (src/av1_fquant.cyr): the encode lane's inverse of 7.12.3's dequantization.
#
# Every known answer comes from scripts/refs/quant_ref.py, which defines the quantizer in exact arithmetic, checks its
# properties over every qindex, bit depth and dqDenom, and checks it against libaom's own quantizer compiled from ref/
# (scripts/refs/quant_libaom.c) — never from this Cyrius; the block answers also run its forward transform port
# (scripts/refs/fwd_txfm_ref.py). Regenerate with
#   python3 scripts/refs/quant_ref.py --emit
# The values are seeded LCG blocks both sides compute alike: x = (x * 1103515245 + 12345) & (2^31 - 1), value
# ((x >> 8) % (2 * maxv + 1)) - maxv. D1 = sum (k + 1) * v[ k ], D2 = sum v[ k ]^2.
include "src/main.cyr"

var Fq_P = 0;       # Av1FQuant
var Fq_C = 0;       # 4096 i64: coefficients
var Fq_L = 0;       # 4096 i64: levels
var Fq_R = 0;       # 4096 i64: residual / dequantized
fn fq_bufs(): i64 {
    if (Fq_C == 0) {
        Fq_P = av1_fquant_new();
        Fq_C = alloc(4096 * 8);
        Fq_L = alloc(4096 * 8);
        Fq_R = alloc(4096 * 8);
    }
    return 0;
}
fn fq_lcg(buf, seed, count, maxv): i64 {
    var x = seed;
    var k = 0;
    while (k < count) {
        x = ((x * 1103515245) + 12345) & 2147483647;
        store64(buf + (k * 8), ((x >> 8) % ((2 * maxv) + 1)) - maxv);
        k = k + 1;
    }
    return 0;
}
fn fq_d1(buf, count): i64 {
    var s = 0;
    var k = 0;
    while (k < count) { s = s + ((k + 1) * load64(buf + (k * 8))); k = k + 1; }
    return s;
}
fn fq_d2(buf, count): i64 {
    var s = 0;
    var k = 0;
    while (k < count) { var v = load64(buf + (k * 8)); s = s + (v * v); k = k + 1; }
    return s;
}

# ---- one coefficient at a time: 64 values, c[0] with the DC step, the rest AC ----
fn fq_kat(bd, qi, d, d1, d2): i64 {
    av1_fquant_set(Fq_P, bd, qi, 0, 0);
    fq_lcg(Fq_C, ((1 + qi) + (1000 * d)) + (7 * bd), 64, 1 << (6 + bd));
    var zf = av1_fquant_default_zbin(bd, qi);
    var rf = av1_fquant_default_round(qi);
    var k = 0;
    while (k < 64) {
        var s = av1_fquant_ac_q(Fq_P);
        if (k == 0) { s = av1_fquant_dc_q(Fq_P); }
        store64(Fq_L + (k * 8), av1_quantize_coeff(load64(Fq_C + (k * 8)), s, d, bd, zf, rf));
        k = k + 1;
    }
    assert_eq(fq_d1(Fq_L, 64), d1, "levels: positions digest");
    assert_eq(fq_d2(Fq_L, 64), d2, "levels: energy digest");
    return 0;
}
