# ---- whole blocks: a residual through the forward transform and the quantizer, every size ----
fn fq_blk(t, bd, qi, d1, d2, nz): i64 {
    var w = 1 << av1_tx_width_log2(t);
    var h = 1 << av1_tx_height_log2(t);
    var n = av1_min(32, w) * av1_min(32, h);
    fq_lcg(Fq_R, 3 + t, w * h, (1 << bd) - 1);
    assert_eq(av1_forward_transform_2d(Fq_R, Fq_C, t, AV1_DCT_DCT, 0), DR_OK, "forward transform");
    av1_fquant_set(Fq_P, bd, qi, 0, 0);
    var got_nz = 0 - 1;
    assert_eq(av1_quantize_block(Fq_C, Fq_L, t, Fq_P, 0, &got_nz), DR_OK, "quantize block");
    assert_eq(fq_d1(Fq_L, n), d1, "block levels (tw x th, stride tw): positions digest");
    assert_eq(fq_d2(Fq_L, n), d2, "block levels: energy digest");
    assert_eq(got_nz, nz, "block levels: the nonzero count");
    return 0;
}
