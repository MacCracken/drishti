# ---- the default factors (libaom's): 64 / 64 at qindex 0; the dead zone 84 until dc_q reaches 148 / 592 / 2368 ----
fn test_fq_factors() {
    assert_eq(av1_fquant_default_zbin(8, 0), 64, "qindex 0: zbin 64");
    assert_eq(av1_fquant_default_round(0), 64, "qindex 0: round 64");
    assert_eq(av1_fquant_default_round(1), 48, "qindex 1: round 48");
    # (no 8-bit dc_q is 147, so a threshold of 147 is indistinguishable from 148; 149 is not: qindex 132 below)
    assert_eq(av1_fquant_default_zbin(8, 131), 84, "8-bit qindex 131 (dc_q 146): 84");
    assert_eq(av1_fquant_default_zbin(8, 132), 80, "8-bit qindex 132 (dc_q 148): 80");
    assert_eq(av1_fquant_default_zbin(10, 131), 84, "10-bit qindex 131 (dc_q 584): 84");
    assert_eq(av1_fquant_default_zbin(10, 132), 80, "10-bit qindex 132 (dc_q 592): 80");
    assert_eq(av1_fquant_default_zbin(12, 132), 84, "12-bit qindex 132 (dc_q 2367): 84");
    assert_eq(av1_fquant_default_zbin(12, 133), 80, "12-bit qindex 133 (dc_q 2400): 80");
    fq_bufs();
    assert_eq(av1_fquant_set(Fq_P, 8, 100, 0, 0), DR_OK, "set 8-bit qindex 100");
    assert_eq(av1_fquant_dc_q(Fq_P), av1_dc_q(8, 100), "the DC step is get_dc_quant");
    assert_eq(av1_fquant_set(Fq_P, 8, 100, 3, 0 - 5), DR_OK, "with plane deltas");
    assert_eq(av1_fquant_dc_q(Fq_P), av1_dc_q(8, 103), "DC step at qindex + DC delta (7.12.2)");
    assert_eq(av1_fquant_ac_q(Fq_P), av1_ac_q(8, 95), "AC step at qindex + AC delta");
    return 0;
}

# ---- properties, against the DECODER's own dequantization (av1_dequant_coeff, 7.12.3 steps 1c-1f) ----
fn test_fq_properties() {
    var bad_sym = 0;
    var bad_mono = 0;
    var bad_dz = 0;
    var bad_err = 0;
    var bad_cap = 0;
    var bd = 8;
    while (bd <= 12) {
        var qi = 0;
        while (qi < 256) {
            var d = 1;
            while (d <= 4) {
                var s = av1_ac_q(bd, qi);
                var zf = av1_fquant_default_zbin(bd, qi);
                var rf = av1_fquant_default_round(qi);
                var ls = av1_fquant_log2d(d);
                var zb = av1_round2(av1_round2(zf * s, 7), ls);
                var rd = av1_round2((rf * s) >> 7, ls);
                var bound = zb;
                if ((((s + d) - 1) / d) - rd + 1 > bound) { bound = ((((s + d) - 1) / d) - rd) + 1; }
                if (rd + 1 > bound) { bound = rd + 1; }
                var top = (((1 << (7 + bd)) * d) - 1) / s;
                var prev = 0;
                var x = 0;
                while (x <= ((3 * s) / d) + 2) {
                    var lv = av1_quantize_coeff(x, s, d, bd, zf, rf);
                    if (av1_quantize_coeff(0 - x, s, d, bd, zf, rf) != (0 - lv)) { bad_sym = bad_sym + 1; }
                    if (lv < prev) { bad_mono = bad_mono + 1; }
                    if ((x < zb) && (lv != 0)) { bad_dz = bad_dz + 1; }
                    var e = av1_dequant_coeff(lv, s, d, bd) - x;
                    if (e < 0) { e = 0 - e; }
                    if (e > bound) { bad_err = bad_err + 1; }
                    prev = lv;
                    x = x + 1;
                }
                # the cap: far past the clamp, the level is Lmax, which the decoder neither clamps nor wraps
                var big = av1_quantize_coeff(1 << (9 + bd), s, d, bd, zf, rf);
                var clamped = av1_dequant_coeff(top, s, d, bd) > ((1 << (7 + bd)) - 1);
                if ((big != top) || clamped || ((top * s) >= 16777216)) {
                    bad_cap = bad_cap + 1;
                }
                d = d * 2;
            }
            qi = qi + 1;
        }
        bd = bd + 2;
    }
    assert_eq(bad_sym, 0, "symmetric: quantize( -c ) = -quantize( c )");
    assert_eq(bad_mono, 0, "non-decreasing in |c|");
    assert_eq(bad_dz, 0, "0 inside the dead zone");
    assert_eq(bad_err, 0, "|Dequant( quantize( c ) ) - c| within the bound the definition implies");
    assert_eq(bad_cap, 0, "the cap: Lmax, never clamped or wrapped by the decoder");
    return 0;
}

# ---- a quantizer matrix: each position's step is the decoder's Round2( q * qm, 5 ) ----
fn test_fq_qm() {
    fq_bufs();
    var t = AV1_TX_8X8;
    fq_lcg(Fq_R, 77, 64, 255);
    av1_forward_transform_2d(Fq_R, Fq_C, t, AV1_DCT_DCT, 0);
    av1_fquant_set(Fq_P, 8, 90, 0, 0);
    var qm = av1_qm_table() + ((4 * 2) * 3344) + av1_qm_offset(t);   # level 4, luma: a sloped matrix
    assert_eq(av1_quantize_block(Fq_C, Fq_L, t, Fq_P, qm, 0), DR_OK, "quantize with a matrix");
    memset(Fq_R, 0, 64 * 8);
    av1_dequant_block(Fq_L, Fq_R, t, av1_fquant_dc_q(Fq_P), av1_fquant_ac_q(Fq_P), qm, 8);
    var off = 0;
    var flat_off = 0;
    var k = 0;
    while (k < 64) {
        var s = av1_fquant_ac_q(Fq_P);
        if (k == 0) { s = av1_fquant_dc_q(Fq_P); }
        var s2 = ((s * load8(qm + k)) + 16) >> 5;
        var e = load64(Fq_R + (k * 8)) - load64(Fq_C + (k * 8));
        if (e < 0) { e = 0 - e; }
        if (e > s2) { off = off + 1; }                                  # within one weighted step: the matrix used
        if (load64(Fq_L + (k * 8)) != av1_quantize_coeff(load64(Fq_C + (k * 8)), s2, 1, 8,
            av1_fquant_default_zbin(8, 90), 48)) {
            flat_off = flat_off + 1;
        }
        k = k + 1;
    }
    assert_eq(off, 0, "every dequantized value within its weighted step of the coefficient");
    assert_eq(flat_off, 0, "every level is the coefficient quantized at the decoder's weighted step");
    return 0;
}

# ---- end to end through the DECODER: lossless is exact; lossy error falls as qindex falls ----
fn fq_frame(bd): i64 {
    var e = 0;
    var f = dr_frame_new(64, 64, 1, 0, 0, bd, 0, &e);
    return f;
}
fn fq_fill(f, v): i64 {
    var y = 0;
    while (y < 64) {
        var x = 0;
        while (x < 64) { dr_frame_set(f, 0, x, y, v); x = x + 1; }
        y = y + 1;
    }
    return 0;
}
fn test_fq_lossless_e2e() {
    fq_bufs();
    var bad = 0;
    var bd = 8;
    while (bd <= 12) {
        var f = fq_frame(bd);
        var mid = 1 << (bd - 1);
        var b = 0;
        while (b < 200) {
            fq_fill(f, mid);
            fq_lcg(Fq_R, 300 + b + (bd * 1000), 16, mid - 1);
            av1_forward_transform_2d(Fq_R, Fq_C, AV1_TX_4X4, AV1_DCT_DCT, 1);
            av1_fquant_set(Fq_P, bd, 0, 0, 0);
            av1_quantize_block(Fq_C, Fq_L, AV1_TX_4X4, Fq_P, 0, 0);
            av1_reconstruct(f, 0, 0, 0, AV1_TX_4X4, AV1_DCT_DCT, 1, Fq_L, 4, 4);
            var k = 0;
            while (k < 16) {
                if (dr_frame_get(f, 0, k % 4, k / 4) != (mid + load64(Fq_R + (k * 8)))) { bad = bad + 1; }
                k = k + 1;
            }
            b = b + 1;
        }
        bd = bd + 2;
    }
    assert_eq(bad, 0, "600 lossless blocks: forward WHT -> quantize at qindex 0 -> av1_reconstruct, exact");
    return 0;
}
fn fq_sse(t, qi): i64 {
    var f = fq_frame(8);
    fq_fill(f, 128);
    var w = 1 << av1_tx_width_log2(t);
    var h = 1 << av1_tx_height_log2(t);
    fq_lcg(Fq_R, 55, w * h, 100);
    av1_forward_transform_2d(Fq_R, Fq_C, t, AV1_DCT_DCT, 0);
    av1_fquant_set(Fq_P, 8, qi, 0, 0);
    av1_quantize_block(Fq_C, Fq_L, t, Fq_P, 0, 0);
    av1_reconstruct(f, 0, 0, 0, t, AV1_DCT_DCT, 0, Fq_L, av1_fquant_dc_q(Fq_P), av1_fquant_ac_q(Fq_P));
    var sse = 0;
    var i = 0;
    while (i < h) {
        var j = 0;
        while (j < w) {
            var dd = dr_frame_get(f, 0, j, i) - (128 + load64(Fq_R + (((i * w) + j) * 8)));
            sse = sse + (dd * dd);
            j = j + 1;
        }
        i = i + 1;
    }
    return sse;
}
fn test_fq_lossy_e2e() {
    fq_bufs();
    var sizes = alloc(3 * 8);
    store64(sizes, AV1_TX_8X8);
    store64(sizes + 8, AV1_TX_32X32);
    store64(sizes + 16, AV1_TX_64X64);
    var s = 0;
    while (s < 3) {
        var t = load64(sizes + (s * 8));
        var a = fq_sse(t, 4);
        var b = fq_sse(t, 60);
        var c = fq_sse(t, 200);
        assert(a < b, "reconstruction error at qindex 4 below qindex 60");
        assert(b < c, "...and qindex 60 below qindex 200");
        s = s + 1;
    }
    # a fine step reconstructs a sub-64 block to within a few levels per sample (the sum over 64 samples is small)
    assert(fq_sse(AV1_TX_8X8, 1) < 64 * 4, "8x8 at qindex 1: mean squared error under 4");
    return 0;
}

# ---- refusals ----
fn test_fq_refusals() {
    fq_bufs();
    assert_eq(av1_fquant_set(Fq_P, 9, 10, 0, 0), DR_ERR_BOUNDS, "bit depth 9");
    assert_eq(av1_fquant_set(Fq_P, 8, 256, 0, 0), DR_ERR_BOUNDS, "qindex 256");
    assert_eq(av1_fquant_set(Fq_P, 8, 0 - 1, 0, 0), DR_ERR_BOUNDS, "qindex -1");
    assert_eq(av1_fquant_set_factors(Fq_P, 129, 64), DR_ERR_BOUNDS, "zbin factor 129");
    assert_eq(av1_fquant_set_factors(Fq_P, 128, 128), DR_OK, "factors of 128 (a whole step) are accepted");
    assert_eq(av1_fquant_set_factors(Fq_P, 0, 0), DR_OK, "factors of 0 are accepted");
    assert_eq(av1_fquant_set_factors(Fq_P, 64, 0 - 1), DR_ERR_BOUNDS, "round factor -1");
    av1_fquant_set(Fq_P, 8, 10, 0, 0);
    assert_eq(av1_quantize_block(Fq_C, Fq_L, 19, Fq_P, 0, 0), AV1_ERR_BAD_TX, "tx_size 19");
    assert_eq(av1_quantize_block(Fq_C, Fq_L, 0 - 1, Fq_P, 0, 0), AV1_ERR_BAD_TX, "tx_size -1");
    # nearest rounding (64 / 64) recovers every level from its own reconstruction at D = 1
    assert_eq(av1_fquant_set_factors(Fq_P, 64, 64), DR_OK, "round-to-nearest factors");
    var lost = 0;
    var lv = 0 - 300;
    while (lv <= 300) {
        var x = av1_dequant_coeff(lv, 52, 1, 8);
        if (av1_quantize_coeff(x, 52, 1, 8, 64, 64) != lv) { lost = lost + 1; }
        lv = lv + 1;
    }
    assert_eq(lost, 0, "nearest rounding: quantize( Dequant( L ) ) = L for every L in -300..300");
    return 0;
}

# ---- memory: the record is the only allocation; quantizing allocates nothing ----
fn fq_sweep_op(arg): i64 {
    return av1_quantize_block(Fq_C, Fq_L, arg, Fq_P, 0, 0);
}
fn test_fq_oom() {
    dr_alloc_fail_at(1);
    assert_eq(av1_fquant_new(), 0, "the record cannot be allocated: 0");
    dr_alloc_fail_at(0);
    fq_bufs();
    av1_fquant_set(Fq_P, 8, 60, 0, 0);
    var n = 0 - 1;
    assert_eq(dr_alloc_sweep(&fq_sweep_op, AV1_TX_64X64, &n), 0, "the OOM sweep over a 64x64 block holds");
    assert_eq(n, 0, "quantizing allocates nothing");
    return 0;
}

fn main() {
    alloc_init();
    if (av1_tables_init() != DR_OK) { return 1; }
    test_group("quantizer: OOM");
    test_fq_oom();
    test_group("quantizer: libaom's default factors, the Qlookup steps");
    test_fq_factors();
    test_group("quantizer: known answers (the port)");
    test_fq_coeff_kats();
    test_fq_block_kats();
    test_group("quantizer: properties against the decoder's dequantization");
    test_fq_properties();
    test_fq_qm();
    test_group("quantizer: end to end through av1_reconstruct");
    test_fq_lossless_e2e();
    test_fq_lossy_e2e();
    test_group("quantizer: refusals and nearest rounding");
    test_fq_refusals();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
