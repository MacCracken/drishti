# tests/av1_lst.tcyr — AV1 large scale tile decoding (spec 7.3, the tile list OBU of 5.12 / 6.11; src/av1_lst.cyr).
#
# The end-to-end decode is make conformance's large-scale tile section: libaom's lightfield tools encode, re-pack and
# decode the same streams, and drishti matches its YUV1D output on every anchor and tile list. This suite pins the
# pieces whose correctness that cannot isolate: the tile_list_obu parse and every limit (6.11.1 / 7.3.1), the raster
# placement, the uniform-tile rule, the per-entry grid window reset, every refusal of av1_decode_tile_list (checked
# before anything is allocated), the decoder's mode dispatch, and the scratch reference slot's re-description of a
# stale slot (which no real stream exercises). Expected values are derived from the spec text in
# the comments, and the parse and placement ones are asserted by scripts/refs/lst_ref.py.
include "src/main.cyr"

# a tile list payload builder: bytes appended at Lb_Pos in Lb_Buf
var Lb_Buf = 0;
var Lb_Pos = 0;
fn lb_reset(): i64 { Lb_Buf = alloc(8192); Lb_Pos = 0; return 0; }
fn lb_u8(v): i64 { store8(Lb_Buf + Lb_Pos, v & 255); Lb_Pos = Lb_Pos + 1; return 0; }
fn lb_u16(v): i64 { lb_u8(v >> 8); lb_u8(v); return 0; }
fn lb_entry(anchor, row, col, nbytes, fill): i64 {
    lb_u8(anchor); lb_u8(row); lb_u8(col); lb_u16(nbytes - 1);
    var i = 0;
    while (i < nbytes) { lb_u8(fill + i); i = i + 1; }
    return 0;
}

# ---- tile_list_obu() (5.12) and its limits ----
fn test_lst_parse() {
    lb_reset();
    lb_u8(1); lb_u8(1); lb_u16(2);           # a 2 x 2-tile output frame, tile_count_minus_1 = 2
    lb_entry(5, 1, 0, 2, 170);               # anchor 5, row 1, col 0, 2 bytes (170, 171)
    lb_entry(7, 0, 1, 1, 204);               # anchor 7, row 0, col 1, 1 byte
    lb_entry(0, 2, 3, 3, 1);                 # anchor 0, row 2, col 3, 3 bytes
    var e = 0;
    var tl = av1_tile_list_parse(Lb_Buf, Lb_Pos, &e);
    assert_eq(e, DR_OK, "parse: three entries");
    assert_eq(load64(tl + AV1TL_OUT_W), 2, "output_frame_width_in_tiles");
    assert_eq(load64(tl + AV1TL_OUT_H), 2, "output_frame_height_in_tiles");
    assert_eq(load64(tl + AV1TL_COUNT), 3, "tile_count");
    var e0 = av1_tile_list_entry(tl, 0);
    var e1 = av1_tile_list_entry(tl, 1);
    var e2 = av1_tile_list_entry(tl, 2);
    assert_eq(load64(e0 + AV1TLE_ANCHOR), 5, "entry 0 anchor_frame_idx");
    assert_eq(load64(e0 + AV1TLE_ROW), 1, "entry 0 anchor_tile_row");
    assert_eq(load64(e0 + AV1TLE_COL), 0, "entry 0 anchor_tile_col");
    assert_eq(load64(e0 + AV1TLE_DATA), 9, "entry 0 data after the 4-byte list header + 5-byte entry header");
    assert_eq(load64(e0 + AV1TLE_DSIZE), 2, "entry 0 tile_data_size_minus_1 + 1");
    assert_eq(load8(Lb_Buf + load64(e0 + AV1TLE_DATA) + 1), 171, "entry 0 second data byte");
    assert_eq(load64(e1 + AV1TLE_DATA), 16, "entry 1 data: 9 + 2 + 5");
    assert_eq(load64(e1 + AV1TLE_ANCHOR), 7, "entry 1 anchor_frame_idx");
    assert_eq(load64(e2 + AV1TLE_DATA), 22, "entry 2 data: 16 + 1 + 5");
    assert_eq(load64(e2 + AV1TLE_DSIZE), 3, "entry 2 size");
    assert_eq(load64(e2 + AV1TLE_COL), 3, "entry 2 anchor_tile_col");
    # the limits
    assert_eq(av1_tile_list_parse(Lb_Buf, 3, &e), 0, "3 bytes: no list header");
    assert_eq(e, DR_ERR_TRUNCATED, "...DR_ERR_TRUNCATED");
    assert_eq(av1_tile_list_parse(Lb_Buf, 24, &e), 0, "the last tile's data one byte short");
    assert_eq(e, DR_ERR_TRUNCATED, "...DR_ERR_TRUNCATED");
    assert_eq(av1_tile_list_parse(Lb_Buf, 19, &e), 0, "the last entry header cut");
    assert_eq(e, DR_ERR_TRUNCATED, "...DR_ERR_TRUNCATED");
    assert_eq(av1_tile_list_parse(Lb_Buf, 20, &e), 0, "the last entry header whole, its data absent");
    assert_eq(e, DR_ERR_TRUNCATED, "...DR_ERR_TRUNCATED");
    lb_reset();
    lb_u8(1); lb_u8(1); lb_u16(4);           # 5 tiles into a 2 x 2 output frame
    var k = 0;
    while (k < 5) { lb_entry(0, 0, 0, 1, 0); k = k + 1; }
    assert_eq(av1_tile_list_parse(Lb_Buf, Lb_Pos, &e), 0, "more tiles than the output frame holds (7.3.1)");
    assert_eq(e, DR_ERR_BAD_HEADER, "...DR_ERR_BAD_HEADER");
    lb_reset();
    lb_u8(255); lb_u8(255); lb_u16(512);     # tile_count_minus_1 = 512 (6.11.1 allows 511)
    assert_eq(av1_tile_list_parse(Lb_Buf, 4096, &e), 0, "tile_count_minus_1 512");
    assert_eq(e, DR_ERR_BAD_HEADER, "...DR_ERR_BAD_HEADER");
    lb_reset();
    lb_u8(31); lb_u8(15); lb_u16(511);       # exactly 512 tiles of 1 byte into a 32 x 16 output: the limit itself
    k = 0;
    while (k < 512) { lb_entry(k & 127, 0, 0, 1, 0); k = k + 1; }
    var tl2 = av1_tile_list_parse(Lb_Buf, Lb_Pos, &e);
    assert_eq(e, DR_OK, "512 tiles parse");
    assert_eq(load64(tl2 + AV1TL_COUNT), 512, "...count 512");
    return 0;
}

# ---- raster placement (7.3.1): destX = TileWidth * (tile % W), destY = TileHeight * (tile / W), chroma >> sub ----
fn test_lst_dest() {
    assert_eq(av1_lst_dest_x(0, 3, 64, 0), 0, "tile 0 x");
    assert_eq(av1_lst_dest_y(0, 3, 64, 0), 0, "tile 0 y");
    assert_eq(av1_lst_dest_x(4, 3, 64, 0), 64, "tile 4 of 3 across: column 1");
    assert_eq(av1_lst_dest_y(4, 3, 64, 0), 64, "tile 4 of 3 across: row 1");
    assert_eq(av1_lst_dest_x(5, 3, 64, 0), 128, "tile 5: column 2");
    assert_eq(av1_lst_dest_y(7, 3, 128, 0), 256, "tile 7, 128 high: row 2");
    assert_eq(av1_lst_dest_x(4, 3, 64, 1), 32, "tile 4 chroma (4:2:0): x 32");
    assert_eq(av1_lst_dest_y(4, 3, 64, 1), 32, "tile 4 chroma: y 32");
    assert_eq(av1_lst_dest_x(63, 8, 64, 0), 448, "the last of 64 tiles in an 8 x 8 output: x 448");
    assert_eq(av1_lst_dest_y(63, 8, 64, 0), 448, "...y 448");
    assert_eq(av1_lst_dest_x(63, 8, 64, 1), 224, "...chroma x 224");
    assert_eq(av1_lst_dest_y(63, 8, 64, 1), 224, "...chroma y 224");
    return 0;
}

# ---- the uniform-tile rule ----
fn lst_fh(cols, rows): i64 {
    var fh = alloc(AV1FH_SIZE);
    memset(fh, 0, AV1FH_SIZE);
    store64(fh + AV1FH_TILE_COLS, cols);
    store64(fh + AV1FH_TILE_ROWS, rows);
    var i = 0;
    while (i <= cols) { store64(fh + AV1FH_MI_COL_STARTS + (i * 8), i * 16); i = i + 1; }
    i = 0;
    while (i <= rows) { store64(fh + AV1FH_MI_ROW_STARTS + (i * 8), i * 16); i = i + 1; }
    return fh;
}
fn test_lst_uniform() {
    var fh = lst_fh(4, 2);
    assert_eq(av1_lst_uniform_tile_w4(fh), 16, "four 16-MI columns");
    assert_eq(av1_lst_uniform_tile_h4(fh), 16, "two 16-MI rows");
    store64(fh + AV1FH_MI_COL_STARTS + (4 * 8), 60);   # the last column 12 MI wide
    assert_eq(av1_lst_uniform_tile_w4(fh), 0 - 1, "a narrower last column is not uniform");
    store64(fh + AV1FH_MI_ROW_STARTS + (2 * 8), 40);   # the second row 24 MI high
    assert_eq(av1_lst_uniform_tile_h4(fh), 0 - 1, "a taller row is not uniform");
    return 0;
}

# ---- the per-entry grid window reset ----
fn test_lst_reset_window() {
    var e = 0;
    var frame = dr_frame_new(128, 128, 3, 1, 1, 8, 0, &e);
    var tile = av1_tile_new(frame, 32, 32, 40, 0, 0, 3);
    av1_tile_set_frame_mi(tile, 32, 32);
    av1_tile_grids_new(tile);
    store64(tile + AV1TILE_MVGRID, av1_mv_grid_new(32, 32));
    var sm = alloc(32 * 32 * 8);   # 32 x 32 i64
    store64(tile + AV1TILE_SKIPMODES, sm);
    var r = 0;
    while (r < 32) {
        var c = 0;
        while (c < 32) {
            av1_grid_set(tile, AV1TILE_YMODES, r, c, 7);
            av1_grid_set(tile, AV1TILE_SKIPS, r, c, 1);
            av1_grid_set(tile, AV1TILE_PALPTR, r, c, 99);
            av1_grid_set(tile, AV1TILE_LFTX + 8, r, c, 3);
            av1_cdefidx_set(tile, r, c, 5);
            store64(sm + (((r * 32) + c) * 8), 1);
            store64(av1_mv_grid_cell(load64(tile + AV1TILE_MVGRID), 32, r, c) + AV1MIR_AVAIL, 1);
            store64(av1_mv_grid_cell(load64(tile + AV1TILE_MVGRID), 32, r, c) + AV1MIR_MV0ROW, 0 - 40);
            c = c + 1;
        }
        r = r + 1;
    }
    # the window rows 8..15, columns 16..31 (luma MI); 4:2:0
    assert_eq(av1_tile_grids_reset_window(tile, 8, 16, 16, 32, 1, 1), DR_OK, "reset");
    assert_eq(av1_grid_get(tile, AV1TILE_YMODES, 8, 16), 0, "inside: YModes 0");
    assert_eq(av1_grid_get(tile, AV1TILE_YMODES, 15, 31), 0, "inside, far corner: 0");
    assert_eq(av1_grid_get(tile, AV1TILE_SKIPS, 12, 20), 0, "inside: Skips 0");
    assert_eq(av1_grid_get(tile, AV1TILE_PALPTR, 12, 20), 0, "inside: the palette pointer 0");
    assert_eq(av1_cdefidx_get(tile, 8, 16), 0 - 1, "inside: CdefIdx -1 (read_cdef reads again)");
    assert_eq(load64(sm + (((10 * 32) + 18) * 8)), 0, "inside: SkipModes 0");
    var cell = av1_mv_grid_cell(load64(tile + AV1TILE_MVGRID), 32, 9, 17);
    assert_eq(load64(cell + AV1MIR_AVAIL), 0, "inside: the MV grid's decoded marker cleared");
    assert_eq(load64(cell + AV1MIR_MV0ROW), 0, "inside: the MV cleared");
    assert_eq(av1_grid_get(tile, AV1TILE_YMODES, 7, 16), 7, "the row above the window untouched");
    assert_eq(av1_grid_get(tile, AV1TILE_YMODES, 8, 15), 7, "the column left of it untouched");
    assert_eq(av1_grid_get(tile, AV1TILE_YMODES, 16, 16), 7, "the row below untouched");
    assert_eq(av1_cdefidx_get(tile, 16, 31), 5, "CdefIdx below untouched");
    assert_eq(load64(av1_mv_grid_cell(load64(tile + AV1TILE_MVGRID), 32, 8, 15) + AV1MIR_AVAIL), 1,
      "the MV marker left of it untouched");
    # chroma LoopfilterTxSizes: plane-MI window rows 4..7, columns 8..15
    assert_eq(av1_lftx_get(tile, 1, 4, 8), 0, "chroma lf tx size: inside the subsampled window");
    assert_eq(av1_lftx_get(tile, 1, 7, 15), 0, "...its far corner");
    assert_eq(av1_lftx_get(tile, 1, 3, 8), 3, "...the row above it untouched");
    assert_eq(av1_lftx_get(tile, 1, 4, 7), 3, "...the column left of it untouched");
    assert_eq(av1_lftx_get(tile, 1, 8, 16), 3, "...the luma window's own cell is outside the chroma one");
    return 0;
}

# ---- av1_decode_tile_list refusals: all checked before anything is decoded or allocated ----
fn lst_seq(film_grain): i64 {
    var s = alloc(AV1_SEQ_SIZE);
    memset(s, 0, AV1_SEQ_SIZE);
    store64(s + AV1_SEQ_NUM_PLANES, 3);
    store64(s + AV1_SEQ_SUBX, 1);
    store64(s + AV1_SEQ_SUBY, 1);
    store64(s + AV1_SEQ_BITDEPTH, 8);
    store64(s + AV1_SEQ_FILM_GRAIN_PRESENT, film_grain);
    return s;
}
# a 128x64 camera header: two 16-MI tile columns, one row (TileWidth 64, TileHeight 64)
fn lst_cam(): i64 {
    var fh = lst_fh(2, 1);
    store64(fh + AV1FH_FRAME_TYPE, AV1_INTER_FRAME);
    store64(fh + AV1FH_SHOW_FRAME, 1);
    store64(fh + AV1FH_FRAME_WIDTH, 128);
    store64(fh + AV1FH_UPSCALED_WIDTH, 128);
    store64(fh + AV1FH_FRAME_HEIGHT, 64);
    store64(fh + AV1FH_MI_COLS, 32);
    store64(fh + AV1FH_MI_ROWS, 16);
    return fh;
}
fn lst_one_entry(anchor, row, col): i64 {
    lb_reset();
    lb_u8(1); lb_u8(0); lb_u16(0);   # a 2 x 1 output, one tile
    lb_entry(anchor, row, col, 4, 0);
    return 0;
}
fn lst_try(dec, tag, want): i64 {
    var e = 0;
    assert_eq(av1_decode_tile_list(dec, Lb_Buf, Lb_Pos, &e), 0, tag);
    assert_eq(e, want, tag);
    return 0;
}
fn test_lst_refusals() {
    var dec = av1_decoder_new(0);
    store64(dec + AV1DEC_SEQ, lst_seq(0));
    lst_one_entry(0, 0, 1);
    lst_try(dec, "no camera frame header", DR_ERR_BAD_HEADER);
    var fh = lst_cam();
    store64(dec + AV1DEC_CAMFH, fh);
    lst_try(dec, "no anchors set", DR_ERR_BAD_HEADER);
    var e = 0;
    var good = dr_frame_new(128, 64, 3, 1, 1, 8, 0, &e);
    assert_eq(av1_decoder_set_anchor(dec, 0, good), DR_OK, "anchor 0 set");
    lst_one_entry(1, 0, 1);
    lst_try(dec, "anchor_frame_idx beyond the anchors set", DR_ERR_BAD_HEADER);
    lst_one_entry(0, 1, 0);
    lst_try(dec, "anchor_tile_row 1 of one tile row", DR_ERR_BAD_HEADER);
    lst_one_entry(0, 0, 2);
    lst_try(dec, "anchor_tile_col 2 of two tile columns", DR_ERR_BAD_HEADER);
    var small = dr_frame_new(64, 64, 3, 1, 1, 8, 0, &e);
    av1_decoder_set_anchor(dec, 2, small);
    lst_one_entry(2, 0, 0);
    lst_try(dec, "an anchor smaller than the frame", DR_ERR_BAD_HEADER);
    var deep = dr_frame_new(128, 64, 3, 1, 1, 10, 0, &e);
    av1_decoder_set_anchor(dec, 3, deep);
    lst_one_entry(3, 0, 0);
    lst_try(dec, "an anchor of another bit depth", DR_ERR_BAD_HEADER);
    lst_one_entry(0, 0, 1);
    store64(fh + AV1FH_FRAME_TYPE, AV1_KEY_FRAME);
    lst_try(dec, "a KEY camera header", DR_ERR_BAD_HEADER);
    store64(fh + AV1FH_FRAME_TYPE, AV1_INTER_FRAME);
    store64(fh + AV1FH_SHOW_FRAME, 0);
    lst_try(dec, "a hidden camera header", DR_ERR_BAD_HEADER);
    store64(fh + AV1FH_SHOW_FRAME, 1);
    store64(fh + AV1FH_FRAME_WIDTH, 126);
    lst_try(dec, "FrameWidth not MiCols * 4", DR_ERR_BAD_HEADER);
    store64(fh + AV1FH_FRAME_WIDTH, 128);
    store64(fh + AV1FH_USE_SUPERRES, 1);
    lst_try(dec, "superres", DR_ERR_BAD_HEADER);
    store64(fh + AV1FH_USE_SUPERRES, 0);
    store64(fh + AV1FH_MI_COL_STARTS + (2 * 8), 28);
    lst_try(dec, "non-uniform tiles", DR_ERR_BAD_HEADER);
    store64(fh + AV1FH_MI_COL_STARTS + (2 * 8), 32);
    store64(dec + AV1DEC_SEQ, lst_seq(1));
    lst_try(dec, "film grain in the sequence", DR_ERR_BAD_HEADER);
    return 0;
}

# ---- the decoder's mode dispatch and anchor table ----
fn test_lst_dispatch() {
    var dec = av1_decoder_new(0);
    lb_reset();
    lb_u8(66);                        # OBU header: type 8 (OBU_TILE_LIST) << 3 | has_size_field (2)
    lb_u8(10);                        # obu_size 10 (leb128)
    lb_u8(0); lb_u8(0); lb_u16(0);    # a 1 x 1 output, one tile
    lb_entry(0, 0, 0, 1, 0);          # 6 bytes
    var e = 0;
    assert_eq(av1_decoder_decode(dec, Lb_Buf, Lb_Pos, &e), 0, "a tile list outside large-scale tile mode");
    assert_eq(e, DR_ERR_UNSUPPORTED, "...is DR_ERR_UNSUPPORTED, never skipped");
    assert_eq(av1_decode_obus(Lb_Buf, Lb_Pos, &e), 0, "the single-frame walk meets a tile list");
    assert_eq(e, DR_ERR_UNSUPPORTED, "...DR_ERR_UNSUPPORTED too");
    var d2 = av1_decoder_new(0);
    av1_decoder_set_large_scale_tile(d2, 1);
    assert_eq(av1_decoder_decode(d2, Lb_Buf, Lb_Pos, &e), 0, "in the mode, with no sequence or camera header");
    assert_eq(e, DR_ERR_BAD_HEADER, "...DR_ERR_BAD_HEADER");
    assert_eq(av1_decoder_set_anchor(d2, 128, 0), DR_ERR_BOUNDS, "anchor_frame_idx 128 is out of range");
    assert_eq(av1_decoder_set_anchor(d2, 0 - 1, 0), DR_ERR_BOUNDS, "...as is -1");
    assert_eq(av1_decoder_set_anchor(d2, 127, 0), DR_OK, "127 is the last slot");
    assert_eq(load64(d2 + AV1DEC_NANCH), 128, "...and makes 128 anchors addressable");
    return 0;
}

# ---- the scratch reference slot (7.3.1: slot ref_frame_idx[ 0 ] re-described as the current frame) ----
# The committed reproducer tests/repro/lst-256x256.ivf (4 anchor units, the camera header, 3 tile lists) is decoded
# up to its first tile list twice: once as make conformance does, and once with the decoder's OWN metadata for slot
# ref_frame_idx[ 0 ] made stale (a 512x512 frame's) before that list. 7.3.1 gives the slot the current frame's size
# before every tile, so both outputs must be identical; a slot that kept the decoder's metadata would scale the anchor
# 2:1 (xScale / yScale of 7.11.3.3 come from RefUpscaledWidth / RefFrameHeight). On every real stream the decoder's
# slot already holds a same-size anchor, so make conformance cannot see this. The decoder's own reference state must
# also come out unchanged — the scratch copy is the only thing re-described.
var Lst_Slot = 0;
fn lst_repro_list1(stale): i64 {
    var buf = alloc(32768);   # bytes; the reproducer is 16115
    var n = file_read_all("tests/repro/lst-256x256.ivf", buf, 32768);
    if (n <= 0) { return 0; }
    var e = 0;
    var r = dr_ivf_reader_init(buf, n, &e);
    if (r == 0) { return 0; }
    var dec = av1_decoder_new(0);
    var out = 0;
    var k = 0;
    while (k < 6) {   # 4 anchors, the camera header, the first tile list
        var pp = 0;
        var ps = 0;
        var pt = 0;
        if (dr_ivf_next_frame(r, &pp, &ps, &pt) != DR_OK) { return 0; }
        k = k + 1;
        var refs = load64(dec + AV1DEC_REFS);
        if ((k == 6) && (stale != 0)) {
            Lst_Slot = av1_fh_ref_frame_idx(load64(dec + AV1DEC_CAMFH), 0);
            store64(refs + AV1REF_UPSCALED_W + (Lst_Slot * 8), 512);
            store64(refs + AV1REF_FRAME_W + (Lst_Slot * 8), 512);
            store64(refs + AV1REF_FRAME_H + (Lst_Slot * 8), 512);
            store64(refs + AV1REF_MI_COLS + (Lst_Slot * 8), 128);
            store64(refs + AV1REF_MI_ROWS + (Lst_Slot * 8), 128);
        }
        var derr = 0;
        out = av1_decoder_decode(dec, pp, ps, &derr);
        if (derr != DR_OK) { return 0; }
        if (k <= 4) { av1_decoder_set_anchor(dec, k - 1, av1_decoder_last_decoded(dec)); }
        if (k == 4) { av1_decoder_set_large_scale_tile(dec, 1); }
        if ((k == 6) && (stale != 0)) {
            # the decoder's own slot keeps the stale values: nothing but the scratch copy was re-described
            if (load64(refs + AV1REF_UPSCALED_W + (Lst_Slot * 8)) != 512) { return 0; }
            if (load64(refs + AV1REF_FRAME_H + (Lst_Slot * 8)) != 512) { return 0; }
        }
    }
    return out;
}
# 1 when frames a and b have the same shape and every sample of every plane is equal
fn lst_frames_equal(a, b): i64 {
    if ((dr_frame_width(a) != dr_frame_width(b)) || (dr_frame_height(a) != dr_frame_height(b))) { return 0; }
    if (dr_frame_num_planes(a) != dr_frame_num_planes(b)) { return 0; }
    var p = 0;
    while (p < dr_frame_num_planes(a)) {
        var sx = 0;
        var sy = 0;
        if (p > 0) { sx = dr_frame_subx(a); sy = dr_frame_suby(a); }
        var h = (dr_frame_height(a) + sy) >> sy;
        var w = (dr_frame_width(a) + sx) >> sx;
        var y = 0;
        while (y < h) {
            var x = 0;
            while (x < w) {
                if (dr_frame_get(a, p, x, y) != dr_frame_get(b, p, x, y)) { return 0; }
                x = x + 1;
            }
            y = y + 1;
        }
        p = p + 1;
    }
    return 1;
}
fn test_lst_scratch_slot() {
    var fresh = lst_repro_list1(0);
    assert_neq(fresh, 0, "the reproducer's first tile list decodes");
    if (fresh == 0) { return 0; }
    assert_eq(dr_frame_width(fresh), 512, "...into the 8 x 8-tile output frame of 64 x 64 tiles (width)");
    assert_eq(dr_frame_height(fresh), 512, "...(height)");
    var stale = lst_repro_list1(1);
    assert_neq(stale, 0, "it decodes with the decoder's slot metadata stale, leaving that metadata as it was");
    if (stale == 0) { return 0; }
    assert_eq(lst_frames_equal(fresh, stale), 1, "...to the identical output: the slot is the current frame's size");
    return 0;
}

# THE FRAME SIZE LIMIT COVERS A TILE LIST'S OUTPUT (0.8.5, found by the corpus fuzzer): that frame is sized by the
# tile list's own header — up to 256 x 256 tiles — not by a frame header, and it escaped
# av1_decoder_set_frame_size_limit, so a hostile file could make the decoder allocate a 16384^2 output. The committed
# reproducer's anchors are 256x256 (65536 samples) and its first tile list's output 512x512 (262144).
fn lst_repro_limited(limit, out_err): i64 {
    var buf = alloc(32768);   # bytes; the reproducer is 16115
    var n = file_read_all("tests/repro/lst-256x256.ivf", buf, 32768);
    var e = 0;
    var r = dr_ivf_reader_init(buf, n, &e);
    var dec = av1_decoder_new(0);
    av1_decoder_set_frame_size_limit(dec, limit);
    var out = 0;
    var k = 0;
    while (k < 6) {   # 4 anchors, the camera header, the first tile list
        var pp = 0;
        var ps = 0;
        var pt = 0;
        dr_ivf_next_frame(r, &pp, &ps, &pt);
        k = k + 1;
        var derr = 0;
        out = av1_decoder_decode(dec, pp, ps, &derr);
        store64(out_err, derr);
        if (derr != DR_OK) { return k; }   # the unit that failed
        if (k <= 4) { av1_decoder_set_anchor(dec, k - 1, av1_decoder_last_decoded(dec)); }
        if (k == 4) { av1_decoder_set_large_scale_tile(dec, 1); }
    }
    return 0;
}
fn test_lst_frame_size_limit() {
    var e = 0;
    assert_eq(lst_repro_limited(262143, &e), 6, "a limit 1 under 512x512: the anchors decode, the tile list...");
    assert_eq(e, DR_ERR_OVERSIZE, "...is refused with DR_ERR_OVERSIZE before its output is allocated");
    assert_eq(lst_repro_limited(262144, &e), 0, "a limit of exactly 512x512: the tile list decodes");
    assert_eq(e, DR_OK, "...cleanly");
    assert_eq(lst_repro_limited(65535, &e), 1, "a limit under the 256x256 anchors refuses the first frame header");
    assert_eq(e, DR_ERR_OVERSIZE, "...with DR_ERR_OVERSIZE");
    return 0;
}

fn main() {
    alloc_init();
    test_group("tile_list_obu (5.12) and its limits");
    test_lst_parse();
    test_group("raster placement + uniform tiles (7.3.1)");
    test_lst_dest();
    test_lst_uniform();
    test_group("the per-entry grid window reset");
    test_lst_reset_window();
    test_group("av1_decode_tile_list refusals");
    test_lst_refusals();
    test_lst_frame_size_limit();
    test_lst_dispatch();
    test_group("the scratch reference slot (7.3.1)");
    test_lst_scratch_slot();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
