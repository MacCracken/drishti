# tests/av1_symbol.tcyr — the AV1 multi-symbol arithmetic (symbol) coder
# (spec 8.2). Two kinds of check:
#   1. encoder-INDEPENDENT known-answers on the decoder (init state; an
#      all-zeros / all-ones partition drives read_literal to 0 / all-ones)
#      — these pin the decoder to the spec without trusting the encoder.
#   2. round-trips: encode a stream, flush, decode it back, and require the
#      symbols (and, with adaptation on, the final CDF state) to match —
#      which proves the encoder is the exact inverse of the spec decoder.
include "src/main.cyr"
include "src/bits.cyr"
include "src/av1_symbol.cyr"

# A uniform CDF for N symbols: cdf[i] = round((i+1) << 15 / N), cdf[N-1] =
# 1<<15, cdf[N] = 0 (adaptation count). N+1 i64 slots.
fn mk_uniform_cdf(n): i64 {
    var cdf = alloc((n + 1) * 8);
    var i = 0;
    while (i < n) {
        store64(cdf + (i * 8), ((i + 1) * 32768) / n);
        i = i + 1;
    }
    store64(cdf + ((n - 1) * 8), 32768);   # exact top
    store64(cdf + (n * 8), 0);             # count
    return cdf;
}

fn fill(buf, len, byte) {
    var i = 0;
    while (i < len) { store8(buf + i, byte); i = i + 1; }
    return 0;
}

# ================================================================
# Encoder-independent known-answers (decoder pinned to the spec).
# ================================================================
fn test_sym_init_known() {
    # All-zero partition, sz = 4: buf = f(15) = 0, paddedBuf = 0,
    # SymbolValue = (1<<15)-1 = 32767, SymbolRange = 1<<15, MaxBits = 17.
    var z = alloc(4);
    fill(z, 4, 0x00);
    var sd = av1_sym_dec_init(z, 4, 1);
    assert(sd != 0, "decoder inits");
    assert_eq(av1_sym_dec_value(sd), 32767, "SymbolValue = 32767 (zeros)");
    assert_eq(av1_sym_dec_range(sd), 32768, "SymbolRange = 1<<15");
    assert_eq(av1_sym_dec_max_bits(sd), 17, "SymbolMaxBits = 8*4-15");
    # All-ones partition: f(15) = 0x7FFF, SymbolValue = 32767 ^ 32767 = 0.
    var o = alloc(4);
    fill(o, 4, 0xFF);
    var sd2 = av1_sym_dec_init(o, 4, 1);
    assert_eq(av1_sym_dec_value(sd2), 0, "SymbolValue = 0 (ones)");
    return 0;
}

fn test_sym_decode_known() {
    # An all-zeros partition decodes read_bool -> 0 forever; all-ones -> 1.
    var z = alloc(8);
    fill(z, 8, 0x00);
    var sd = av1_sym_dec_init(z, 8, 1);
    assert_eq(av1_sym_read_literal(sd, 8), 0, "zeros -> literal 0");
    var o = alloc(8);
    fill(o, 8, 0xFF);
    var sd2 = av1_sym_dec_init(o, 8, 1);
    assert_eq(av1_sym_read_literal(sd2, 8), 255, "ones -> literal 255");
    assert_eq(av1_sym_dec_err(sd), DR_OK, "no fault");
    return 0;
}

# ================================================================
# Round-trips.
# ================================================================
fn test_sym_bool_roundtrip() {
    # Encode a fixed bit pattern, flush, decode it back.
    var bits = alloc(16 * 8);
    var pat = alloc(16);
    store8(pat, 1); store8(pat + 1, 0); store8(pat + 2, 1); store8(pat + 3, 1);
    store8(pat + 4, 0); store8(pat + 5, 0); store8(pat + 6, 1); store8(pat + 7, 0);
    store8(pat + 8, 1); store8(pat + 9, 1); store8(pat + 10, 0); store8(pat + 11, 1);
    store8(pat + 12, 0); store8(pat + 13, 1); store8(pat + 14, 1); store8(pat + 15, 1);
    var enc = av1_sym_enc_init(64, 1);
    var i = 0;
    while (i < 16) {
        av1_sym_encode_bool(enc, load8(pat + i));
        i = i + 1;
    }
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    assert(out != 0, "encoder flushes");
    assert(olen > 0, "produced bytes");
    var sd = av1_sym_dec_init(out, olen, 1);
    i = 0;
    while (i < 16) {
        assert_eq(av1_sym_read_bool(sd), load8(pat + i), "bool round-trips");
        i = i + 1;
    }
    assert_eq(av1_sym_dec_err(sd), DR_OK, "clean decode");
    return 0;
}

fn test_sym_literal_roundtrip() {
    # A handful of literals of assorted widths.
    var enc = av1_sym_enc_init(64, 1);
    av1_sym_encode_literal(enc, 0xA5, 8);
    av1_sym_encode_literal(enc, 5, 3);
    av1_sym_encode_literal(enc, 0x1FF, 9);
    av1_sym_encode_literal(enc, 0, 4);
    av1_sym_encode_literal(enc, 0xDEAD, 16);
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    var sd = av1_sym_dec_init(out, olen, 1);
    assert_eq(av1_sym_read_literal(sd, 8), 0xA5, "literal 8");
    assert_eq(av1_sym_read_literal(sd, 3), 5, "literal 3");
    assert_eq(av1_sym_read_literal(sd, 9), 0x1FF, "literal 9");
    assert_eq(av1_sym_read_literal(sd, 4), 0, "literal 4");
    assert_eq(av1_sym_read_literal(sd, 16), 0xDEAD, "literal 16");
    return 0;
}

# Fixed symbol stream (10 symbols in [0,3]) round-tripped with a uniform
# CDF and adaptation OFF (both sides use the same constant CDF).
fn test_sym_symbol_roundtrip_noadapt() {
    var syms = alloc(10);
    store8(syms, 0); store8(syms + 1, 3); store8(syms + 2, 1); store8(syms + 3, 2);
    store8(syms + 4, 2); store8(syms + 5, 0); store8(syms + 6, 3); store8(syms + 7, 1);
    store8(syms + 8, 0); store8(syms + 9, 0);
    var cdf_e = mk_uniform_cdf(4);
    var enc = av1_sym_enc_init(64, 1);   # disable_cdf_update = 1
    var i = 0;
    while (i < 10) {
        av1_sym_encode_symbol(enc, cdf_e, 4, load8(syms + i));
        i = i + 1;
    }
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    var cdf_d = mk_uniform_cdf(4);
    var sd = av1_sym_dec_init(out, olen, 1);
    i = 0;
    while (i < 10) {
        assert_eq(av1_sym_read_symbol(sd, cdf_d, 4), load8(syms + i), "symbol round-trips (noadapt)");
        i = i + 1;
    }
    return 0;
}

# Same stream WITH adaptation on: symbols must match AND the encoder's and
# decoder's CDFs must end identical (they ran the same update sequence).
fn test_sym_symbol_roundtrip_adapt() {
    var syms = alloc(20);
    var i = 0;
    while (i < 20) { store8(syms + i, (i * 7 + 3) % 6); i = i + 1; }   # values in [0,5]
    var cdf_e = mk_uniform_cdf(6);
    var enc = av1_sym_enc_init(64, 0);   # disable_cdf_update = 0 (adapt)
    i = 0;
    while (i < 20) {
        av1_sym_encode_symbol(enc, cdf_e, 6, load8(syms + i));
        i = i + 1;
    }
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    var cdf_d = mk_uniform_cdf(6);
    var sd = av1_sym_dec_init(out, olen, 0);
    i = 0;
    while (i < 20) {
        assert_eq(av1_sym_read_symbol(sd, cdf_d, 6), load8(syms + i), "symbol round-trips (adapt)");
        i = i + 1;
    }
    # CDFs (7 slots each) evolved identically on both sides.
    var j = 0;
    while (j < 7) {
        assert_eq(load64(cdf_d + (j * 8)), load64(cdf_e + (j * 8)), "adapted CDF slot matches");
        j = j + 1;
    }
    assert(load64(cdf_d + (6 * 8)) > 0, "adaptation count advanced");
    return 0;
}

# Interleave bool / literal / symbol in one stream.
fn test_sym_mixed_roundtrip() {
    var cdf_e = mk_uniform_cdf(3);
    var enc = av1_sym_enc_init(64, 0);
    av1_sym_encode_bool(enc, 1);
    av1_sym_encode_symbol(enc, cdf_e, 3, 2);
    av1_sym_encode_literal(enc, 0x2A, 6);
    av1_sym_encode_symbol(enc, cdf_e, 3, 0);
    av1_sym_encode_bool(enc, 0);
    av1_sym_encode_symbol(enc, cdf_e, 3, 1);
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    var cdf_d = mk_uniform_cdf(3);
    var sd = av1_sym_dec_init(out, olen, 0);
    assert_eq(av1_sym_read_bool(sd), 1, "mixed bool 1");
    assert_eq(av1_sym_read_symbol(sd, cdf_d, 3), 2, "mixed symbol 2");
    assert_eq(av1_sym_read_literal(sd, 6), 0x2A, "mixed literal");
    assert_eq(av1_sym_read_symbol(sd, cdf_d, 3), 0, "mixed symbol 0");
    assert_eq(av1_sym_read_bool(sd), 0, "mixed bool 0");
    assert_eq(av1_sym_read_symbol(sd, cdf_d, 3), 1, "mixed symbol 1");
    return 0;
}

# Larger N and a longer stream to exercise renorm / carry across bytes.
fn test_sym_large() {
    var cdf_e = mk_uniform_cdf(16);
    var enc = av1_sym_enc_init(64, 0);
    var i = 0;
    while (i < 200) {
        av1_sym_encode_symbol(enc, cdf_e, 16, (i * 5 + 1) % 16);
        i = i + 1;
    }
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    assert(olen > 8, "long stream spans many bytes");
    var cdf_d = mk_uniform_cdf(16);
    var sd = av1_sym_dec_init(out, olen, 0);
    i = 0;
    while (i < 200) {
        assert_eq(av1_sym_read_symbol(sd, cdf_d, 16), (i * 5 + 1) % 16, "large-N symbol round-trips");
        i = i + 1;
    }
    assert_eq(av1_sym_dec_err(sd), DR_OK, "no fault over long stream");
    return 0;
}

# Adversarial: a decoder handed a 1-byte partition reads padding zeros for
# the rest — it must not crash or read out of bounds, just keep returning
# decoded symbols against the padded tail.
fn test_sym_truncated() {
    var b = alloc(1);
    store8(b, 0x80);
    var sd = av1_sym_dec_init(b, 1, 1);
    assert(sd != 0, "inits on 1-byte partition");
    var i = 0;
    while (i < 40) {
        av1_sym_read_bool(sd);          # keeps decoding against padding
        i = i + 1;
    }
    assert_eq(av1_sym_dec_err(sd), DR_OK, "padding decode never faults");
    return 0;
}

# ---- subexp-bool coding (NS + subexp_bool + signed-with-ref) round-trips ----
fn rt_ns(value, n): i64 {
    var enc = av1_sym_enc_init(64, 1);
    av1_sym_encode_ns(enc, value, n);
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    var sd = av1_sym_dec_init(out, olen, 1);
    return av1_sym_read_ns(sd, n);
}
fn test_subexp_ns() {
    var v = 0;
    while (v < 16) { assert_eq(rt_ns(v, 16), v, "NS(16) round-trip"); v = v + 1; }
    v = 0;
    while (v < 5) { assert_eq(rt_ns(v, 5), v, "NS(5) round-trip"); v = v + 1; }
    assert_eq(rt_ns(0, 1), 0, "NS(1) -> 0 (no bits)");
    return 0;
}
fn rt_subexp(value, num_syms, k): i64 {
    var enc = av1_sym_enc_init(128, 1);
    av1_encode_subexp_bool(enc, value, num_syms, k);
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    var sd = av1_sym_dec_init(out, olen, 1);
    return av1_decode_subexp_bool(sd, num_syms, k);
}
fn test_subexp_bool() {
    var v = 0;
    while (v < 32) { assert_eq(rt_subexp(v, 32, 3), v, "subexp(32,k3) round-trip"); v = v + 1; }
    assert_eq(rt_subexp(0, 16, 1), 0, "subexp(16,k1) 0");
    assert_eq(rt_subexp(15, 16, 1), 15, "subexp(16,k1) 15");
    assert_eq(rt_subexp(100, 128, 2), 100, "subexp(128,k2) 100");
    return 0;
}
fn rt_signed(value, low, high, k, r): i64 {
    var enc = av1_sym_enc_init(128, 1);
    av1_encode_signed_subexp_with_ref_bool(enc, value, low, high, k, r);
    var olen = 0;
    var out = av1_sym_enc_finish(enc, &olen);
    var sd = av1_sym_dec_init(out, olen, 1);
    return av1_decode_signed_subexp_with_ref_bool(sd, low, high, k, r);
}
fn test_subexp_signed() {
    # Wiener tap 0: [-5,10], k=1, ref = Wiener_Taps_Mid[0]=3 — every value round-trips.
    var v = 0 - 5;
    while (v <= 10) { assert_eq(rt_signed(v, 0 - 5, 11, 1, 3), v, "wiener tap0 round-trip"); v = v + 1; }
    # Sgr xqd 1: [-32,95], k=SGRPROJ_PRJ_SUBEXP_K(4), ref=31.
    assert_eq(rt_signed(0 - 32, 0 - 32, 96, 4, 31), 0 - 32, "sgr xqd1 min");
    assert_eq(rt_signed(95, 0 - 32, 96, 4, 31), 95, "sgr xqd1 max");
    assert_eq(rt_signed(0, 0 - 32, 96, 4, 31), 0, "sgr xqd1 zero");
    # a negative reference still round-trips (Wiener tap1 [-23,8], k=2, ref -7).
    assert_eq(rt_signed(7, 0 - 23, 9, 2, 0 - 7), 7, "wiener tap1 ref -7");
    assert_eq(rt_signed(0 - 20, 0 - 23, 9, 2, 0 - 7), 0 - 20, "wiener tap1 negative value");
    return 0;
}
# the encoders reject out-of-range input (matching dr_ns_write) — encoder hardening.
fn test_subexp_encode_bounds() {
    var enc = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_ns(enc, 16, 16), DR_ERR_BOUNDS, "encode_ns value==n rejected");
    assert_eq(av1_sym_encode_ns(enc, 0 - 1, 16), DR_ERR_BOUNDS, "encode_ns negative rejected");
    assert_eq(av1_encode_subexp_bool(enc, 32, 32, 3), DR_ERR_BOUNDS, "encode_subexp value==num_syms rejected");
    assert_eq(av1_encode_subexp_bool(enc, 5, 32, 3), DR_OK, "encode_subexp in-range ok");
    return 0;
}

# ---- exit_symbol (8.2.4): the trailing bit, the zero padding, SymbolMaxBits >= -14 ----
# Known answers from scripts/refs/symbol_exit_ref.py (a spec transcription of 8.2.2 / 8.2.3 / 8.2.4 / 8.2.6, every
# case derived by hand there): bytes, then k read_bool calls, then the exit verdict.
var Sx_Buf = 0;
fn sx_case(b0, b1, b2, b3, sz, k, want_ok, what): i64 {
    Sx_Buf = alloc(8);   # bytes
    store8(Sx_Buf, b0); store8(Sx_Buf + 1, b1); store8(Sx_Buf + 2, b2); store8(Sx_Buf + 3, b3);
    var sd = av1_sym_dec_init(Sx_Buf, sz, 1);
    var i = 0;
    while (i < k) { av1_sym_read_bool(sd); i = i + 1; }
    var rc = av1_sym_dec_exit(sd);
    if (want_ok == 1) {
        assert_eq(rc, DR_OK, what);
        assert_eq(dr_br_bit_pos(load64(sd + AV1SD_BR)), sz * 8, "...the reader ends at paddingEndPosition");
    } else {
        assert_eq(rc, AV1_ERR_BAD_FRAME, what);
        assert_eq(av1_sym_dec_err(sd), AV1_ERR_BAD_FRAME, "...sticky");
    }
    return 0;
}
fn test_sym_exit_known() {
    sx_case(128, 0, 0, 0, 1, 0, 1, "1 byte 1000 0000: the trailing bit then zero padding");
    sx_case(129, 0, 0, 0, 1, 0, 0, "1 byte 1000 0001: a 1 in the padding");
    sx_case(64, 0, 0, 0, 1, 0, 0, "1 byte 0100 0000: the trailing bit is 0");
    sx_case(128, 0, 0, 0, 2, 0, 1, "2 bytes 0x80 0x00");
    sx_case(128, 1, 0, 0, 2, 0, 0, "2 bytes 0x80 0x01: the last padding bit set");
    sx_case(128, 0, 0, 0, 4, 0, 1, "whole zero bytes of padding");
    sx_case(128, 0, 0, 16, 4, 0, 0, "a 1 three bytes into the padding");
    sx_case(128, 0, 0, 0, 1, 7, 0, "one byte 0x80, 7 bools: the trailing bit lands on bit 7, a 0");
    sx_case(129, 0, 0, 0, 1, 7, 1, "one byte 0x81, 7 bools: bit 7 is the trailing 1");
    sx_case(128, 0, 0, 0, 1, 8, 0, "one byte, 8 bools: SymbolMaxBits -15");
    sx_case(128, 0, 0, 0, 2, 1, 0, "two bytes, 1 bool: trailing bit 1 is a 0");
    sx_case(128, 0, 0, 0, 2, 15, 0, "two bytes, 15 bools: trailing bit 15 is a 0");
    sx_case(128, 0, 0, 0, 2, 16, 0, "two bytes, 16 bools: SymbolMaxBits -15");
    return 0;
}
# The encoder's output meets 8.2.4 whatever was coded: 200 seeded symbol streams round-trip AND exit cleanly; one
# extra zero byte is still valid padding, one extra 0x01 byte is not.
fn test_sym_exit_encoder_output() {
    var seed = 12345;
    var good = 0;
    var zero_ok = 0;
    var junk_bad = 0;
    var t = 0;
    while (t < 200) {
        var enc = av1_sym_enc_init(64, 1);
        var cdf = alloc(5 * 8);   # 4 symbols + counter
        store64(cdf, 8192); store64(cdf + 8, 16384); store64(cdf + 16, 24576); store64(cdf + 24, 32768);
        store64(cdf + 32, 0);
        var nsym = 1 + (t % 40);
        var syms = alloc(nsym * 8);
        var i = 0;
        while (i < nsym) {
            seed = ((seed * 1103515245) + 12345) & 2147483647;
            store64(syms + (i * 8), (seed >> 16) & 3);
            av1_sym_encode_symbol(enc, cdf, 4, load64(syms + (i * 8)));
            i = i + 1;
        }
        var len = 0;
        var out = av1_sym_enc_finish(enc, &len);
        var b = alloc(len + 2);   # bytes
        memcpy(b, out, len);
        store8(b + len, 0);
        store8(b + len + 1, 0);
        var round = 1;
        var sd = av1_sym_dec_init(b, len, 1);
        store64(cdf, 8192); store64(cdf + 8, 16384); store64(cdf + 16, 24576); store64(cdf + 24, 32768);
        i = 0;
        while (i < nsym) {
            if (av1_sym_read_symbol(sd, cdf, 4) != load64(syms + (i * 8))) { round = 0; }
            i = i + 1;
        }
        if ((round == 1) && (av1_sym_dec_exit(sd) == DR_OK)) { good = good + 1; }
        var sd2 = av1_sym_dec_init(b, len + 1, 1);   # + one zero byte
        i = 0;
        while (i < nsym) { av1_sym_read_symbol(sd2, cdf, 4); i = i + 1; }
        if (av1_sym_dec_exit(sd2) == DR_OK) { zero_ok = zero_ok + 1; }
        store8(b + len, 1);
        var sd3 = av1_sym_dec_init(b, len + 1, 1);   # + 0x01
        i = 0;
        while (i < nsym) { av1_sym_read_symbol(sd3, cdf, 4); i = i + 1; }
        if (av1_sym_dec_exit(sd3) == AV1_ERR_BAD_FRAME) { junk_bad = junk_bad + 1; }
        t = t + 1;
    }
    assert_eq(good, 200, "200 encoder outputs decode back and pass the 8.2.4 exit");
    assert_eq(zero_ok, 200, "...each still passes with one more zero byte of padding");
    assert_eq(junk_bad, 200, "...and fails with a 0x01 byte after it");
    return 0;
}
# The encoder refuses a symbol outside [0, n): no interval to code, and cdf[-1] is not the CDF's.
fn test_sym_encode_symbol_bounds() {
    var cdf = alloc(3 * 8);
    store64(cdf, 16384); store64(cdf + 8, 32768); store64(cdf + 16, 0);
    var enc = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_symbol(enc, cdf, 2, 0 - 1), DR_ERR_BOUNDS, "symbol -1 is refused");
    assert_eq(av1_sym_enc_err(enc), DR_ERR_BOUNDS, "...sticky");
    var len = 7;
    assert_eq(av1_sym_enc_finish(enc, &len), 0, "...and finish yields nothing");
    assert_eq(len, 0, "...of length 0");
    var enc2 = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_symbol(enc2, cdf, 2, 2), DR_ERR_BOUNDS, "symbol n (2 of 2) is refused");
    var enc3 = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_symbol(enc3, cdf, 2, 1), DR_OK, "symbol n - 1 is coded");
    return 0;
}

# ---- the symbol-range bound (8.2.6's precondition: N > 1 and cdf[ N-1 ] == 1 << 15), both lanes ----
fn sb_cdf(a, b, c, d): i64 {
    var cdf = alloc(8 * 8);   # 8 i64 slots: the cdf, then guard words a corrupt search would read
    store64(cdf, a); store64(cdf + 8, b); store64(cdf + 16, c); store64(cdf + 24, d);
    store64(cdf + 32, 0); store64(cdf + 40, 0); store64(cdf + 48, 0); store64(cdf + 56, 0);
    return cdf;
}
fn sb_dec(): i64 {
    var b = alloc(8);   # bytes: a zero partition (SymbolValue 32767, the top of the range)
    memset(b, 0, 8);
    return av1_sym_dec_init(b, 4, 1);
}
fn test_sym_range_bound() {
    # a terminator of 40000 instead of 1 << 15 at N = 2: the search would pass symbol 1 (f = 32768 - 40000 < 0,
    # and >> is logical) into the counter word and beyond. Refused before any cdf entry is read.
    var sd = sb_dec();
    assert_eq(av1_sym_decode(sd, sb_cdf(16384, 40000, 0, 0), 2, 0), 0, "decode: terminator 40000 -> 0");
    assert_eq(av1_sym_dec_err(sd), DR_ERR_BOUNDS, "...DR_ERR_BOUNDS");
    assert_eq(av1_sym_decode(sd, sb_cdf(16384, 32768, 0, 0), 2, 0), 0, "...sticky: a good cdf after it, nothing");
    assert_eq(av1_sym_dec_err(sd), DR_ERR_BOUNDS, "...still DR_ERR_BOUNDS");
    var sd2 = sb_dec();
    av1_sym_decode(sd2, sb_cdf(16384, 32767, 0, 0), 2, 0);
    assert_eq(av1_sym_dec_err(sd2), DR_ERR_BOUNDS, "decode: terminator 32767 (one short)");
    var sd3 = sb_dec();
    av1_sym_decode(sd3, sb_cdf(32768, 0, 0, 0), 1, 0);
    assert_eq(av1_sym_dec_err(sd3), DR_ERR_BOUNDS, "decode: N = 1 (the spec says N > 1)");
    var sd4 = sb_dec();
    av1_sym_decode(sd4, sb_cdf(32768, 0, 0, 0), 0, 0);
    assert_eq(av1_sym_dec_err(sd4), DR_ERR_BOUNDS, "decode: N = 0");
    # an entry above 1 << 15 in the middle, terminator intact: the search would end at N-1 but with a meaningless
    # SymbolRange (prev - cur from a negative f, logically shifted) — refused as it is read
    var sd5 = sb_dec();
    av1_sym_decode(sd5, sb_cdf(40000, 50000, 32768, 0), 3, 0);
    assert_eq(av1_sym_dec_err(sd5), DR_ERR_BOUNDS, "decode: an entry of 40000 mid-cdf");
    # an entry of -1: f = 32769, cur = (128 * 512 >> 1) + 4 = 32772 > SymbolValue 32767, so the search moves on to the
    # terminator and stops with a plausible SymbolRange 32772 — only the per-entry check sees this one
    var sdn = sb_dec();
    av1_sym_decode(sdn, sb_cdf(0 - 1, 32768, 0, 0), 2, 0);
    assert_eq(av1_sym_dec_err(sdn), DR_ERR_BOUNDS, "decode: an entry of -1");
    # sufficiency: NON-monotonic entries inside [0, 1 << 15] still decode, the range positive. An all-ones partition
    # gives SymbolValue 0, so the search runs to N-1: cur = 2760 at symbol 0, 22724 at 1 (it RISES: 10000 < 30000),
    # 0 at 2 -> symbol 2, SymbolRange 22724 - 0 = 22724, renormalised by 15 - FloorLog2(22724) = 1 bit to 45448.
    var ones = alloc(8);   # bytes
    memset(ones, 255, 8);
    var sd6 = av1_sym_dec_init(ones, 4, 1);
    var s6 = av1_sym_decode(sd6, sb_cdf(30000, 10000, 32768, 0), 3, 0);
    assert_eq(av1_sym_dec_err(sd6), DR_OK, "non-monotonic entries in range: no error");
    assert_eq(s6, 2, "...the search stops at N-1 = 2");
    assert_eq(av1_sym_dec_range(sd6), 45448, "...SymbolRange 22724 << 1");
    var e4 = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_symbol(e4, sb_cdf(40000, 32768, 0, 0), 2, 0), DR_ERR_BOUNDS, "encode: an entry of 40000");
    # the encoder refuses the same cdf / N
    var e1 = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_symbol(e1, sb_cdf(16384, 40000, 0, 0), 2, 0), DR_ERR_BOUNDS, "encode: terminator 40k");
    var e2 = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_symbol(e2, sb_cdf(32768, 0, 0, 0), 1, 0), DR_ERR_BOUNDS, "encode: N = 1");
    var e3 = av1_sym_enc_init(64, 1);
    assert_eq(av1_sym_encode_symbol(e3, sb_cdf(16384, 32768, 0, 0), 2, 1), DR_OK, "encode: a good cdf codes");
    return 0;
}

fn main() {
    alloc_init();
    test_group("av1 symbol coder — the symbol-range bound (8.2.6 precondition)");
    test_sym_range_bound();
    test_group("av1 symbol coder — exit_symbol (8.2.4) and the encoder's symbol bound");
    test_sym_exit_known();
    test_sym_exit_encoder_output();
    test_sym_encode_symbol_bounds();
    test_group("av1 symbol coder — known answers");
    test_sym_init_known();
    test_sym_decode_known();
    test_group("av1 symbol coder — round-trips");
    test_sym_bool_roundtrip();
    test_sym_literal_roundtrip();
    test_sym_symbol_roundtrip_noadapt();
    test_sym_symbol_roundtrip_adapt();
    test_sym_mixed_roundtrip();
    test_sym_large();
    test_group("av1 symbol coder — subexp-bool (NS / subexp / signed-with-ref)");
    test_subexp_ns();
    test_subexp_bool();
    test_subexp_signed();
    test_subexp_encode_bounds();
    test_group("av1 symbol coder — adversarial");
    test_sym_truncated();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
