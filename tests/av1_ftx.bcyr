# tests/av1_ftx.bcyr — the AV1 forward transform (src/av1_ftx.cyr) against the inverse it inverts (src/av1_itx.cyr),
# DCT_DCT at 8x8, 32x32 and 64x64 on a seeded 8-bit residual. The forward is the inverse's transpose, so the two should
# cost about the same; a forward far slower than its inverse is a regression to look at.
#
# Pattern: bench_new -> bench_batch_start -> tight loop -> bench_batch_stop -> bench_report (lib/bench.cyr).
include "src/main.cyr"

fn ftxb_fill(buf, n): i64 {
    var x = 12345;
    var k = 0;
    while (k < n) {
        x = ((x * 1103515245) + 12345) & 2147483647;
        store64(buf + (k * 8), ((x >> 8) % 511) - 255);
        k = k + 1;
    }
    return 0;
}

fn ftxb_pair(name_f, name_i, tx, n, iters, res, coef, rec): i64 {
    var bf = bench_new(name_f);
    bench_batch_start(bf);
    var i = 0;
    while (i < iters) { av1_forward_transform_2d(res, coef, tx, AV1_DCT_DCT, 0); i = i + 1; }
    bench_batch_stop(bf, iters);
    bench_report(bf);
    var bi = bench_new(name_i);
    bench_batch_start(bi);
    i = 0;
    while (i < iters) { av1_inverse_transform_2d(coef, rec, tx, AV1_DCT_DCT, 0, 8); i = i + 1; }
    bench_batch_stop(bi, iters);
    bench_report(bi);
    return 0;
}

fn main(): i64 {
    alloc_init();
    if (av1_tables_init() != DR_OK) { return 1; }
    var res = alloc(4096 * 8);
    var coef = alloc(4096 * 8);
    var rec = alloc(4096 * 8);
    ftxb_fill(res, 4096);
    ftxb_pair("forward 8x8 DCT_DCT", "inverse 8x8 DCT_DCT", AV1_TX_8X8, 64, 2000, res, coef, rec);
    ftxb_pair("forward 32x32 DCT_DCT", "inverse 32x32 DCT_DCT", AV1_TX_32X32, 1024, 200, res, coef, rec);
    ftxb_pair("forward 64x64 DCT_DCT", "inverse 64x64 DCT_DCT", AV1_TX_64X64, 4096, 50, res, coef, rec);
    return 0;
}

var r = main();
syscall(60, r);
