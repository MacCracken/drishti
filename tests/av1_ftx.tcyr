    ftx_kat(15, 10, 4065252, 321077612, -10490114, 93403032452, 0, 2);
    ftx_kat(15, 11, -3640373, 360794744, -4660171, 98917759651, 0, 1);
    ftx_kat(15, 13, 184621, 358402098, -58975503, 101943692890, 0, 2);
    ftx_kat(15, 15, 3154958, 361675168, 2068605, 91543105820, 0, 2);
