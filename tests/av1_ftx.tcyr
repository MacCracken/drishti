# tests/av1_ftx.tcyr — the forward transform (src/av1_ftx.cyr): the transpose of the spec's inverse (7.13).
#
# Every known answer comes from scripts/refs/fwd_txfm_ref.py, which derives the forward transform from the spec's
# inverse operation lists (7.13.2.3 / .7 / .8 / .6 / .10), proves each 1D forward is the exact transpose of the spec
# inverse in rational arithmetic, and checks it bit for bit against libaom's own forward transform compiled from ref/
# (scripts/refs/fwd_txfm_libaom.c, at the spec's 12-bit cosine precision) — never from this Cyrius. Regenerate with
#   python3 scripts/refs/fwd_txfm_ref.py --emit
# The residuals are seeded LCG blocks both sides compute alike: x = (x * 1103515245 + 12345) & (2^31 - 1), value
# ((x >> 8) % (2 * maxv + 1)) - maxv. The digests are D1 = sum (k + 1) * c[ k ] (positions) and D2 = sum c[ k ]^2.
include "src/main.cyr"

var Ftx_Res = 0;    # 4096 i64: a residual
var Ftx_Coef = 0;   # 4096 i64: its coefficients
var Ftx_Rec = 0;    # 4096 i64: the inverse transform's output
var Ftx_T = 0;      # 128 i64: a 1D array + its permutation copy

fn ftx_bufs(): i64 {
    if (Ftx_Res == 0) {
        Ftx_Res = alloc(4096 * 8);
        Ftx_Coef = alloc(4096 * 8);
        Ftx_Rec = alloc(4096 * 8);
        Ftx_T = alloc(128 * 8);
    }
    return 0;
}
fn ftx_lcg(buf, seed, count, maxv): i64 {
    var x = seed;
    var k = 0;
    while (k < count) {
        x = ((x * 1103515245) + 12345) & 2147483647;
        store64(buf + (k * 8), ((x >> 8) % ((2 * maxv) + 1)) - maxv);
        k = k + 1;
    }
    return 0;
}
fn ftx_d1(buf, count): i64 {
    var s = 0;
    var k = 0;
    while (k < count) { s = s + ((k + 1) * load64(buf + (k * 8))); k = k + 1; }
    return s;
}
fn ftx_d2(buf, count): i64 {
    var s = 0;
    var k = 0;
    while (k < count) { var v = load64(buf + (k * 8)); s = s + (v * v); k = k + 1; }
    return s;
}
fn ftx_w(t): i64 { return 1 << av1_tx_width_log2(t); }
fn ftx_h(t): i64 { return 1 << av1_tx_height_log2(t); }
fn ftx_big(t): i64 { return (ftx_w(t) == 64) || (ftx_h(t) == 64); }

# max |Inv(coef) - res| through av1_inverse_transform_2d (7.13.3) and the flipped read of av1_reconstruct (7.12.3)
fn ftx_roundtrip(t, typ, bd, lossless): i64 {
    var w = ftx_w(t);
    var h = ftx_h(t);
    if (av1_inverse_transform_2d(Ftx_Coef, Ftx_Rec, t, typ, lossless, bd) != DR_OK) { return 0 - 1; }
    var ud = 0;
    var lr = 0;
    if (lossless == 0) { ud = av1_recon_flip_ud(typ); lr = av1_recon_flip_lr(typ); }
    var worst = 0;
    var i = 0;
    while (i < h) {
        var j = 0;
        while (j < w) {
            var si = i;
            if (ud) { si = (h - 1) - i; }
            var sj = j;
            if (lr) { sj = (w - 1) - j; }
            var d = load64(Ftx_Rec + (((si * w) + sj) * 8)) - load64(Ftx_Res + (((i * w) + j) * 8));
            if (d < 0) { d = 0 - d; }
            if (d > worst) { worst = d; }
            j = j + 1;
        }
        i = i + 1;
    }
    return worst;
}

# ---- 1D: every kernel on a 15-bit seeded vector ----
fn ftx_kat1(kind, n, d1, d2): i64 {
    ftx_lcg(Ftx_T, (500 + (10 * kind)) + n, 1 << n, 32767);
    assert_eq(av1_ftx_1d(Ftx_T, kind, n, Ftx_T + (64 * 8)), DR_OK, "1D forward runs");
    assert_eq(ftx_d1(Ftx_T, 1 << n), d1, "1D forward: positions digest");
    assert_eq(ftx_d2(Ftx_T, 1 << n), d2, "1D forward: energy digest");
    return 0;
}
fn test_ftx_1d() {
    ftx_kat1(0, 2, 109544, 2773813470);
    ftx_kat1(0, 3, 374783, 12606456047);
    ftx_kat1(0, 4, -2863003, 44938795230);
    ftx_kat1(0, 5, -7322592, 201199502098);
    ftx_kat1(0, 6, 32110947, 825689207902);
    ftx_kat1(1, 2, 123081, 1831683742);
    ftx_kat1(1, 3, -164487, 8693008768);
    ftx_kat1(1, 4, -2288946, 22262723586);
    ftx_kat1(2, 2, -2408, 479770120);
    ftx_kat1(2, 3, -319806, 12070906852);
    ftx_kat1(2, 4, -146950, 39901651886);
    ftx_kat1(2, 5, -266920, 236887718240);
    return 0;
}

# ---- 2D: every legal (size, type) pair, 8- and 12-bit residuals; then the round trip through drishti's inverse ----
var Ftx_Rt_Bad = 0;   # non-64 pairs whose round trip exceeds 2 (8-bit) / 5 (12-bit)
fn ftx_kat(t, typ, d1_8, d2_8, d1_12, d2_12, rt8, rt12): i64 {
    var n = ftx_w(t) * ftx_h(t);
    var seed = (1 + (16 * t)) + typ;
    ftx_lcg(Ftx_Res, seed, n, 255);
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, t, typ, 0), DR_OK, "forward 2D runs (8-bit residual)");
    assert_eq(ftx_d1(Ftx_Coef, n), d1_8, "forward 2D, 8-bit: positions digest");
    assert_eq(ftx_d2(Ftx_Coef, n), d2_8, "forward 2D, 8-bit: energy digest");
    var e8 = ftx_roundtrip(t, typ, 8, 0);
    assert_eq(e8, rt8, "round trip, 8-bit: the port's worst error");
    ftx_lcg(Ftx_Res, seed, n, 4095);
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, t, typ, 0), DR_OK, "forward 2D runs (12-bit residual)");
    assert_eq(ftx_d1(Ftx_Coef, n), d1_12, "forward 2D, 12-bit: positions digest");
    assert_eq(ftx_d2(Ftx_Coef, n), d2_12, "forward 2D, 12-bit: energy digest");
    var e12 = ftx_roundtrip(t, typ, 12, 0);
    assert_eq(e12, rt12, "round trip, 12-bit: the port's worst error");
    # the property the forward exists for: below a 64-point dimension (whose upper 32 frequencies 7.13.3 drops), it
    # inverts the inverse to within rounding
    if ((ftx_big(t) == 0) && ((e8 > 2) || (e12 > 5))) { Ftx_Rt_Bad = Ftx_Rt_Bad + 1; }
    return 0;
}
