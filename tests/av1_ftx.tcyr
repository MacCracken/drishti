    ftx_kat(17, 0, -166887, 171833953, 68518858, 46544058264, 298, 4730);
    ftx_kat(17, 2, -3403152, 177306723, -94384114, 47766946342, 328, 4891);
    ftx_kat(17, 5, 2051976, 204207133, 86981066, 49589771027, 270, 5037);
    ftx_kat(17, 10, 6033919, 174796161, -13501555, 49029007686, 314, 5146);
    ftx_kat(18, 0, 11232783, 198157840, -203747223, 45003878722, 281, 4762);
    ftx_kat(18, 1, -4086831, 171954735, -148891314, 44556586276, 372, 4601);
    ftx_kat(18, 4, -8141274, 174545412, -128915161, 45432387254, 290, 5123);
    ftx_kat(18, 11, 54537, 189782877, 120939080, 42754225158, 291, 4687);
    assert_eq(Ftx_Rt_Bad, 0, "every pair below 64 points round-trips within 2 (8-bit) / 5 (12-bit)");
    return 0;
}

# ---- the WHT kernel on its own. Inside the 2D lossless path a LOGICAL shift for its e = ( a - d ) >> 1 is an
# equivalent mutant in wrapping i64 arithmetic: it adds 2^63, the second pass spreads that to multiples of 2^62, and the
# final x 4 sends them to 0 mod 2^64. So the kernel is pinned directly, on vectors with a - d < 0 ----
fn ftx_katw(seed, d1, d2): i64 {
    ftx_lcg(Ftx_T, seed, 4, 32767);
    av1_ftx_wht(Ftx_T);
    assert_eq(ftx_d1(Ftx_T, 4), d1, "WHT kernel: positions digest");
    assert_eq(ftx_d2(Ftx_T, 4), d2, "WHT kernel: energy digest");
    return 0;
}
fn test_ftx_wht_kernel() {
    ftx_katw(600, 23976, 1513503623);
    ftx_katw(601, -3498, 520886395);
    ftx_katw(602, -31363, 724513541);
    ftx_katw(603, -190036, 1833676534);
    ftx_katw(605, 82296, 1402816677);
    # by hand: d = 5 - 0 = 5, a = 0 + 0 = 0, e = (0 - 5) >> 1 = -3 (floor), c = e - 0 = -3, b = e - 0 = -3,
    # d = 5 + b = 2, a = 0 - c = 3; out (a, c, d, b)
    store64(Ftx_T, 0); store64(Ftx_T + 8, 0); store64(Ftx_T + 16, 0); store64(Ftx_T + 24, 5);
    av1_ftx_wht(Ftx_T);
    assert_eq(load64(Ftx_T), 3, "fwd_wht([0, 0, 0, 5])[0] = 3");
    assert_eq(load64(Ftx_T + 8), 0 - 3, "[1] = -3");
    assert_eq(load64(Ftx_T + 16), 2, "[2] = 2");
    assert_eq(load64(Ftx_T + 24), 0 - 3, "[3] = -3");
    return 0;
}

# ---- lossless: the forward WHT is the exact inverse of 7.13.2.10 ----
fn test_ftx_lossless() {
    var seeds = alloc(3 * 8);
    var want1 = alloc(3 * 8);
    var want2 = alloc(3 * 8);
    store64(want1 + 0, -401732);
    store64(want2 + 0, 1357250272);
    store64(want1 + 8, -364516);
    store64(want2 + 8, 1252046928);
    store64(want1 + 16, -40384);
    store64(want2 + 16, 1034470992);
    var s = 0;
    while (s < 3) {
        ftx_lcg(Ftx_Res, 101 + s, 16, 4095);
        assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_4X4, AV1_DCT_DCT, 1), DR_OK, "lossless forward");
        assert_eq(ftx_d1(Ftx_Coef, 16), load64(want1 + (s * 8)), "lossless: positions digest");
        assert_eq(ftx_d2(Ftx_Coef, 16), load64(want2 + (s * 8)), "lossless: energy digest");
        s = s + 1;
    }
    # exact round trip through the spec's inverse WHT, whatever the tx_type passed (7.13.3 ignores it when lossless)
    var inexact = 0;
    var k = 0;
    while (k < 2000) {
        var maxv = 255;
        var bd = 8;
        if (k >= 1000) { maxv = 4095; bd = 12; }
        ftx_lcg(Ftx_Res, 7000 + k, 16, maxv);
        av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_4X4, k % 16, 1);
        if (ftx_roundtrip(AV1_TX_4X4, k % 16, bd, 1) != 0) { inexact = inexact + 1; }
        k = k + 1;
    }
    assert_eq(inexact, 0, "2000 lossless blocks (8- and 12-bit) come back EXACTLY");
    return 0;
}

# ---- a 64-point dimension keeps only its lowest 32 frequencies (7.13.3 reads nothing beyond) ----
fn test_ftx_64_zero() {
    var sizes = alloc(5 * 8);
    store64(sizes, AV1_TX_64X64);
    store64(sizes + 8, 11);    # TX_32X64
    store64(sizes + 16, 12);   # TX_64X32
    store64(sizes + 24, 17);   # TX_16X64
    store64(sizes + 32, 18);   # TX_64X16
    var stray = 0;
    var kept = 0;
    var s = 0;
    while (s < 5) {
        var t = load64(sizes + (s * 8));
        var w = ftx_w(t);
        var h = ftx_h(t);
        ftx_lcg(Ftx_Res, 900 + s, w * h, 255);
        av1_forward_transform_2d(Ftx_Res, Ftx_Coef, t, AV1_DCT_DCT, 0);
        var i = 0;
        while (i < h) {
            var j = 0;
            while (j < w) {
                var v = load64(Ftx_Coef + (((i * w) + j) * 8));
                if (((i >= 32) || (j >= 32)) && (v != 0)) { stray = stray + 1; }
                if ((i < 32) && (j < 32) && (v != 0)) { kept = kept + 1; }
                j = j + 1;
            }
            i = i + 1;
        }
        s = s + 1;
    }
    assert_eq(stray, 0, "no coefficient outside the kept 32 x 32 region is non-zero");
    assert(kept > 1000, "the kept region carries the block");
    return 0;
}

# ---- refusals: what has no transform ----
fn test_ftx_refusals() {
    ftx_lcg(Ftx_Res, 5, 4096, 255);
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, 0 - 1, AV1_DCT_DCT, 0), AV1_ERR_BAD_TX, "tx_size -1");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, 19, AV1_DCT_DCT, 0), AV1_ERR_BAD_TX, "tx_size 19");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_4X4, 16, 0), AV1_ERR_BAD_TX, "tx_type 16");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_4X4, 0 - 1, 0), AV1_ERR_BAD_TX, "tx_type -1");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_32X32, AV1_ADST_ADST, 0), AV1_ERR_BAD_TX,
      "no 32-point ADST");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_64X64, AV1_IDTX, 0), AV1_ERR_BAD_TX,
      "no 64-point identity");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, 13, AV1_V_ADST, 0), DR_OK, "4x16 V_ADST: ADST16 columns");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, 14, AV1_V_ADST, 0), DR_OK, "16x4 V_ADST: ADST4 columns");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, 17, AV1_V_ADST, 0), AV1_ERR_BAD_TX,
      "16x64 V_ADST: no 64-point ADST column");
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_8X8, AV1_DCT_DCT, 1), AV1_ERR_BAD_TX,
      "lossless is 4x4 only");
    return 0;
}

# ---- memory: lazily built once (each failure stops the call with DR_ERR_OOM), then nothing per call ----
var Ftx_Sweep_T = 0;
fn ftx_sweep_op(arg): i64 {
    return av1_forward_transform_2d(Ftx_Res, Ftx_Coef, arg, AV1_DCT_DCT, 0);
}
fn test_ftx_lazy_oom() {
    # run FIRST, before anything in this process builds a table: each lazy build in turn is failed
    ftx_bufs();
    ftx_lcg(Ftx_Res, 3, 64, 255);
    dr_alloc_fail_at(1);
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_8X8, AV1_DCT_DCT, 0), DR_ERR_OOM,
      "the inverse's size tables cannot be built: OOM, no crash");
    dr_alloc_fail_at(0);
    assert(av1_itx_tables() != 0, "they build once memory is back");
    dr_alloc_fail_at(1);
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_8X8, AV1_DCT_DCT, 0), DR_ERR_OOM,
      "the scratch cannot be built: OOM");
    dr_alloc_fail_at(0);
    assert(av1_ftx_scratch() != 0, "the scratch builds once memory is back");
    dr_alloc_fail_at(1);
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_8X8, AV1_DCT_DCT, 0), DR_ERR_OOM,
      "the shift table cannot be built: OOM");
    dr_alloc_fail_at(0);
    assert_eq(av1_forward_transform_2d(Ftx_Res, Ftx_Coef, AV1_TX_8X8, AV1_DCT_DCT, 0), DR_OK, "then it runs");
    var n = 0;
    assert_eq(dr_alloc_sweep(&ftx_sweep_op, AV1_TX_64X64, &n), 0, "the OOM sweep over a 64x64 forward holds");
    assert_eq(n, 0, "a forward transform allocates nothing per call");
    return 0;
}

fn main() {
    alloc_init();
    test_group("forward transform: lazily built state under OOM");
    test_ftx_lazy_oom();
    ftx_bufs();
    test_group("forward transform: 1D kernels (the transposed spec inverse)");
    test_ftx_1d();
    test_group("forward transform: 2D, every legal (size, type) pair, and the round trip");
    test_ftx_2d();
    test_group("forward transform: lossless WHT");
    test_ftx_wht_kernel();
    test_ftx_lossless();
    test_group("forward transform: 64-point dimensions and refusals");
    test_ftx_64_zero();
    test_ftx_refusals();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
