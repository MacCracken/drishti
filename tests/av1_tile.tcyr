# tests/av1_tile.tcyr — AV1 tile / frame loop (spec 5.11.2 decode_tile): the
# superblock loop that drives decode_partition over a frame into a DrFrame — the
# FIRST FULLY DECODED KEYFRAME. qbucket / clear_above/left by known-answers; the
# whole keyframe decode by a multi-superblock round-trip (a 128x64 mono frame =
# 2 superblocks, SB0 SPLIT into four 32x32 + SB1 one 64x64, all skip DC) through
# the encode/decode drivers — verifying the MiSizes grid matches the partition,
# the pixels, and enc==dec grids, in both disable_cdf modes.
include "src/main.cyr"
include "src/av1_tile.cyr"

fn test_qbucket() {
    assert_eq(av1_coeff_cdf_qbucket(0), 0, "q 0 -> 0");
    assert_eq(av1_coeff_cdf_qbucket(20), 0, "q 20 -> 0");
    assert_eq(av1_coeff_cdf_qbucket(21), 1, "q 21 -> 1");
    assert_eq(av1_coeff_cdf_qbucket(60), 1, "q 60 -> 1");
    assert_eq(av1_coeff_cdf_qbucket(61), 2, "q 61 -> 2");
    assert_eq(av1_coeff_cdf_qbucket(120), 2, "q 120 -> 2");
    assert_eq(av1_coeff_cdf_qbucket(121), 3, "q 121 -> 3");
    assert_eq(av1_coeff_cdf_qbucket(255), 3, "q 255 -> 3");
    return 0;
}
fn test_clear_context() {
    var oe = alloc(8);
    var frame = dr_frame_new(64, 64, 1, 0, 0, 8, 8, oe);
    var tile = av1_tile_new(frame, 16, 16, 40, 1, 0, 1);
    # dirty the above/left strips, then clear.
    store64(load64(tile + AV1TILE_ALVL) + 0, 7);
    store64(load64(tile + AV1TILE_ADC) + (5 * 8), 9);
    store64(load64(tile + AV1TILE_LLVL) + (3 * 8), 4);
    store64(load64(tile + AV1TILE_LDC) + 0, 2);
    av1_clear_above_context(tile, 1);
    av1_clear_left_context(tile, 1);
    assert_eq(load64(load64(tile + AV1TILE_ALVL) + 0), 0, "above lvl cleared");
    assert_eq(load64(load64(tile + AV1TILE_ADC) + (5 * 8)), 0, "above dc cleared");
    assert_eq(load64(load64(tile + AV1TILE_LLVL) + (3 * 8)), 0, "left lvl cleared");
    assert_eq(load64(load64(tile + AV1TILE_LDC) + 0), 0, "left dc cleared");
    # 0.8.2: the tile's seg_id_predicted strips are cleared by the SAME two calls (5.11.2: AboveSegPredContext
    # per tile, LeftSegPredContext per superblock row) — each clear touches only its own strip.
    av1_tile_grids_new(tile);
    var sc = av1_tile_segctx(tile);
    assert_eq(sc != 0, 1, "the tile has an Av1SegCtx (attached on first use)");
    av1_segpred_store(sc, 3, 6, 2, 2, 1);
    assert_eq(av1_segpred_ctx(sc, 3, 6), 2, "seg-pred strips dirtied");
    av1_clear_above_context(tile, 1);
    assert_eq(av1_segpred_ctx(sc, 3, 6), 1, "clear_above_context: AboveSegPredContext cleared, left kept");
    av1_clear_left_context(tile, 1);
    assert_eq(av1_segpred_ctx(sc, 3, 6), 0, "clear_left_context: LeftSegPredContext cleared");
    return 0;
}

# Full keyframe round-trip on a 2-superblock (128x64) mono frame. SB0 (cols
# 0..15) SPLIT into four 32x32; SB1 (cols 16..31) one 64x64; all skip DC. The
# pre-order plan feeds the encode lane; decode_tile drives the whole frame.
fn keyframe_rt(disable): i64 {
    var base_q = 40;
    var mi = av1_modeinfo_new();
    store64(mi + AV1MI_SKIP, 1);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    # pre-order partition plan: SB0 SPLIT + 4x NONE, SB1 NONE.
    var pp = alloc(6 * 8);
    store64(pp + 0, AV1_PARTITION_SPLIT);
    store64(pp + 8, AV1_PARTITION_NONE);   store64(pp + 16, AV1_PARTITION_NONE);
    store64(pp + 24, AV1_PARTITION_NONE);  store64(pp + 32, AV1_PARTITION_NONE);
    store64(pp + 40, AV1_PARTITION_NONE);
    # 5 blocks: four 32x32 (TX_32X32=3) then one 64x64 (TX_64X64=4).
    var pm = alloc(5 * 8);
    var pt = alloc(5 * 8);
    var k = 0;
    while (k < 4) { store64(pm + (k * 8), mi); store64(pt + (k * 8), 3); k = k + 1; }
    store64(pm + (4 * 8), mi);
    store64(pt + (4 * 8), 4);
    # ENCODE.
    var eoe = alloc(8);
    var eframe = dr_frame_new(128, 64, 1, 0, 0, 8, 8, eoe);
    var etile = av1_tile_new(eframe, 32, 16, base_q, 1, 0, 1);
    av1_tile_grids_new(etile);
    var olen = 0;
    var out = av1_encode_intra_tile(etile, pp, pm, pt, disable, &olen);
    assert_eq(olen > 0, 1, "encoded a keyframe tile");
    # DECODE.
    var doe = alloc(8);
    var dframe = dr_frame_new(128, 64, 1, 0, 0, 8, 8, doe);
    var dtile = av1_tile_new(dframe, 32, 16, base_q, 1, 0, 1);
    av1_tile_grids_new(dtile);
    assert_eq(av1_decode_intra_tile(dtile, out, olen, disable), DR_OK, "decode_tile ok");
    # grids: SB0 (cols 0..15) BLOCK_32X32=9, SB1 (cols 16..31) BLOCK_64X64=12.
    var bad = 0;
    var r = 0;
    while (r < 16) {
        var c = 0;
        while (c < 32) {
            var exp = 9;
            if (c >= 16) { exp = 12; }
            if (av1_grid_get(dtile, AV1TILE_MISIZES, r, c) != exp) { bad = 1; }
            if (av1_grid_get(dtile, AV1TILE_YMODES, r, c) != AV1_DC_PRED) { bad = 1; }
            if (av1_grid_get(dtile, AV1TILE_SKIPS, r, c) != 1) { bad = 1; }
            if (av1_grid_get(dtile, AV1TILE_MISIZES, r, c) != av1_grid_get(etile, AV1TILE_MISIZES, r, c)) { bad = 1; }
            c = c + 1;
        }
        r = r + 1;
    }
    assert_eq(bad, 0, "keyframe MiSizes match partition + enc==dec grids");
    # pixels: all 128 (flat DC prediction, skip -> no residual).
    var bad2 = 0;
    var y = 0;
    while (y < 64) {
        var x = 0;
        while (x < 128) { if (dr_frame_get(dframe, 0, x, y) != 128) { bad2 = 1; } x = x + 1; }
        y = y + 1;
    }
    assert_eq(bad2, 0, "keyframe pixels all 128");
    return 0;
}
fn test_keyframe_roundtrip() {
    keyframe_rt(1);        # read-only CDFs
    keyframe_rt(0);        # adaptive CDFs (frame-wide lockstep)
    return 0;
}
# The plan-driven encode lane at 128x128 SUPERBLOCKS (0.8.6): av1_encode_tile's sbSize branch — the 128x128 SB loop,
# the W128 partition CDF and its 8-symbol alphabet at the root, a whole 128x128 block — never ran before. A 256x128
# mono frame, two superblocks: SB0 one 128x128 block (TX_64X64); SB1 SPLIT into 64x64 NONE, 64x64 SPLIT into four
# 32x32, then two 64x64 NONE. All skip DC. lrp != 0 also attaches loop restoration (unit 64: four units per SB).
fn sb128_plan(pp, pm, pt, mi): i64 {
    store64(pp + 0, AV1_PARTITION_NONE);      # SB0: 128x128
    store64(pp + 8, AV1_PARTITION_SPLIT);     # SB1
    store64(pp + 16, AV1_PARTITION_NONE);     #   64x64 (0)
    store64(pp + 24, AV1_PARTITION_SPLIT);    #   64x64 (1) -> four 32x32
    store64(pp + 32, AV1_PARTITION_NONE);
    store64(pp + 40, AV1_PARTITION_NONE);
    store64(pp + 48, AV1_PARTITION_NONE);
    store64(pp + 56, AV1_PARTITION_NONE);
    store64(pp + 64, AV1_PARTITION_NONE);     #   64x64 (2)
    store64(pp + 72, AV1_PARTITION_NONE);     #   64x64 (3)
    # blocks in decode order: 128x128, 64x64, 32x32 x4, 64x64, 64x64
    var k = 0;
    while (k < 8) { store64(pm + (k * 8), mi); k = k + 1; }
    store64(pt + 0, 4);                       # TX_64X64 (Max_Tx_Size_Rect of BLOCK_128X128)
    store64(pt + 8, 4);
    k = 2;
    while (k < 6) { store64(pt + (k * 8), 3); k = k + 1; }   # TX_32X32
    store64(pt + 48, 4);
    store64(pt + 56, 4);
    return 0;
}
fn sb128_rt(disable, with_lr): i64 {
    var base_q = 40;
    var mi = av1_modeinfo_new();
    store64(mi + AV1MI_SKIP, 1);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    var pp = alloc(10 * 8);
    var pm = alloc(8 * 8);
    var pt = alloc(8 * 8);
    sb128_plan(pp, pm, pt, mi);
    var eoe = alloc(8);
    var eframe = dr_frame_new(256, 128, 1, 0, 0, 8, 8, eoe);
    var etile = av1_tile_new(eframe, 64, 32, base_q, 1, 0, 1);
    av1_tile_grids_new(etile);
    av1_tile_set_sb128(etile, 1);
    var elrp = 0;
    if (with_lr) {
        elrp = av1_lr_params_new(256, 128, 1, 0, 0, 1);
        av1_lr_params_set_plane(elrp, 0, AV1_RESTORE_WIENER, 64);
        var ur = 0;
        while (ur < 2) {
            var uc = 0;
            while (uc < 4) {
                av1_lr_type_set(elrp, 0, ur, uc, AV1_RESTORE_WIENER);
                av1_lr_wiener_set(elrp, 0, ur, uc, 0, 3, 0 - 7, 5 + (4 * ur) + uc);
                av1_lr_wiener_set(elrp, 0, ur, uc, 1, 0 - 2, 5, 20 - (4 * ur) - uc);
                uc = uc + 1;
            }
            ur = ur + 1;
        }
        av1_tile_set_lr_params(etile, elrp);
    }
    var olen = 0;
    var out = av1_encode_intra_tile(etile, pp, pm, pt, disable, &olen);
    assert(olen > 0, "sb128: the plan-driven encode lane writes a tile");
    var doe = alloc(8);
    var dframe = dr_frame_new(256, 128, 1, 0, 0, 8, 8, doe);
    var dtile = av1_tile_new(dframe, 64, 32, base_q, 1, 0, 1);
    av1_tile_grids_new(dtile);
    av1_tile_set_sb128(dtile, 1);
    var dlrp = 0;
    if (with_lr) {
        dlrp = av1_lr_params_new(256, 128, 1, 0, 0, 1);
        av1_lr_params_set_plane(dlrp, 0, AV1_RESTORE_WIENER, 64);
        av1_tile_set_lr_params(dtile, dlrp);
    }
    assert_eq(av1_decode_intra_tile(dtile, out, olen, disable), DR_OK, "sb128: decode_tile reads it");
    var bad = 0;
    var r = 0;
    while (r < 32) {
        var c = 0;
        while (c < 64) {
            var exp = 15;                                   # SB0: BLOCK_128X128
            if (c >= 32) {
                exp = 12;                                   # SB1: BLOCK_64X64
                if ((r < 16) && (c >= 48)) { exp = 9; }     # ... but its second 64x64 is four 32x32
            }
            if (av1_grid_get(dtile, AV1TILE_MISIZES, r, c) != exp) { bad = bad + 1; }
            if (av1_grid_get(dtile, AV1TILE_SKIPS, r, c) != 1) { bad = bad + 1; }
            var esz = av1_grid_get(etile, AV1TILE_MISIZES, r, c);
            if (av1_grid_get(dtile, AV1TILE_MISIZES, r, c) != esz) { bad = bad + 1; }
            c = c + 1;
        }
        r = r + 1;
    }
    assert_eq(bad, 0, "sb128: the decoder's MiSizes are the plan's (128x128, 64x64, 32x32), enc == dec grids");
    var bad2 = 0;
    var y = 0;
    while (y < 128) {
        var x = 0;
        while (x < 256) { if (dr_frame_get(dframe, 0, x, y) != 128) { bad2 = 1; } x = x + 1; }
        y = y + 1;
    }
    assert_eq(bad2, 0, "sb128: pixels all 128");
    if (with_lr) {
        var lbad = 0;
        var ur2 = 0;
        while (ur2 < 2) {
            var uc2 = 0;
            while (uc2 < 4) {
                if (av1_lr_wiener_get_one(dlrp, 0, ur2, uc2, 0, 2) != (5 + (4 * ur2) + uc2)) { lbad = lbad + 1; }
                if (av1_lr_wiener_get_one(dlrp, 0, ur2, uc2, 1, 2) != (20 - (4 * ur2) - uc2)) { lbad = lbad + 1; }
                uc2 = uc2 + 1;
            }
            ur2 = ur2 + 1;
        }
        assert_eq(lbad, 0, "sb128: all 8 restoration units (4 per superblock) read back their coefficients");
    }
    return 0;
}
fn test_sb128_roundtrip() {
    sb128_rt(1, 0);
    sb128_rt(0, 0);
    sb128_rt(0, 1);
    return 0;
}
# read_lr wiring: with Av1LrParams attached, decode_tile reads a WIENER unit per SB
# (interleaved before decode_partition). 128x64, unit_size 64 -> 2 units; SB0
# reads unit(0,0), SB1 reads unit(0,1). Proves read_lr fires through decode_tile.
fn test_lr_tile_wiring() {
    var base_q = 40;
    var mi = av1_modeinfo_new();
    store64(mi + AV1MI_SKIP, 1);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    var pp = alloc(6 * 8);
    store64(pp + 0, AV1_PARTITION_SPLIT);
    store64(pp + 8, AV1_PARTITION_NONE);   store64(pp + 16, AV1_PARTITION_NONE);
    store64(pp + 24, AV1_PARTITION_NONE);  store64(pp + 32, AV1_PARTITION_NONE);
    store64(pp + 40, AV1_PARTITION_NONE);
    var pm = alloc(5 * 8);
    var pt = alloc(5 * 8);
    var k = 0;
    while (k < 4) { store64(pm + (k * 8), mi); store64(pt + (k * 8), 3); k = k + 1; }
    store64(pm + (4 * 8), mi);
    store64(pt + (4 * 8), 4);
    # ENCODE tile + LR params (2 WIENER units with distinct coeffs).
    var eoe = alloc(8);
    var eframe = dr_frame_new(128, 64, 1, 0, 0, 8, 8, eoe);
    var etile = av1_tile_new(eframe, 32, 16, base_q, 1, 0, 1);
    av1_tile_grids_new(etile);
    var elrp = av1_lr_params_new(128, 64, 1, 0, 0, 1);
    av1_lr_params_set_plane(elrp, 0, AV1_RESTORE_WIENER, 64);
    av1_lr_type_set(elrp, 0, 0, 0, AV1_RESTORE_WIENER);
    av1_lr_wiener_set(elrp, 0, 0, 0, 0, 3, 0 - 7, 15);
    av1_lr_wiener_set(elrp, 0, 0, 0, 1, 3, 0 - 7, 15);
    av1_lr_type_set(elrp, 0, 0, 1, AV1_RESTORE_WIENER);
    av1_lr_wiener_set(elrp, 0, 0, 1, 0, 0 - 2, 5, 20);
    av1_lr_wiener_set(elrp, 0, 0, 1, 1, 0 - 2, 5, 20);
    av1_tile_set_lr_params(etile, elrp);
    var olen = 0;
    var out = av1_encode_intra_tile(etile, pp, pm, pt, 1, &olen);
    assert_eq(olen > 0, 1, "encoded keyframe tile with LR bits");
    # DECODE tile + LR params (empty, populated through decode_tile).
    var doe = alloc(8);
    var dframe = dr_frame_new(128, 64, 1, 0, 0, 8, 8, doe);
    var dtile = av1_tile_new(dframe, 32, 16, base_q, 1, 0, 1);
    av1_tile_grids_new(dtile);
    var dlrp = av1_lr_params_new(128, 64, 1, 0, 0, 1);
    av1_lr_params_set_plane(dlrp, 0, AV1_RESTORE_WIENER, 64);
    av1_tile_set_lr_params(dtile, dlrp);
    assert_eq(av1_decode_intra_tile(dtile, out, olen, 1), DR_OK, "decode_tile ok (LR active)");
    assert_eq(av1_lr_wiener_get_one(dlrp, 0, 0, 0, 0, 2), 15, "SB0 -> read unit(0,0) coeff 15");
    assert_eq(av1_lr_wiener_get_one(dlrp, 0, 0, 1, 0, 2), 20, "SB1 -> read unit(0,1) coeff 20");
    assert_eq(av1_grid_get(dtile, AV1TILE_MISIZES, 0, 0), 9, "partition still round-trips (SB0 32x32)");
    assert_eq(av1_grid_get(dtile, AV1TILE_MISIZES, 0, 16), 12, "partition still round-trips (SB1 64x64)");
    return 0;
}
# Frame-header-driven activation end-to-end: the decode side builds its LR params
# from a parsed frame header (av1_lr_params_from_fh) and attaches them via
# av1_activate_intra_filters — the production path — instead of hand-wiring the
# params. Proves the header -> params -> decode_tile chain reads the same WIENER
# coeffs the encoder wrote (the activation-gap closure for a real bitstream).
fn test_lr_activation_from_fh() {
    var base_q = 40;
    var mi = av1_modeinfo_new();
    store64(mi + AV1MI_SKIP, 1);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    var pp = alloc(6 * 8);
    store64(pp + 0, AV1_PARTITION_SPLIT);
    store64(pp + 8, AV1_PARTITION_NONE);   store64(pp + 16, AV1_PARTITION_NONE);
    store64(pp + 24, AV1_PARTITION_NONE);  store64(pp + 32, AV1_PARTITION_NONE);
    store64(pp + 40, AV1_PARTITION_NONE);
    var pm = alloc(5 * 8);
    var pt = alloc(5 * 8);
    var k = 0;
    while (k < 4) { store64(pm + (k * 8), mi); store64(pt + (k * 8), 3); k = k + 1; }
    store64(pm + (4 * 8), mi);
    store64(pt + (4 * 8), 4);
    # ENCODE tile: manual LR params (2 WIENER units with distinct coeffs).
    var eoe = alloc(8);
    var eframe = dr_frame_new(128, 64, 1, 0, 0, 8, 8, eoe);
    var etile = av1_tile_new(eframe, 32, 16, base_q, 1, 0, 1);
    av1_tile_grids_new(etile);
    var elrp = av1_lr_params_new(128, 64, 1, 0, 0, 1);
    av1_lr_params_set_plane(elrp, 0, AV1_RESTORE_WIENER, 64);
    av1_lr_type_set(elrp, 0, 0, 0, AV1_RESTORE_WIENER);
    av1_lr_wiener_set(elrp, 0, 0, 0, 0, 3, 0 - 7, 15);
    av1_lr_wiener_set(elrp, 0, 0, 0, 1, 3, 0 - 7, 15);
    av1_lr_type_set(elrp, 0, 0, 1, AV1_RESTORE_WIENER);
    av1_lr_wiener_set(elrp, 0, 0, 1, 0, 0 - 2, 5, 20);
    av1_lr_wiener_set(elrp, 0, 0, 1, 1, 0 - 2, 5, 20);
    av1_tile_set_lr_params(etile, elrp);
    var olen = 0;
    var out = av1_encode_intra_tile(etile, pp, pm, pt, 1, &olen);
    assert_eq(olen > 0, 1, "encoded keyframe tile with LR bits");
    # DECODE tile: build a frame header (UsesLr, WIENER luma, unit 64) + sequence,
    # derive the LR params FROM the header, and activate — the production wiring.
    var fh = alloc(AV1FH_SIZE);   # the WHOLE header, zeroed: readers go past offset 1200 (features @1632)
    memset(fh, 0, AV1FH_SIZE);
    store64(fh + AV1FH_USES_LR, 1);
    store64(fh + AV1FH_FRAME_RESTORATION_TYPE + 0, AV1_RESTORE_WIENER);
    store64(fh + AV1FH_LR_SIZE + 0, 64);
    # read_lr frame flags must match the encoder's defaults (alloc is not zeroed):
    # a garbage allow_intrabc would make read_lr skip the units and desync.
    store64(fh + AV1FH_ALLOW_INTRABC, 0);
    store64(fh + AV1FH_USE_SUPERRES, 0);
    store64(fh + AV1FH_SUPERRES_DENOM, 8);
    var seq = alloc(AV1_SEQ_SIZE);   # the whole record, zeroed
    memset(seq, 0, AV1_SEQ_SIZE);
    store64(seq + AV1_SEQ_ENABLE_CDEF, 0);   # CDEF off: focus on LR activation
    var doe = alloc(8);
    var dframe = dr_frame_new(128, 64, 1, 0, 0, 8, 8, doe);
    var dtile = av1_tile_new(dframe, 32, 16, base_q, 1, 0, 1);
    av1_tile_grids_new(dtile);
    var foe = alloc(8);
    var dlrp = av1_lr_params_from_fh(fh, seq, 128, 64, 1, foe);
    assert_eq(load64(foe), DR_OK, "lr_params_from_fh ok");
    assert_eq(dlrp != 0, 1, "header UsesLr -> params built");
    assert_eq(av1_activate_intra_filters(dtile, seq, fh, dlrp), DR_OK, "activate ok");
    assert_eq(av1_decode_intra_tile(dtile, out, olen, 1), DR_OK, "decode_tile ok (LR active from header)");
    assert_eq(av1_lr_wiener_get_one(dlrp, 0, 0, 0, 0, 2), 15, "SB0 -> read unit(0,0) coeff 15");
    assert_eq(av1_lr_wiener_get_one(dlrp, 0, 0, 1, 0, 2), 20, "SB1 -> read unit(0,1) coeff 20");
    return 0;
}

# A refused block write ends the tile (0.8.5). The same 2-superblock keyframe is encoded as keyframe_rt does, then
# decoded into a 16x16 border-0 frame — far smaller than the tile's 128x64 MI grid, a broken caller invariant. The
# first 32x32 block's prediction is refused by dr_frame_block_inside; the error travels av1_transform_block ->
# av1_residual -> decode_block -> the symbol decoder's sticky error, and the tile reports DR_ERR_BOUNDS. Before
# 0.8.5 av1_residual dropped transform_block's result and the tile reported DR_OK with the writes silently skipped.
fn test_refused_write_ends_tile() {
    var mi = av1_modeinfo_new();
    store64(mi + AV1MI_SKIP, 1);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    var pp = alloc(6 * 8);
    store64(pp + 0, AV1_PARTITION_SPLIT);
    store64(pp + 8, AV1_PARTITION_NONE);   store64(pp + 16, AV1_PARTITION_NONE);
    store64(pp + 24, AV1_PARTITION_NONE);  store64(pp + 32, AV1_PARTITION_NONE);
    store64(pp + 40, AV1_PARTITION_NONE);
    var pm = alloc(5 * 8);
    var pt = alloc(5 * 8);
    var k = 0;
    while (k < 4) { store64(pm + (k * 8), mi); store64(pt + (k * 8), 3); k = k + 1; }
    store64(pm + (4 * 8), mi);
    store64(pt + (4 * 8), 4);
    var eoe = alloc(8);
    var etile = av1_tile_new(dr_frame_new(128, 64, 1, 0, 0, 8, 8, eoe), 32, 16, 40, 1, 0, 1);
    av1_tile_grids_new(etile);
    var olen = 0;
    var out = av1_encode_intra_tile(etile, pp, pm, pt, 1, &olen);
    assert_eq(olen > 0, 1, "refused write: the keyframe tile encodes");
    var doe = alloc(8);
    var dtile = av1_tile_new(dr_frame_new(16, 16, 1, 0, 0, 8, 0, doe), 32, 16, 40, 1, 0, 1);
    av1_tile_grids_new(dtile);
    assert_eq(av1_decode_intra_tile(dtile, out, olen, 1), DR_ERR_BOUNDS, "...into a 16x16 frame: DR_ERR_BOUNDS");
    return 0;
}

# ---- OOM fault injection (0.8.5): keyframe_rt's 2-superblock tile, encoded then decoded inside the swept
# operation — the frames, tiles, grids, CDF contexts, symbol coders, the encode walk's cursors and the per-block
# allocations of both lanes. A valid plan cannot fail to encode, so a 0 encode is its allocation failing. ----
var Tile_Oom_Pp = 0;
var Tile_Oom_Pm = 0;
var Tile_Oom_Pt = 0;
fn tile_oom_op(disable): i64 {
    var mi = av1_modeinfo_new();
    if (mi == 0) { return DR_ERR_OOM; }
    store64(mi + AV1MI_SKIP, 1);
    store64(mi + AV1MI_YMODE, AV1_DC_PRED);
    store64(mi + AV1MI_UVMODE, AV1_DC_PRED);
    var k = 0;
    while (k < 5) { store64(Tile_Oom_Pm + (k * 8), mi); k = k + 1; }
    var e = 0;
    var ef = dr_frame_new(128, 64, 1, 0, 0, 8, 8, &e);
    if (ef == 0) { return e; }
    var et = av1_tile_new(ef, 32, 16, 40, 1, 0, 1);
    if (et == 0) { return DR_ERR_OOM; }
    var rc = av1_tile_grids_new(et);
    if (rc != DR_OK) { return rc; }
    var olen = 0;
    var out = av1_encode_intra_tile(et, Tile_Oom_Pp, Tile_Oom_Pm, Tile_Oom_Pt, disable, &olen);
    if (out == 0) { return DR_ERR_OOM; }
    var df = dr_frame_new(128, 64, 1, 0, 0, 8, 8, &e);
    if (df == 0) { return e; }
    var dt = av1_tile_new(df, 32, 16, 40, 1, 0, 1);
    if (dt == 0) { return DR_ERR_OOM; }
    rc = av1_tile_grids_new(dt);
    if (rc != DR_OK) { return rc; }
    return av1_decode_intra_tile(dt, out, olen, disable);
}
fn test_tile_oom() {
    Tile_Oom_Pp = alloc(6 * 8);   # the plan: raw allocations, never failed
    store64(Tile_Oom_Pp + 0, AV1_PARTITION_SPLIT);
    var k = 1;
    while (k < 6) { store64(Tile_Oom_Pp + (k * 8), AV1_PARTITION_NONE); k = k + 1; }
    Tile_Oom_Pm = alloc(5 * 8);
    Tile_Oom_Pt = alloc(5 * 8);
    k = 0;
    while (k < 4) { store64(Tile_Oom_Pt + (k * 8), 3); k = k + 1; }
    store64(Tile_Oom_Pt + (4 * 8), 4);
    var n = 0;
    assert_eq(dr_alloc_sweep(&tile_oom_op, 1, &n), 0, "intra tile encode + decode (fixed CDFs): every failure -> OOM");
    assert_gt(n, 20, "...over every allocation of both lanes");
    assert_eq(dr_alloc_sweep(&tile_oom_op, 0, &n), 0, "...and with adapting CDFs");
    return 0;
}

fn main() {
    alloc_init();
    test_group("a refused block write ends the tile (0.8.5)");
    test_refused_write_ends_tile();
    test_group("qbucket / clear context");
    test_qbucket();
    test_clear_context();
    test_group("keyframe decode_tile round-trip");
    test_keyframe_roundtrip();
    test_sb128_roundtrip();
    test_group("read_lr wiring in decode_tile");
    test_lr_tile_wiring();
    test_group("frame-header LR activation end-to-end");
    test_lr_activation_from_fh();
    test_group("OOM fault injection");
    test_tile_oom();
    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
